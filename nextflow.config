// ============================================================================
// nextflow.config — Unified Multiomics Pipeline (refactor5)
//
// Base config with all parameter defaults, container definitions,
// process-level container assignments, and profile definitions.
//
// Usage:
//   nextflow run main.nf -profile cluster,singularity \
//       -c configs/datasets/pbmc_10x_10k.config -resume
//
// Resource tiers are loaded automatically based on params.resource_tier:
//   'small'  — PBMC-scale (10k cells, single sample)
//   'medium' — mid-scale
//   'large'  — BD-scale (100+ samples, 100k+ cells)
//   'auto'   — alias for 'small' (default; safe for any dataset)
// MIS-11/MIS-25 (2026-05-04): typo guard added in main.nf — invalid values
// like 'Medium' (capital M) error at preflight instead of silently falling
// through to small.
// ============================================================================

params {
    // =============================
    // RESOURCE TIER
    // =============================
    // Controls which resource config is loaded (small / medium / large / auto).
    // 'auto' is an alias for 'small' (safe default). Override in dataset
    // config or on CLI: --resource_tier large
    resource_tier = 'auto'

    // =============================
    // SPECIES & DIRECTORIES
    // =============================
    // MIS-01 (2026-05-04): no default — must be set explicitly per-dataset.
    // Allowed: 'human' | 'mouse'. Validated in main.nf pre-flight.
    species = null

    // Output directories
    outdir  = 'results'
    tempdir = '/tmp'

    // Manifest / metadata
    metadata_file = null

    // Conversion / intermediate file toggles
    save_converted    = false
    save_intermediate = false

    // =============================
    // ON-RAMP: PRE-COMPUTED INPUTS
    // =============================
    // Set any of these to skip upstream steps and resume from a checkpoint.
    // All null by default — pipeline runs from raw data.
    onramp {
        // -- TOP-LEVEL WIRED (MIS-04 D2.1 back-port complete 2026-05-04) --
        rna_integrated_h5ad         = null
        atac_peak_matrix_h5ad       = null
        mudata_h5mu                 = null

        // -- ATAC SIDE KEYS (paired with atac_peak_matrix_h5ad) --
        atac_individual_samples_dir = null   // dir of per-sample h5ads (required by scPRINTer)
        atac_anndataset             = null   // snapatac2 binding object (required by ENHANCER_FOOTPRINTING_RECIPES)

        // -- RNA SIDE KEYS (paired with rna_integrated_h5ad) --
        rna_per_sample_h5ads_dir    = null   // per-sample QC'd RNA h5ads (required by MULTIOME_INTEGRATION)
        rna_cellchat_csv            = null   // CellChat CSV for ENHANCER_FOOTPRINTING_RECIPES Phase 3

        // -- INSIDE REGULATORY_ANALYSIS (per-process) --
        printer_h5ad                = null   // skip SCPRINTER_BUILD_PRINTER
        // Cicero global triple — all-or-none (validator enforces)
        cicero_connections          = null
        cicero_ccan                 = null   // CCAN_assignments.tsv.gz
        cicero_cds                  = null   // input_cds_ordered.rds
        // ChromVAR pair — all-or-none (validator enforces)
        chromvar_deviations         = null
        chromvar_raw                = null   // chromvar_raw.h5ad

        // -- FORWARD-DECLARED, NOT WIRED ANYWHERE --
        // MIS-04 (2026-05-04): validator rejects if set; placeholders for future.
        cistopic_obj_pkl            = null
        seurat_rds                  = null
        da_peaks_dir                = null   // dir of DA_peaks_*.csv
        // Stratified-mode onramp (CTRL/TRT split) — 4-key all-or-none bundle, deferred:
        cicero_connections_ctrl     = null
        cicero_connections_trt      = null
        cicero_ccan_ctrl            = null
        cicero_ccan_trt             = null
    }

    // =============================
    // GENERIC BATCH DIRECTORY MAPS
    // =============================
    // Populated in dataset configs for multi-batch experiments.
    // Keys are batch names, values are directory paths.
    batch_dirs              = [:]
    demux_metadata          = [:]
    demux_souporcell_dirs   = [:]
    atac_fragment_dirs_bc   = [:]
    atac_fragment_dirs_coord = [:]

    // =============================
    // RESOURCE PATHS
    // =============================
    ref_dir = "${projectDir}/references"

    gtf_human_full = null
    gtf_mouse_full = null
    blacklist_bed  = null

    // Reference atlas — null triggers Path B (CellTypist direct, no scANVI)
    // Set to a directory to trigger Path A (scANVI + CellTypist)
    ref_dir_human_integrated = null
    ref_dir_mouse_integrated = null

    // =============================
    // CONTAINER DEFINITIONS
    // =============================
    containers = [
        scgpu:       "${projectDir}/singularity_cache/scgpu_extended.sif",
        snapatac:    "${projectDir}/singularity_cache/snapatac_extended.sif",
        scenicplus:  "${projectDir}/singularity_cache/scenicplus.sif",
        r_cicero:    "${projectDir}/singularity_cache/cicero.sif",
        r_seurat:    "${projectDir}/singularity_cache/seurat_extended.sif",
        r_cellchat:  "${projectDir}/singularity_cache/seurat_extended.sif",
    ]

    // =============================
    // CELLBENDER PARAMETERS
    // =============================
    cellbender {
        total_droplets = 20000
        expected_cells = 5000
        fpr = 0.01
        epochs = 150
        low_count_threshold = 0
    }

    // =============================
    // POST-HOC QC REPORT (Viz overhaul §4)
    // =============================
    qc {
        post_hoc_report = false   // opt-in — re-renders FORGE-style TSSE
                                  // marginal scatter from atac_complete.h5ads

        // Universal per-CT resolution floor for fan-outs downstream of
        // annotation. Skip a cell type if n_cells < max(min_cells, min_pct*total).
        // 2026-05-05: AD ARH-PVi Six6 Dopa-Gaba (7 cells) OOM'd
        // ENHANCER_FOOTPRINTING_PER_CT at 192 GB on TF #2 — scprinter's worker
        // pool peaks far above the on-disk h5ad footprint regardless of CT
        // cell count (n_groups, modes, regions are CT-independent).
        cell_type_resolution {
            min_cells = 50
            min_pct   = 0.01
        }
    }

    // =============================
    // VIZ_ONLY entry workflow (D2; absorbed from SDas_nf)
    // =============================
    // Re-renders post-hoc QC + Cicero target plots from already-persisted
    // artifacts under results/. Invoke via: nextflow run main.nf -entry VIZ_ONLY
    viz_only {
        peak_matrix_h5ad   = null    // → POST_QC_REPORT (path)
        cicero_connections = null    // ┐ all three required to render
        cicero_ccan        = null    // ├ CICERO_TARGET_PLOTS
        cicero_cds         = null    // ┘
        target_genes       = null    // CSV string or List; falls back to params.cicero.target_genes
    }

    // =============================
    // RNA QC PARAMETERS
    // =============================
    min_genes = 200
    min_cells = 3
    mt_threshold = 20

    // =============================
    // RNA DIFFERENTIAL EXPRESSION
    // =============================
    differential_rna {
        run = false
        condition_key = 'condition_group'
        cell_type_key = 'cell_type'
        group_mapping = null
        comparisons = []
        run_go_enrichment = false
        pval_cutoff = 0.05
        log2fc_cutoff = 0.25
    }

    // =============================
    // CELLTYPIST
    // =============================
    celltypist {
        enabled = true
        model   = 'Immune_All_Low.pkl'
    }

    // =============================
    // scATAnno (reference-based ATAC annotation)
    // =============================
    scatanno {
        reference_atlas       = null
        atlas_name            = 'general'
        distance_threshold    = 95
        uncertainty_threshold = 0.5
        n_dims                = 30
        knn_neighbors         = 30
    }

    // =============================
    // INTEGRATION PARAMETERS
    // =============================
    n_epochs_scvi = 50
    scanvi_epochs = 50
    n_top_genes = 4000

    // Device for every scvi-tools training step (TRAIN_SCVI, TRAIN_SCANVI,
    // MULTIVI_INTEGRATE). Passed through to .train(accelerator=...).
    //   'auto' (default) — use a GPU when one is visible, else fall back to CPU
    //   'cpu'            — force CPU; required for CPU-only runs, and makes the
    //                      device choice explicit instead of inferred
    //   'gpu'            — require a GPU (fails if none is visible)
    // Verified 2026-08-06: scVI, scANVI and MultiVI all train correctly on CPU
    // (scvi-tools 1.4.2) — see dev_notes/phase3/.
    scvi_accelerator = 'auto'
    mudata  { batch_size = 10 }

    // =============================
    // MODULE TOGGLES
    // =============================
    rna {
        run = true
        // RNA cell-type annotation method:
        //   'celltypist' → RUN_CELLTYPIST (requires params.celltypist.model)
        //   'markers'    → RUN_MARKER_ANNOTATION (requires rna.marker_file)
        annotation_method   = 'celltypist'
        marker_file         = null
        marker_min_score    = 0.0    // score_genes floor; below → 'unknown'
        marker_score_margin = 0.1    // min top-vs-second gap; below → collapse or 'unknown'
    }

    // =============================
    // ATAC PARAMETERS
    // =============================
    atac {
        run = true
        run_initial_qc = true
        min_fragments = 1000
        initial_min_counts = 1000
        initial_min_tsse = 5
        auto_annotate = true

        // ATAC QC & clustering params
        min_counts = null
        min_tsse = null
        max_counts = null
        initial_max_counts = 100000
        n_features = 50000
        batch_correction = 'none'
        batch_key = null
        clustering_resolutions = [0.5, 1.0, 2.0]
        peak_fdr = 0.05
        tempdir = null
        cisbp_human = "/dfs7/swaruplab/lesolano/ref/snapatac2/cisBP_2.00_human.meme"
        cisbp_mouse = "/dfs7/swaruplab/lesolano/ref/snapatac2/cisBP_2.00_mouse.meme"

        // Annotation resolution used by MERGE_ANNOTATIONS
        annotation_resolution = 'leiden_0_5'

        // BD demux fragment directories (per batch) — null by default
        demux_bc_dir_june = null
        demux_bc_dir_july = null
        demux_bc_dir_nov  = null
        demux_coord_dir_june = null
        demux_coord_dir_july = null
        demux_coord_dir_nov  = null

        // ATAC manifest
        sample_metadata = null

        // Cell type annotation mode — only two paths exist:
        //   annotation_method = 'scatanno' → scATAnno reference-based peak annotation
        //                                    (default; REQUIRES scatanno.reference_atlas)
        //   marker_file = path             → marker-based super-user mode (overrides above)
        // NOTE: ATAC CellTypist-on-gene-activity was REMOVED. Setting
        // annotation_method = 'celltypist' here aborts the run with an explicit
        // error. params.celltypist still governs RNA annotation.
        annotation_method = 'scatanno'
        tissue_type = 'pbmc'
        marker_file = null

        // 2026-04-29: granularity knob for stratified Cicero / per-ct
        // analyses. 'broad' → ~10-class Allen subclass (default); 'fine' →
        // ~30+ subclasses. Used by C-tier annotation_key resolution and
        // by D3 stratified-Cicero default.
        run_mode = 'broad'

        // Override obs column used as cell-type label in downstream
        // analyses. null → fall back to the standard chain
        // (cell_type → cell_type_prediction → celltypist_prediction → pred_y).
        // Set explicitly to 'cell_type_broad' to use the C4 broad-class
        // coarsening output from MERGE_ANNOTATIONS.
        cell_type_col = null
    }

    // =============================
    // CICERO
    // =============================
    cicero {
        run = true
        sample_num = 100
        num_dim = 50
        connections_cutoff = 0.25
        ccan_min_coaccess = 0.1
        use_partition = false
        outdir = "${params.outdir}/cicero"
        use_chromvar_targets = true
        target_genes = []
        gtf_full = null
        gtf_plot = null

        // CICERO_TARGET_PLOTS per-window plotting settings (parallel
        // lists, equal length). 3-tier default mirrors SDas:
        //   strict      = ±100kb @ 0.10 coaccess
        //   permissive  = ±250kb @ 0.05
        //   exploratory = ±500kb @ 0.025
        plot_windows    = "100000,250000,500000"
        plot_thresholds = "0.10,0.05,0.025"
        plot_labels     = "strict,permissive,exploratory"

        // Shi et al. stratified Cicero: runs Cicero SEPARATELY per condition,
        // then COMPARE_COACCESSIBILITY contrasts the two maps. Absorbed from SDas.
        // Runs IN ADDITION TO the default global Cicero (both are useful).
        //
        // D3: the stratified block auto-activates whenever
        // params.differential.run=true AND a condition_key is set (the disease
        // axis is intrinsically tied to differential mode). The `stratified`
        // flag below remains a manual override for non-differential workflows
        // that still want per-condition Cicero.
        stratified           = false       // manual override; auto-on under differential.run
        condition_key        = 'condition_group'
        control_condition    = null        // e.g., 'WT'
        treatment_condition  = null        // e.g., 'TG'
    }

    // =============================
    // PER-CT × CONDITION CICERO
    // =============================
    cicero_per_ct {
        enabled               = false
        cell_type_col         = 'cell_type_broad'
        condition_col         = 'condition'
        min_cells             = 50           // global CT abundance floor (absolute)
        min_pct               = 0.01         // global CT abundance floor (fraction of total)
        min_cells_per_stratum = 250          // per-(CT, condition) floor; exit 77 → skip
        annotation_csv        = null         // onramp override; skips BUILD_CT_ANNOTATION
    }

    // =============================
    // DIFFERENTIAL TF ACCESSIBILITY (Shi et al.)
    // =============================
    // Per-celltype TF-motif testing on the ChromVAR deviation matrix.
    // mode='descriptive'  — cell_type vs rest (single-condition friendly)
    // mode='differential' — treatment vs control within a cell type (needs 2+ cond)
    // See main.nf REGULATORY_ANALYSIS for the fan-out logic.
    differential_tf {
        run            = false                 // opt-in; flip true + populate cell_types
        mode           = 'descriptive'          // 'descriptive' | 'differential'
        condition_key  = 'condition_group'
        cell_types     = []                     // required when run=true
        // differential-mode inputs (ignored in descriptive):
        comparisons    = []                     // e.g. [['TG','WT']]
        // descriptive-mode optional subset filter:
        conditions     = []                     // e.g. ['Control']; [] = no filter
        min_cells      = 50
        fdr_cutoff     = 0.05
    }

    // =============================
    // CELLCHAT
    // Tier 1 (always-on): Global L-R inference on ALL cells
    // Tier 2 (optional):  Per-condition CellChat + comparative analysis
    //   Enable Tier 2 by setting conditions = ['Control', 'Treatment']
    // =============================
    cellchat {
        run                = true
        cell_type_key      = 'cell_type'
        condition_key      = 'condition_group'
        conditions         = []
        group_mapping      = null

        // ATAC-side CellChat (B1 modules/atac/cellchat.nf) — used in
        // ATAC-only run modes. RNA-side CellChat keys above remain
        // canonical for multiome runs.
        control            = null      // defaults to differential.control_condition
        treatment          = null      // defaults to differential.treatment_condition
        max_workers        = 10
        future_maxsize_gb  = 150
    }

    // =============================
    // hdWGCNA
    // Tier 1 (always-on): Per-cell-type network construction
    // Tier 2 (optional):  DME + module-trait correlation
    // =============================
    hdwgcna {
        run                  = true
        cell_type_key        = 'cell_type'
        min_cells            = 100
        metadata             = null
        condition_key        = 'none'
        control_condition    = null
        treatment_condition  = null
        traits               = []
    }

    // =============================
    // MULTIOME INTEGRATION
    // =============================
    run_multiome_integration = true
    mofa {
        run = true
        mode = 'high_memory'
        n_factors = 15
        convergence_mode = 'medium'
        bootstrap { n_iterations = 10; sample_fraction = 0.5 }
    }
    multivi {
        run              = true
        n_epochs         = 200
        batch_key        = 'sample_id'
        modality_weights = 'equal'
        modality_penalty = 'Jeffreys'
        n_latent         = 20
        cell_type_key    = 'cell_type'
        run_imputation   = false
        run_differential = false

        // MultiVI masking-sweep benchmark. main.nf reads
        // params.multivi.masking_sweep.run unguarded, so this block must exist
        // here or any run reaching MULTIVI aborts with
        // "Cannot get property 'run' on null object". It was previously declared
        // only in some dataset configs, which left the others broken.
        // Off by default: the sweep fans out fractions × seeds independent fits.
        masking_sweep {
            run       = false
            fractions = '0.25,0.50,0.75'
            seeds     = '42,123,456'
        }

        // Same story as masking_sweep: main.nf reads these unguarded, so the
        // blocks must exist here for the base config to stand on its own.
        driver_factors {
            run            = false
            method         = 'jacobian'
            compare_mofa   = true
            n_top_features = 50
        }

        // gap_fill imputes cells present in one modality only. The two h5ad paths
        // are null here because they point at a PRIOR run's outputs — set them in
        // your dataset config when enabling this.
        gap_fill {
            run                 = false
            n_posterior_samples = 25
            min_confidence      = 0.3
            rna_h5ad            = null
            atac_h5ad           = null
        }
    }

    // =============================
    // GRN MODULES
    // =============================
    pycistopic {
        run = true
        atac_only       = false // true → PYCISTOPIC_ATAC_PREPARE (build metadata from ATAC h5ad)
                                // false → PYCISTOPIC_PHASE1 (build metadata from RNA h5ad, default for multiome)
        species = null       // Auto-derived from params.species at runtime; override only if needed
        blacklist_bed = null
        gtf = null
        condition_col   = null  // defaults to 'condition' at runtime
        min_cells       = null  // defaults to 100 at runtime
        topics          = null  // defaults to '10,20,30' — the LDA sweep (one job per count)
        selected_topics = null  // null → pycisTopic's evaluate_models() picks the best model
                                // from the sweep. Set an integer to force a specific count.
    }
    scenicplus {
        run = true
        ctx_rankings = null
        ctx_scores   = null
        motif_annotations = null
        // A Nextflow 'val' input cannot be null, so the disabled state is the
        // STRING "none", not null. Set to a Python lambda literal to remap
        // barcodes between the RNA and ATAC naming conventions, e.g.
        //   "lambda x: x.split(':')[1] + '-' + x.split(':')[0]"
        bc_transform_func = "none"
        gtf = null
        fai = null
    }
    dorc { run = false }

    // =============================
    // ENHANCER FOOTPRINTING RECIPES
    // =============================
    enhancer_footprinting {
        run = true
        enhancer_mode = 'ccan'          // 'ccan' or 'pairwise_95'
        percentile_threshold = 95       // for pairwise_95 mode

        // Phase 3: ATAC-only TF-gene regulatory network (Shi et al. TF_Net).
        // Absorbed from SDas_nf — continuous scPrinter binding × Cicero co-access.
        build_network            = false    // opt-in; requires chromvar + discovery mode
        binding_threshold        = 'otsu'   // 'otsu' | 'percentile_75' | float
        network_plot_top_n       = 5        // top-N TFs per cell type in plots
        network_plot_max_targets = 15       // max target genes per TF in plots
        network_plot_min_shared  = 5        // min shared targets for co-reg edge

        // 2026-04-29: per-cell-type architecture toggle (B2). true →
        // ENHANCER_FOOTPRINTING_PER_CT (one task per ct loads printer/peak
        // matrix once; cuts task count from ~657 to ~10/33). false →
        // legacy sharded ENHANCER_FOOTPRINTING (one task per (ct, TF)).
        // 2026-05-04: default flipped to true based on SDas_nf production
        // audit (SLURM 51567486) — measured MaxRSS 64–72 GB across 25
        // per-ct tasks, 3.5× under the legacy sharded path's 256 GB ceiling
        // and orders of magnitude fewer SLURM submissions.
        use_per_ct           = true

        // 2026-05-26: CT-stratified enhancer MSFP compute is expensive and
        // optional. false → skip ENHANCER_FOOTPRINTING_PER_CT / _FOOTPRINTING
        // and all downstream consumers (BUILD_TF_GENE_NETWORK, AGGREGATE_FP_STATS,
        // CROSS_MODAL_VALIDATION, SIGNAL_CHAIN_CORRELATION, COMPOSITE_ENHANCER_VIZ,
        // PROMOTER_MSFP_PER_CT, RENDER_PROMOTER_MSFP_OVERLAY).
        // MOTIF_SCAN_ENHANCERS, EXPORT_ATAC_BIGWIGS, and all Cicero/cis-rewiring
        // steps continue to run regardless; RENDER_GENOME_BROWSER and
        // RENDER_CICERO_LOLLIPOP are driven by those outputs, not by MSFP.
        msfp_enabled         = false   // golden default; instance configs flip true

        // Disease-stratified co-accessibility (Shi et al. methodology).
        // When true and differential.run is true, produces separate
        // CCAN sets per condition and runs COMPARE_COACCESSIBILITY.
        // Cell-type stratification is independent and always-on (D3).
        disease_stratified   = false
        control_condition    = null    // defaults to differential.control_condition
        treatment_condition  = null    // defaults to differential.treatment_condition
        condition_key        = null    // defaults to differential.condition_key
    }
    enhancer_recipe_c { run = true }

    // =============================
    // MSFP STRIP RENDERS
    // New-style promoter + enhancer strip plots (zoom window, logo, ref seq).
    // Driven by PROMOTER_MSFP_PER_CT h5ads (promoter) and
    // ENHANCER_FOOTPRINTING_PER_CT h5ads (enhancer). Only fires when
    // enhancer_footprinting.msfp_enabled = true.
    // mode: absolute | differential | all_three (promoter strip only)
    // Promoter-strip genes come from scprinter.target_genes. Enhancer-strip genes
    // are discovered per (cell type, TF) by RANK_ENHANCER_STRIP_GENES — see below.
    // =============================
    msfp_strip {
        enabled     = false            // opt-in; requires msfp_enabled = true
        mode        = 'all_three'      // 'absolute' | 'differential' | 'all_three'
        context_bp  = 500000           // enhancer strip genomic context window
        // Enhancer-strip target genes are DISCOVERED per (cell type, TF) by
        // RANK_ENHANCER_STRIP_GENES from TF binding scores × Cicero co-accessibility
        // — they are not configured. These two knobs bound that search:
        top_n_regions = 100            // top enhancer peaks per (CT, TF) by binding score
        top_k_genes   = 5              // genes kept per (CT, TF) after Cicero ranking
    }

    // =============================
    // GENOME BROWSER PLOTS
    // Matplotlib-native per-gene accessibility browser (no CCAN arcs).
    // mode: absolute | differential
    //   differential requires export_atac_bigwigs to have run with condition_col
    //   (i.e. enhancer_viz.condition_col must be set for differential mode).
    // cell_types: ordered list for track display; null → all CT in manifest.
    // =============================
    browser_viz {
        enabled       = false          // opt-in
        mode          = 'absolute'     // 'absolute' | 'differential'
        window        = 15000          // bp padding around gene body
        n_bins        = 700            // BigWig resolution bins
        max_value     = null           // y-axis ceiling; null → auto 99.5th pct
        cell_types    = null           // null → all CTs in manifest
    }
    enhancer_viz {
        run                 = true
        target_genes        = []
        dpi                 = 200
        window_kb           = 100
        coaccess_threshold  = 0.25

        // Coverage export (snap.ex.export_coverage)
        bin_size            = 10
        normalization       = 'RPKM'   // 'RPKM' | 'CPM' | 'BPM' | 'None'
        min_cells           = 100      // skip groups below this cell count
        blacklist           = null     // optional BED of blacklisted regions

        // Override obs column for grouping. null → params.atac.cell_type_col
        // → standard chain. Set 'cell_type_broad' for fewer/denser tracks.
        cell_type_col       = null

        // 2026-05-26: condition_col for per-(CT × condition) BigWig export.
        // When non-null, export_atac_bigwigs.py writes a second pass of BigWigs
        // split by condition, stored in manifest.by_condition. Required for
        // RENDER_GENOME_BROWSER in differential mode.
        // Set to differential.condition_key value when differential.run = true.
        condition_col       = null   // e.g. 'condition_group' when diff is active

        // Swarup-chain (gene, TF, cell_type) candidate filter (B3/C5).
        // Replaces the old 17,490-panel cartesian fan-out.
        composite_filter {
            top_n_per_gene_per_ct = 3
            fdr_cutoff            = 0.05
            lfc_cutoff            = 0.5
            min_motif_sites       = 1
        }
    }

    // =============================
    // CHROMVAR TF MOTIF ENRICHMENT
    // =============================
    chromvar {
        run                = true
        top_n_per_celltype = 5
        min_motif_zscore   = 1.5
        chunk_size         = 30000
        // global_top_n > 0 caps total unique TFs across all CTs to control
        // ENHANCER_FOOTPRINTING_PER_CT fan-out cost. 0 = disabled (all TFs kept).
        global_top_n       = 0
    }

    // =============================
    // scPRINTER TF FOOTPRINTING
    // =============================
    scprinter {
        run                 = true
        target_genes        = []
        gene_coordinates    = null
        cache_dir           = '/dfs7/swaruplab/lesolano/ref/scprinter'
        pfms                = '/dfs7/swaruplab/lesolano/ref/scprinter/JASPAR2022_core_nonredundant.jaspar'
        genome              = 'hg38'
        barcode_dir         = null
        fdr_threshold       = 0.05
        gtf_human           = "${params.gtf_human_full}"
        gtf_mouse           = "${params.gtf_mouse_full}"
        promoter_upstream   = 2000
        promoter_downstream = 500

        // C2/build_printer.nf: parameterize printer filename so mouse runs
        // produce mouse_scprinter.h5ad (not human_*). Species-aware default.
        printer_name = params.species == 'human' ? 'human_scprinter.h5ad' : 'mouse_scprinter.h5ad'
    }

    // =============================
    // DIFFERENTIAL ATAC
    // =============================
    differential {
        run = false
        condition_key = 'condition_group'
        comparisons = []
        cell_types = []
        control_condition = null
        treatment_condition = null
        min_cells = 50
        fdr_threshold = 0.05
    }

    // =============================
    // PROMOTER MSFP OVERLAY (Tier-1 promoter evidence with per-condition stratification)
    // Wired in modules/scprint/promoter_msfp_per_ct.nf + modules/visualization/
    //   render_promoter_msfp_overlay.nf, fired inside ENHANCER_FOOTPRINTING_RECIPES
    //   downstream of AGGREGATE_FP_STATS. Differential-only: gate fails on
    //   single-condition runs, untargeted runs (empty target_genes), or when
    //   build_network=false (no triple_csv to drive the TF ranking).
    // =============================
    promoter_overlay {
        enabled         = false           // golden default; instance configs flip true
        max_scale       = 30              // TF-binding scale ceiling (bp)
        top_n_tfs       = 4               // overlay cap per panel (palette has 8 colors)
        score_threshold = null            // null -> no render-time motif score filter
                                          // (matches MOTIF_SCAN_ENHANCERS default;
                                          //  scprinter applies its own internal cutoff)
        condition_col   = null            // null -> falls back to differential.condition_key
        treatment       = null            // null -> falls back to differential.treatment_condition
        control         = null            // null -> falls back to differential.control_condition
        // 2026-05-06: overlay target_genes decoupled from scprinter.target_genes.
        // Setting scprinter.target_genes non-empty switches the pipeline to
        // TARGETED mode, which short-circuits EXTRACT_CHROMVAR_MOTIFS and
        // MOTIF_SCAN_ENHANCERS (gated on is_discovery_mode), starving the
        // overlay's CT-enumeration channel. Set promoter_overlay.target_genes
        // here instead — DISCOVERY mode stays intact.
        target_genes    = null            // null -> falls back to scprinter.target_genes
    }

    // =============================
    // CIS-REWIRING (per-TF gained-CCAN motif-presence panels)
    // Wired in modules/scprint/{build_union_enhancer_peaks, motif_scan_enhancers_union}.nf
    //   + modules/visualization/{motif_in_gained_ccans, render_cis_rewiring_motif_stack}.nf, fired inside
    //   ENHANCER_FOOTPRINTING_RECIPES Phase 6 (after PROMOTER_MSFP overlay).
    //   Per-condition stratified-Cicero CCAN→gene-link TSVs ([CTRL], [TRT])
    //   + UNION enhancer-peakset motif scan (the methodological fix for the
    //   single-condition scan caveat) → per-TF directionality bar plots.
    //   Differential-only: gate fails on single-condition runs, untargeted
    //   runs (no triple_csv from build_network), or when stratified Cicero
    //   didn't run.
    // =============================
    cis_rewiring {
        enabled                  = false  // golden default; instance configs flip true
        top_n_tfs                = 10     // number of TFs to render panels for
                                          // (ranked by AGGREGATE_FP_STATS triple_csv:
                                          //  total n_sites_in_gene_window then mean
                                          //  bind_dip_depth_mean across all CT,gene)
        top_n_genes              = 25     // genes per panel (top by delta CCAN count)
        min_delta                = 1      // skip genes whose treatment-control delta < this
        // Renderer toggles — both default true. motif_in_gained gives the
        // enrichment-vs-background statistical view; motif_stack preserves the
        // Δ-link ranking and stacks the treatment bar (shared/gained-no-motif/
        // gained-with-motif) so "newly accessible enhancers don't host the TF
        // directly" is visible without sorting by motif match.
        motif_in_gained_enabled  = true
        motif_stack_enabled      = true
        // Gene-selection knobs:
        //   - panels: list of strings ['Label:g1,g2,...', ...] for explicit
        //     panel groupings (motif_stack only; motif_in_gained falls back to
        //     gene_set). null -> agnostic --top-n-by-delta mode.
        //   - panel_file: path to TSV ('label<TAB>g1,g2,...' rows). Same
        //     precedence as panels. null -> not used.
        //   - gene_set: optional explicit gene list passed to motif_in_gained's
        //     --gene-set flag (overrides top-N). null -> top-N picked by delta.
        //   - gene_file: same as gene_set but newline-separated file path.
        //   - exclude_pseudogenes: motif_stack drops Gm*/Rik/Mir*/AU*/LOC*
        //     predicted-only genes when in --top-n-by-delta mode. Cosmetic.
        panels                   = null
        panel_file               = null
        gene_set                 = null
        gene_file                = null
        exclude_pseudogenes      = true
        // target_tfs: explicit TF list for cis-rewiring when msfp_enabled=false
        // (i.e. AGGREGATE_FP_STATS is not available to rank TFs automatically).
        // When msfp_enabled=true and build_network=true, target_tfs is ignored
        // and TFs are ranked from binding evidence. null → empty channel when
        // build_network is off (cis-rewiring lollipop won't fire without TFs).
        target_tfs               = null
        // lollipop: enables RENDER_CICERO_LOLLIPOP for cis-rewiring TFs.
        lollipop_enabled         = true
        min_coacc                = 0.15
    }

    // =============================
    // SHI_FIGURES — Shi et al. 2025 figure equivalents
    // Wired in modules/visualization/{annotate_peak_types, nmf_enhancer_programs,
    //   marker_coverage, select_shi_candidates, coacc_correlation_matrix,
    //   da_peak_breakdown, da_log2fc_heatmaps, tf_differential_volcano,
    //   curated_tf_networks, locus_tf_binding}.nf and workflow SHI_FIGURES in
    //   main.nf. Tier A (peak types, NMF, marker tracks) runs unconditionally;
    //   Tier B (DA/TF differential, curated networks, locus bars) auto-skips
    //   when treatment/control labels are unset or differential CSVs absent.
    // =============================
    shi_figures {
        enabled = false                   // golden default; instance configs flip true
        treatment = ''                    // condition labels (must match upstream)
        control = ''
        cell_type_key = 'cell_type'       // unified canonical column
        condition_key = 'condition_group'
        sample_key    = 'sample'

        // Cutoffs shared across volcano / heatmap / breakdown
        fdr_cutoff = 0.05
        lfc_cutoff = 0.5
        promoter_window = 2000            // +/- bp around TSS for Promoter classification

        // Curated panel selection
        top_tfs_per_celltype = 3
        top_loci = 5
        seed_genes = ''                   // comma-separated gene list; empty -> let selector pick

        // 1E marker tracks
        markers_json = ''                 // empty -> defaults baked into the script
        marker_window = 5000
        marker_width  = 18
        marker_lineages = ''              // optional comma-separated subset
        regen_broad_bigwigs = false       // re-use existing broad bigwig manifest
        bigwig_min_cells = 100

        // 2B NMF
        nmf_k_grid = '6,8,10,12'
        nmf_pick_k = 0                    // 0 -> auto by elbow
        nmf_min_cells = 200
        nmf_top_celltypes = 12

        // 2E heatmaps
        heatmap_top_genes = 8
        heatmap_max_rows  = 80

        // 4B/5A/5C/5E volcanoes
        volcano_top_labels = 10

        // 4C/5B/5D/5F curated networks
        network_max_targets = 12

        // 4E locus TF binding
        locus_top_tfs = 15
    }

    // =============================
    // HPC / SLURM PARAMETERS
    // =============================
    conda_prefix = null

    slurm_account            = 'vswarup_lab'
    slurm_account_gpu        = 'vswarup_lab_gpu'
    slurm_partition_cpu      = 'standard'
    slurm_partition_gpu      = 'gpu'
    slurm_partition_gpu_hugemem = 'gpu-hugemem'
    slurm_qos_gpu_hugemem    = 'gpu-hugemem-vswarup'
    slurm_gpu_type           = 'A30'
    slurm_gpu_count          = 1
}

// ============================================================================
// PROCESS CONFIGURATION — Container assignments + GPU flags
//
// CRITICAL (FIX-51): Container assignments MUST be duplicated inside the
// cluster profile's process block, because Nextflow profile-level withName
// blocks override top-level ones. The top-level blocks below serve as
// defaults for local execution; the cluster profile re-declares them.
// ============================================================================
process {
    executor = 'local'

    withLabel: 'process_small' {
        cpus = { Math.min(1, Runtime.runtime.availableProcessors()) }
        memory = 8.GB
    }
    withLabel: 'process_low' {
        cpus = { Math.min(4, Runtime.runtime.availableProcessors()) }
        memory = 32.GB
    }
    withLabel: 'process_medium' {
        cpus = { Math.min(8, Runtime.runtime.availableProcessors()) }
        memory = 64.GB
    }
    withLabel: 'process_high' {
        cpus = { Math.min(16, Runtime.runtime.availableProcessors()) }
        memory = 128.GB
    }
    withLabel: 'process_gpu' {
        cpus = { Math.min(8, Runtime.runtime.availableProcessors()) }
        memory = 64.GB
    }
    withLabel: 'process_high_memory' {
        cpus = { Math.min(16, Runtime.runtime.availableProcessors()) }
        memory = 256.GB
    }
    withLabel: 'hugemem' {
        cpus = { Math.min(4, Runtime.runtime.availableProcessors()) }
        memory = 500.GB
    }
    withLabel: 'process_hdwgcna' {
        cpus = { Math.min(8, Runtime.runtime.availableProcessors()) }
        memory = 96.GB
    }

    // ---- Per-process container assignments ----

    // GPU Python: CellBender, scVI, scANVI
    withName: 'CELLBENDER|TRAIN_SCVI|TRAIN_SCANVI' {
        container = params.containers.scgpu
    }

    // CellTypist — CPU-only, uses scgpu container for scanpy/celltypist deps
    // ATAC_CELLTYPIST runs CellTypist on gene activity scores (same deps)
    withName: 'RUN_CELLTYPIST|RUN_MARKER_ANNOTATION|ATAC_CELLTYPIST' {
        container = params.containers.scgpu
    }

    // Shi absorbs — TF differential/descriptive + compare co-accessibility.
    // DIFFERENTIAL_TF_ACCESSIBILITY reads chromvar_dev + annotated_peaks h5ads;
    // COMPARE_COACCESSIBILITY reads two Cicero connections TSVs. Pure Python.
    withName: 'DIFFERENTIAL_TF_ACCESSIBILITY|COMPARE_COACCESSIBILITY' {
        container = params.containers.scgpu
    }
    // CICERO_TRIPLETS_STRATIFIED subsets peak matrix by condition → uses snapatac2
    withName: 'CICERO_TRIPLETS_STRATIFIED' {
        container = params.containers.snapatac
    }

    // scATAnno — reference-based ATAC annotation, needs snapatac2 + scATAnno
    withName: 'ATAC_SCATANNO' {
        container = params.containers.snapatac
    }

    // Python (scanpy/scvi, no GPU needed)
    withName: 'RNA_QC|CONCAT_BATCHES|PREPARE_REFERENCE|PLOT_POST_SCANVI|BUILD_MUDATA|MOFA_INTEGRATE|MOFA_VISUALIZE|MULTIVI_INTEGRATE|MULTIVI_VISUALIZE|EXPORT_MUDATA_RNA|CONVERT_CELLISMO|CONCAT_CELLISMO|ASSIGN_TEST_GROUPS|EXTRACT_CELL_TYPES_FOR_MAST|BOOTSTRAP_MOFA_INTEGRATION|CONSENSUS_ANALYSIS|ANALYZE_MEMORY_LOG' {
        container = params.containers.scgpu
    }

    // MultiVI downstream analysis (masking sweep, driver factors, gap-fill, validation)
    withName: 'MULTIVI_MASKING_SWEEP|MULTIVI_DRIVER_FACTORS|MULTIVI_GAP_FILL|MULTIVI_VALIDATE' {
        container = params.containers.scgpu
    }

    // snapatac2: all ATAC processing + GPU_CHROMVAR
    withName: 'ATAC_INITIAL_QC|ATAC_MAKE_THRESHOLDS|ATAC_FINAL_PIPELINE|ATAC_CELLTYPE_ANNOTATION|MERGE_ANNOTATIONS|SNAPATAC_DIFFERENTIAL|CICERO_TRIPLETS|GPU_CHROMVAR|VIS_CHROMVAR|EXTRACT_CHROMVAR_MOTIFS|MAP_TF_TO_TARGET_GENES|SCPRINTER_DORC|RESOLVE_GENE_COORDINATES|RESOLVE_OVERLAY_COORDINATES' {
        container = params.containers.snapatac
    }

    // Overlay coords use a 4000bp window (upstream=2000, downstream=2000) so the
    // motif scan covers the full gene-proximal regulatory region — wider than the
    // default promoter_downstream=500 used for scPrinter footprinting.
    withName: '.*RESOLVE_OVERLAY_COORDINATES' {
        ext.promoter_upstream   = 2000
        ext.promoter_downstream = 2000
    }

    // scPRINTER footprinting + enhancer recipes + visualization
    // EXPORT_ATAC_BIGWIGS uses snapatac2.snap.ex.export_coverage.
    // RENDER_MSFP_{PROMOTER,ENHANCER}_STRIP use scprinter + logomaker.
    // RENDER_GENOME_BROWSER uses pyBigWig (available in snapatac_extended.sif).
    withName: 'SCPRINTER_BARCODES|SCPRINTER_BUILD_PRINTER|SCPRINTER_FOOTPRINTING|SCPRINTER_MOTIF_SCAN|EXTRACT_CCAN_ENHANCERS|MOTIF_SCAN_ENHANCERS|ENHANCER_FOOTPRINTING|EXTRACT_EREGULON_REGIONS|CROSS_MODAL_VALIDATION|CELLCHAT_TO_TF_HYPOTHESES|EXTRACT_SIGNALING_TARGETS|SIGNAL_CHAIN_CORRELATION|PREPARE_ENHANCER_VIZ_TRACKS|COMPOSITE_ENHANCER_VIZ|EXPORT_ATAC_BIGWIGS|RENDER_MSFP_PROMOTER_STRIP|RENDER_MSFP_ENHANCER_STRIP|RENDER_GENOME_BROWSER' {
        container = params.containers.snapatac
    }

    // RENDER_CICERO_LOLLIPOP — pandas/matplotlib/numpy only (no snapatac2 needed)
    withName: 'RENDER_CICERO_LOLLIPOP' {
        container = params.containers.scgpu
    }

    // SCENIC+ / pycisTopic (all phases + ATAC-only entrypoint)
    withName: 'SCENICPLUS_RUN|PYCISTOPIC_PHASE1|PYCISTOPIC_ATAC_PREPARE|PYCISTOPIC_PER_GROUP|PYCISTOPIC_MERGE_OBJECTS|PYCISTOPIC_RUN_LDA|PYCISTOPIC_FINALIZE_LDA|SCENICPLUS_VISUALIZE|SCENICPLUS_GRN_VIZ|PLOT_TF_GENE_NETWORK' {
        container = params.containers.scenicplus
    }

    // BUILD_TF_GENE_NETWORK — plain Python / pandas / numpy (no GPU, no graph-tool)
    withName: 'BUILD_TF_GENE_NETWORK' {
        container = params.containers.scgpu
    }

    // R: Cicero (R_LIBS_USER guard prevents host glibc mismatch)
    withName: 'CICERO_FULL|CICERO_TARGET_PLOTS|CICERO_FULL_STRATIFIED' {
        container = params.containers.r_cicero
        containerOptions = '--env R_LIBS_USER=/dev/null'
    }

    // R: Seurat / MAST / DE / hdWGCNA / conversion
    withName: 'RUN_MAST_DE|CREATE_VOLCANO_PLOTS|RUN_GO_ENRICHMENT|CONVERT_H5AD_FOR_MAST|CONVERT_H5AD_TO_SEURAT|HDWGCNA_PER_CELLTYPE' {
        container = params.containers.r_seurat
        containerOptions = '--env R_LIBS_USER=/dev/null'
    }

    // R: CellChat
    withName: 'RUN_CELLCHAT|COMPARE_CELLCHAT' {
        container = params.containers.r_cellchat
        containerOptions = '--env R_LIBS_USER=/dev/null'
    }

    // GPU accelerator + --nv flag for NVIDIA driver passthrough
    withName: 'TRAIN_SCVI|TRAIN_SCANVI|CELLBENDER|GPU_CHROMVAR|MOFA_INTEGRATE|MULTIVI_INTEGRATE' {
        accelerator = 1
        containerOptions = '--nv'
    }
}

// ============================================================================
// FIX-46: GLOBAL SINGULARITY PATH ISOLATION
// ============================================================================
env {
    SINGULARITYENV_PREPEND_PATH = '/usr/local/nvidia/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
}

// ============================================================================
// PROFILES
// ============================================================================
profiles {
    standard {
        process.executor = 'local'
    }

    cluster {
        includeConfig 'configs/profiles/hpc3_cluster.config'
    }

    gpu {
        process.executor = 'slurm'

        process {
            clusterOptions = "-A ${params.slurm_account_gpu} -p ${params.slurm_partition_gpu} --gres=gpu:${params.slurm_gpu_type}:${params.slurm_gpu_count}"
            cpus   = 8
            memory = '64.GB'
            time   = '8h'

            withName: 'MOFA_INTEGRATE|MULTIVI_INTEGRATE|BUILD_MUDATA|SCENICPLUS_RUN|PYCISTOPIC_PHASE1|PYCISTOPIC_ATAC_PREPARE|PYCISTOPIC_FINALIZE_LDA' {
                cpus   = 16
                memory = '256.GB'
                time   = '48h'
            }
        }

        executor {
            submitRateLimit = '5 sec'
            queueSize       = 50
            pollInterval    = '1 min'
        }
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = false
        singularity.cacheDir   = "${projectDir}/singularity_cache"
        // FIX-27b: --contain prevents admin bind paths from /etc/singularity/singularity.conf
        // FIX-27c: --contain suppresses writable home; redirect caches to /tmp
        // FIX-46b: --bind /dev/shm gives PyTorch access to POSIX shared memory
        // FIX-54a: --home /tmp sets HOME inside --contain (--env HOME rejected by Singularity CE)
        singularity.runOptions = "--contain --home /tmp --bind /dfs7 --bind /tmp --bind /dev/shm --env NUMBA_CACHE_DIR=/tmp/numba_cache --env MPLCONFIGDIR=/tmp/matplotlib --env XDG_CACHE_HOME=/tmp/cache --env CUPY_CACHE_DIR=/tmp/cupy_cache --env PYTHONNOUSERSITE=1 --env HDF5_USE_FILE_LOCKING=FALSE"
    }

    docker {
        docker.enabled = true
    }

    // ------------------------------------------------------------------------
    // test — dependency-free verification. Strips every site-specific scheduler
    // assumption (SLURM partitions, accounts, QOS, --gres) so the pipeline can be
    // validated anywhere, with no containers, no reference files, and no GPU.
    //
    //   nextflow run main.nf -profile test -preview \
    //       -c configs/datasets/test_preview.config
    //
    // Intended for -preview, which constructs the full DAG and runs the
    // pre-flight checklist without submitting work (~10 s). See
    // docs/verification.md.
    //
    // outdir is redirected to results_test/ so that anything this profile does
    // produce can never be published over real results.
    // ------------------------------------------------------------------------
    test {
        params.resource_tier = 'test'       // loads configs/resource_tiers/test.config
        params.outdir        = 'results_test'
        process.executor     = 'local'
        singularity.enabled  = false
        docker.enabled       = false
    }

    // ------------------------------------------------------------------------
    // tutorial — CPU-only tier-2 run on the small tutorial dataset.
    //
    //   nextflow run main.nf -profile tutorial,singularity \
    //       -c configs/datasets/tutorial_pbmc.config -resume
    //
    // This profile exists because `params.resource_tier` set inside a `-c` file
    // CANNOT select a resource tier: the includeConfig chain at the bottom of
    // this file is evaluated while nextflow.config is being parsed, which is
    // BEFORE `-c` files are merged. Verified 2026-08-06 — a `-c` file declaring
    // 'tutorial' still resolved small.config's 200 GB MULTIVI_INTEGRATE block.
    // Setting the tier in a profile is evaluated in time and does work.
    //
    // The per-instance launch.sh scripts instead scrape the tier out of the
    // dataset config and re-pass it as `--resource_tier` on the command line;
    // that path is long-standing but was NOT re-verified here, so prefer a
    // profile for anything new.
    //
    // Unlike `test`, containers stay ENABLED — this runs real tools.
    // ------------------------------------------------------------------------
    tutorial {
        params.resource_tier = 'tutorial'   // loads configs/resource_tiers/tutorial.config
        process.executor     = 'local'
    }
}

// ============================================================================
// RESOURCE TIER LOADING
// ============================================================================
// Load resource overrides based on params.resource_tier. 'auto' aliases to
// 'small' (safe default). Invalid values are caught by validateStartupParams()
// in main.nf — see MIS-11/MIS-25 (2026-05-04) typo guard.
if (params.resource_tier == 'test') {
    includeConfig 'configs/resource_tiers/test.config'
} else if (params.resource_tier == 'tutorial') {
    includeConfig 'configs/resource_tiers/tutorial.config'
} else if (params.resource_tier == 'large') {
    includeConfig 'configs/resource_tiers/large.config'
} else if (params.resource_tier == 'medium') {
    includeConfig 'configs/resource_tiers/medium.config'
} else if (params.resource_tier == 'small' || params.resource_tier == 'auto') {
    includeConfig 'configs/resource_tiers/small.config'
}
// If params.resource_tier is invalid (typo), no tier loads and the validator
// in main.nf errors before any compute runs.

// ============================================================================
// Nextflow execution reports
// ============================================================================
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.tsv"
    fields    = 'task_id,hash,native_id,name,status,exit,realtime,cpus,memory,rss,peak_rss'
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
dag {
    overwrite = true
}
