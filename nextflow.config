// ============================================================================
// nextflow.config — Unified Multiomics Pipeline (refactor5)
//
// Base config with all parameter defaults, container definitions,
// process-level container assignments, and profile definitions.
//
// Usage:
//   nextflow run main.nf -profile cluster,singularity \
//       -c configs/datasets/pbmc_10x_10k.config -resume
//
// Resource tiers are loaded automatically based on params.resource_tier:
//   'small'  — PBMC-scale (10k cells, single sample)
//   'large'  — BD-scale (100+ samples, 100k+ cells)
//   'auto'   — alias for 'small' (safe default)
// ============================================================================

params {
    // =============================
    // RESOURCE TIER
    // =============================
    // Controls which resource config is loaded (small / large / auto).
    // Override in dataset config or on CLI: --resource_tier large
    resource_tier = 'auto'

    // =============================
    // SPECIES & DIRECTORIES
    // =============================
    species = 'human'

    // Output directories
    outdir  = 'results'
    tempdir = '/tmp'

    // Manifest / metadata
    metadata_file = null

    // Conversion / intermediate file toggles
    save_converted    = false
    save_intermediate = false

    // =============================
    // ON-RAMP: PRE-COMPUTED INPUTS
    // =============================
    // Set any of these to skip upstream steps and resume from a checkpoint.
    // All null by default — pipeline runs from raw data.
    onramp {
        // RNA / multiome (src-original)
        rna_integrated_h5ad         = null
        atac_peak_matrix_h5ad       = null
        mudata_h5mu                 = null
        cistopic_obj_pkl            = null
        printer_h5ad                = null
        seurat_rds                  = null
        cicero_connections          = null
        chromvar_deviations         = null

        // D2: granular ATAC onramp (absorbed from SDas_nf)
        atac_individual_samples_dir = null   // dir of per-sample h5ads (from ATAC_INITIAL_QC)
        cicero_ccan                 = null   // CCAN_assignments.tsv.gz
        cicero_cds                  = null   // input_cds_ordered.rds
        chromvar_raw                = null   // chromvar_raw.h5ad
        da_peaks_dir                = null   // dir of DA_peaks_*.csv

        // D2: stratified-mode onramp (CTRL/TRT split)
        cicero_connections_ctrl     = null
        cicero_connections_trt      = null
        cicero_ccan_ctrl            = null
        cicero_ccan_trt             = null
    }

    // =============================
    // GENERIC BATCH DIRECTORY MAPS
    // =============================
    // Populated in dataset configs for multi-batch experiments.
    // Keys are batch names, values are directory paths.
    batch_dirs              = [:]
    demux_metadata          = [:]
    demux_souporcell_dirs   = [:]
    atac_fragment_dirs_bc   = [:]
    atac_fragment_dirs_coord = [:]

    // =============================
    // RESOURCE PATHS
    // =============================
    ref_dir = "${projectDir}/references"

    gtf_human_full = null
    gtf_mouse_full = null
    blacklist_bed  = null

    // Reference atlas — null triggers Path B (CellTypist direct, no scANVI)
    // Set to a directory to trigger Path A (scANVI + CellTypist)
    ref_dir_human_integrated = null
    ref_dir_mouse_integrated = null

    // =============================
    // CONTAINER DEFINITIONS
    // =============================
    containers = [
        scgpu:       "${projectDir}/singularity_cache/scgpu_extended.sif",
        snapatac:    "${projectDir}/singularity_cache/snapatac_extended.sif",
        scenicplus:  "${projectDir}/singularity_cache/scenicplus.sif",
        r_cicero:    "${projectDir}/singularity_cache/cicero.sif",
        r_seurat:    "${projectDir}/singularity_cache/seurat_extended.sif",
        r_cellchat:  "${projectDir}/singularity_cache/seurat_extended.sif",
    ]

    // =============================
    // CELLBENDER PARAMETERS
    // =============================
    cellbender {
        total_droplets = 20000
        expected_cells = 5000
        fpr = 0.01
        epochs = 150
        low_count_threshold = 0
    }

    // =============================
    // POST-HOC QC REPORT (Viz overhaul §4)
    // =============================
    qc {
        post_hoc_report = false   // opt-in — re-renders FORGE-style TSSE
                                  // marginal scatter from atac_complete.h5ads
    }

    // =============================
    // VIZ_ONLY entry workflow (D2; absorbed from SDas_nf)
    // =============================
    // Re-renders post-hoc QC + Cicero target plots from already-persisted
    // artifacts under results/. Invoke via: nextflow run main.nf -entry VIZ_ONLY
    viz_only {
        peak_matrix_h5ad   = null    // → POST_QC_REPORT (path)
        cicero_connections = null    // ┐ all three required to render
        cicero_ccan        = null    // ├ CICERO_TARGET_PLOTS
        cicero_cds         = null    // ┘
        target_genes       = null    // CSV string or List; falls back to params.cicero.target_genes
    }

    // =============================
    // RNA QC PARAMETERS
    // =============================
    min_genes = 200
    min_cells = 3
    mt_threshold = 20

    // =============================
    // RNA DIFFERENTIAL EXPRESSION
    // =============================
    differential_rna {
        run = false
        condition_key = 'condition_group'
        cell_type_key = 'cell_type'
        group_mapping = null
        comparisons = []
        run_go_enrichment = false
        pval_cutoff = 0.05
        log2fc_cutoff = 0.25
    }

    // =============================
    // CELLTYPIST
    // =============================
    celltypist {
        enabled = true
        model   = 'Immune_All_Low.pkl'
    }

    // =============================
    // scATAnno (reference-based ATAC annotation)
    // =============================
    scatanno {
        reference_atlas       = null
        atlas_name            = 'general'
        distance_threshold    = 95
        uncertainty_threshold = 0.5
        n_dims                = 30
        knn_neighbors         = 30
    }

    // =============================
    // INTEGRATION PARAMETERS
    // =============================
    n_epochs_scvi = 50
    scanvi_epochs = 50
    n_top_genes = 4000
    mudata  { batch_size = 10 }

    // =============================
    // MODULE TOGGLES
    // =============================
    rna {
        run = true
        // RNA cell-type annotation method:
        //   'celltypist' → RUN_CELLTYPIST (requires params.celltypist.model)
        //   'markers'    → RUN_MARKER_ANNOTATION (requires rna.marker_file)
        annotation_method   = 'celltypist'
        marker_file         = null
        marker_min_score    = 0.0    // score_genes floor; below → 'unknown'
        marker_score_margin = 0.1    // min top-vs-second gap; below → collapse or 'unknown'
    }

    // =============================
    // ATAC PARAMETERS
    // =============================
    atac {
        run = true
        run_initial_qc = true
        min_fragments = 1000
        initial_min_counts = 1000
        initial_min_tsse = 5
        auto_annotate = true

        // ATAC QC & clustering params
        min_counts = null
        min_tsse = null
        max_counts = null
        initial_max_counts = 100000
        n_features = 50000
        batch_correction = 'none'
        batch_key = null
        clustering_resolutions = [0.5, 1.0, 2.0]
        peak_fdr = 0.05
        tempdir = null
        cisbp_human = "/dfs7/swaruplab/lesolano/ref/snapatac2/cisBP_2.00_human.meme"
        cisbp_mouse = "/dfs7/swaruplab/lesolano/ref/snapatac2/cisBP_2.00_mouse.meme"

        // Annotation resolution used by MERGE_ANNOTATIONS
        annotation_resolution = 'leiden_0_5'

        // BD demux fragment directories (per batch) — null by default
        demux_bc_dir_june = null
        demux_bc_dir_july = null
        demux_bc_dir_nov  = null
        demux_coord_dir_june = null
        demux_coord_dir_july = null
        demux_coord_dir_nov  = null

        // ATAC manifest
        sample_metadata = null

        // Cell type annotation mode:
        //   annotation_method = 'celltypist' → CellTypist on gene activity (default)
        //   annotation_method = 'scatanno'   → scATAnno reference-based peak annotation
        //   marker_file = path               → marker-based super-user mode (overrides above)
        annotation_method = 'scatanno'
        tissue_type = 'pbmc'
        marker_file = null

        // 2026-04-29: granularity knob for stratified Cicero / per-ct
        // analyses. 'broad' → ~10-class Allen subclass (default); 'fine' →
        // ~30+ subclasses. Used by C-tier annotation_key resolution and
        // by D3 stratified-Cicero default.
        run_mode = 'broad'

        // Override obs column used as cell-type label in downstream
        // analyses. null → fall back to the standard chain
        // (cell_type → cell_type_prediction → celltypist_prediction → pred_y).
        // Set explicitly to 'cell_type_broad' to use the C4 broad-class
        // coarsening output from MERGE_ANNOTATIONS.
        cell_type_col = null
    }

    // =============================
    // CICERO
    // =============================
    cicero {
        run = true
        sample_num = 100
        num_dim = 50
        connections_cutoff = 0.25
        ccan_min_coaccess = 0.1
        use_partition = false
        outdir = "${params.outdir}/cicero"
        use_chromvar_targets = true
        target_genes = []
        gtf_full = null
        gtf_plot = null

        // CICERO_TARGET_PLOTS per-window plotting settings (parallel
        // lists, equal length). 3-tier default mirrors SDas:
        //   strict      = ±100kb @ 0.10 coaccess
        //   permissive  = ±250kb @ 0.05
        //   exploratory = ±500kb @ 0.025
        plot_windows    = "100000,250000,500000"
        plot_thresholds = "0.10,0.05,0.025"
        plot_labels     = "strict,permissive,exploratory"

        // Shi et al. stratified Cicero: runs Cicero SEPARATELY per condition,
        // then COMPARE_COACCESSIBILITY contrasts the two maps. Absorbed from SDas.
        // Runs IN ADDITION TO the default global Cicero (both are useful).
        stratified           = false       // opt-in; requires 2 condition labels
        condition_key        = 'condition_group'
        control_condition    = null        // e.g., 'WT'
        treatment_condition  = null        // e.g., 'TG'
    }

    // =============================
    // DIFFERENTIAL TF ACCESSIBILITY (Shi et al.)
    // =============================
    // Per-celltype TF-motif testing on the ChromVAR deviation matrix.
    // mode='descriptive'  — cell_type vs rest (single-condition friendly)
    // mode='differential' — treatment vs control within a cell type (needs 2+ cond)
    // See main.nf REGULATORY_ANALYSIS for the fan-out logic.
    differential_tf {
        run            = false                 // opt-in; flip true + populate cell_types
        mode           = 'descriptive'          // 'descriptive' | 'differential'
        condition_key  = 'condition_group'
        cell_types     = []                     // required when run=true
        // differential-mode inputs (ignored in descriptive):
        comparisons    = []                     // e.g. [['TG','WT']]
        // descriptive-mode optional subset filter:
        conditions     = []                     // e.g. ['Control']; [] = no filter
        min_cells      = 50
        fdr_cutoff     = 0.05
    }

    // =============================
    // CELLCHAT
    // Tier 1 (always-on): Global L-R inference on ALL cells
    // Tier 2 (optional):  Per-condition CellChat + comparative analysis
    //   Enable Tier 2 by setting conditions = ['Control', 'Treatment']
    // =============================
    cellchat {
        run                = true
        cell_type_key      = 'cell_type'
        condition_key      = 'condition_group'
        conditions         = []
        group_mapping      = null

        // ATAC-side CellChat (B1 modules/atac/cellchat.nf) — used in
        // ATAC-only run modes. RNA-side CellChat keys above remain
        // canonical for multiome runs.
        control            = null      // defaults to differential.control_condition
        treatment          = null      // defaults to differential.treatment_condition
        max_workers        = 10
        future_maxsize_gb  = 150
    }

    // =============================
    // hdWGCNA
    // Tier 1 (always-on): Per-cell-type network construction
    // Tier 2 (optional):  DME + module-trait correlation
    // =============================
    hdwgcna {
        run                  = true
        cell_type_key        = 'cell_type'
        min_cells            = 100
        metadata             = null
        condition_key        = 'none'
        control_condition    = null
        treatment_condition  = null
        traits               = []
    }

    // =============================
    // MULTIOME INTEGRATION
    // =============================
    run_multiome_integration = true
    mofa {
        run = true
        mode = 'high_memory'
        n_factors = 15
        convergence_mode = 'medium'
        bootstrap { n_iterations = 10; sample_fraction = 0.5 }
    }
    multivi {
        run              = true
        n_epochs         = 200
        batch_key        = 'sample_id'
        modality_weights = 'equal'
        modality_penalty = 'Jeffreys'
        n_latent         = 20
        cell_type_key    = 'cell_type'
        run_imputation   = false
        run_differential = false
    }

    // =============================
    // GRN MODULES
    // =============================
    pycistopic {
        run = true
        species = null  // FIX-P0-8: Auto-derived from params.species at runtime; override only if needed
        blacklist_bed = null
        gtf = null
    }
    scenicplus {
        run = true
        ctx_rankings = null
        ctx_scores   = null
        motif_annotations = null
        bc_transform_func = null
        gtf = null
        fai = null
    }
    dorc { run = false }

    // =============================
    // ENHANCER FOOTPRINTING RECIPES
    // =============================
    enhancer_footprinting {
        run = true
        enhancer_mode = 'ccan'          // 'ccan' or 'pairwise_95'
        percentile_threshold = 95       // for pairwise_95 mode

        // Phase 3: ATAC-only TF-gene regulatory network (Shi et al. TF_Net).
        // Absorbed from SDas_nf — continuous scPrinter binding × Cicero co-access.
        build_network            = false    // opt-in; requires chromvar + discovery mode
        binding_threshold        = 'otsu'   // 'otsu' | 'percentile_75' | float
        network_plot_top_n       = 5        // top-N TFs per cell type in plots
        network_plot_max_targets = 15       // max target genes per TF in plots
        network_plot_min_shared  = 5        // min shared targets for co-reg edge

        // 2026-04-29: per-cell-type architecture toggle (B2). true →
        // ENHANCER_FOOTPRINTING_PER_CT (one task per ct loads printer/peak
        // matrix once; cuts task count from ~657 to ~10/33). false →
        // legacy sharded ENHANCER_FOOTPRINTING (one task per (ct, TF)).
        use_per_ct           = false   // opt-in until D1 wires both paths

        // Disease-stratified co-accessibility (Shi et al. methodology).
        // When true and differential.run is true, produces separate
        // CCAN sets per condition and runs COMPARE_COACCESSIBILITY.
        // Cell-type stratification is independent and always-on (D3).
        disease_stratified   = false
        control_condition    = null    // defaults to differential.control_condition
        treatment_condition  = null    // defaults to differential.treatment_condition
        condition_key        = null    // defaults to differential.condition_key
    }
    enhancer_recipe_c { run = true }
    enhancer_viz {
        run                 = true
        target_genes        = []
        dpi                 = 200
        window_kb           = 100
        coaccess_threshold  = 0.25

        // Coverage export (snap.ex.export_coverage)
        bin_size            = 10
        normalization       = 'RPKM'   // 'RPKM' | 'CPM' | 'BPM' | 'None'
        min_cells           = 100      // skip groups below this cell count
        blacklist           = null     // optional BED of blacklisted regions

        // Override obs column for grouping. null → params.atac.cell_type_col
        // → standard chain. Set 'cell_type_broad' for fewer/denser tracks.
        cell_type_col       = null

        // Swarup-chain (gene, TF, cell_type) candidate filter (B3/C5).
        // Replaces the old 17,490-panel cartesian fan-out.
        composite_filter {
            top_n_per_gene_per_ct = 3
            fdr_cutoff            = 0.05
            lfc_cutoff            = 0.5
            min_motif_sites       = 1
        }
    }

    // =============================
    // CHROMVAR TF MOTIF ENRICHMENT
    // =============================
    chromvar {
        run                = true
        top_n_per_celltype = 5
        min_motif_zscore   = 1.5
        chunk_size         = 30000
    }

    // =============================
    // scPRINTER TF FOOTPRINTING
    // =============================
    scprinter {
        run                 = true
        target_genes        = []
        gene_coordinates    = null
        cache_dir           = '/dfs7/swaruplab/lesolano/ref/scprinter'
        pfms                = '/dfs7/swaruplab/lesolano/ref/scprinter/JASPAR2022_core_nonredundant.jaspar'
        genome              = 'hg38'
        barcode_dir         = null
        fdr_threshold       = 0.05
        gtf_human           = "${params.gtf_human_full}"
        gtf_mouse           = "${params.gtf_mouse_full}"
        promoter_upstream   = 2000
        promoter_downstream = 500

        // C2/build_printer.nf: parameterize printer filename so mouse runs
        // produce mouse_scprinter.h5ad (not human_*). Species-aware default.
        printer_name = params.species == 'human' ? 'human_scprinter.h5ad' : 'mouse_scprinter.h5ad'
    }

    // =============================
    // DIFFERENTIAL ATAC
    // =============================
    differential {
        run = false
        condition_key = 'condition_group'
        comparisons = []
        cell_types = []
        control_condition = null
        treatment_condition = null
        min_cells = 50
        fdr_threshold = 0.05
    }

    // =============================
    // HPC / SLURM PARAMETERS
    // =============================
    conda_prefix = null

    slurm_account            = 'vswarup_lab'
    slurm_account_gpu        = 'vswarup_lab_gpu'
    slurm_partition_cpu      = 'standard'
    slurm_partition_gpu      = 'gpu'
    slurm_partition_gpu_hugemem = 'gpu-hugemem'
    slurm_qos_gpu_hugemem    = 'gpu-hugemem-vswarup'
    slurm_gpu_type           = 'A30'
    slurm_gpu_count          = 1
}

// ============================================================================
// PROCESS CONFIGURATION — Container assignments + GPU flags
//
// CRITICAL (FIX-51): Container assignments MUST be duplicated inside the
// cluster profile's process block, because Nextflow profile-level withName
// blocks override top-level ones. The top-level blocks below serve as
// defaults for local execution; the cluster profile re-declares them.
// ============================================================================
process {
    executor = 'local'

    withLabel: 'process_small' {
        cpus = { Math.min(1, Runtime.runtime.availableProcessors()) }
        memory = 8.GB
    }
    withLabel: 'process_low' {
        cpus = { Math.min(4, Runtime.runtime.availableProcessors()) }
        memory = 32.GB
    }
    withLabel: 'process_medium' {
        cpus = { Math.min(8, Runtime.runtime.availableProcessors()) }
        memory = 64.GB
    }
    withLabel: 'process_high' {
        cpus = { Math.min(16, Runtime.runtime.availableProcessors()) }
        memory = 128.GB
    }
    withLabel: 'process_gpu' {
        cpus = { Math.min(8, Runtime.runtime.availableProcessors()) }
        memory = 64.GB
    }
    withLabel: 'process_high_memory' {
        cpus = { Math.min(16, Runtime.runtime.availableProcessors()) }
        memory = 256.GB
    }
    withLabel: 'hugemem' {
        cpus = { Math.min(4, Runtime.runtime.availableProcessors()) }
        memory = 500.GB
    }
    withLabel: 'process_hdwgcna' {
        cpus = { Math.min(8, Runtime.runtime.availableProcessors()) }
        memory = 96.GB
    }

    // ---- Per-process container assignments ----

    // GPU Python: CellBender, scVI, scANVI
    withName: 'CELLBENDER|TRAIN_SCVI|TRAIN_SCANVI' {
        container = params.containers.scgpu
    }

    // CellTypist — CPU-only, uses scgpu container for scanpy/celltypist deps
    // ATAC_CELLTYPIST runs CellTypist on gene activity scores (same deps)
    withName: 'RUN_CELLTYPIST|RUN_MARKER_ANNOTATION|ATAC_CELLTYPIST' {
        container = params.containers.scgpu
    }

    // Shi absorbs — TF differential/descriptive + compare co-accessibility.
    // DIFFERENTIAL_TF_ACCESSIBILITY reads chromvar_dev + annotated_peaks h5ads;
    // COMPARE_COACCESSIBILITY reads two Cicero connections TSVs. Pure Python.
    withName: 'DIFFERENTIAL_TF_ACCESSIBILITY|COMPARE_COACCESSIBILITY' {
        container = params.containers.scgpu
    }
    // CICERO_TRIPLETS_STRATIFIED subsets peak matrix by condition → uses snapatac2
    withName: 'CICERO_TRIPLETS_STRATIFIED' {
        container = params.containers.snapatac
    }

    // scATAnno — reference-based ATAC annotation, needs snapatac2 + scATAnno
    withName: 'ATAC_SCATANNO' {
        container = params.containers.snapatac
    }

    // Python (scanpy/scvi, no GPU needed)
    withName: 'RNA_QC|CONCAT_BATCHES|PREPARE_REFERENCE|PLOT_POST_SCANVI|BUILD_MUDATA|MOFA_INTEGRATE|MOFA_VISUALIZE|MULTIVI_INTEGRATE|MULTIVI_VISUALIZE|EXPORT_MUDATA_RNA|CONVERT_CELLISMO|CONCAT_CELLISMO|ASSIGN_TEST_GROUPS|EXTRACT_CELL_TYPES_FOR_MAST|BOOTSTRAP_MOFA_INTEGRATION|CONSENSUS_ANALYSIS|ANALYZE_MEMORY_LOG' {
        container = params.containers.scgpu
    }

    // MultiVI downstream analysis (masking sweep, driver factors, gap-fill, validation)
    withName: 'MULTIVI_MASKING_SWEEP|MULTIVI_DRIVER_FACTORS|MULTIVI_GAP_FILL|MULTIVI_VALIDATE' {
        container = params.containers.scgpu
    }

    // snapatac2: all ATAC processing + GPU_CHROMVAR
    withName: 'ATAC_INITIAL_QC|ATAC_MAKE_THRESHOLDS|ATAC_FINAL_PIPELINE|ATAC_CELLTYPE_ANNOTATION|MERGE_ANNOTATIONS|SNAPATAC_DIFFERENTIAL|CICERO_TRIPLETS|GPU_CHROMVAR|VIS_CHROMVAR|EXTRACT_CHROMVAR_MOTIFS|MAP_TF_TO_TARGET_GENES|SCPRINTER_DORC|RESOLVE_GENE_COORDINATES' {
        container = params.containers.snapatac
    }

    // scPRINTER footprinting + enhancer recipes + visualization
    withName: 'SCPRINTER_BARCODES|SCPRINTER_BUILD_PRINTER|SCPRINTER_FOOTPRINTING|SCPRINTER_MOTIF_SCAN|EXTRACT_CCAN_ENHANCERS|MOTIF_SCAN_ENHANCERS|ENHANCER_FOOTPRINTING|EXTRACT_EREGULON_REGIONS|CROSS_MODAL_VALIDATION|CELLCHAT_TO_TF_HYPOTHESES|EXTRACT_SIGNALING_TARGETS|SIGNAL_CHAIN_CORRELATION|PREPARE_ENHANCER_VIZ_TRACKS|COMPOSITE_ENHANCER_VIZ' {
        container = params.containers.snapatac
    }

    // SCENIC+ / pycisTopic
    withName: 'SCENICPLUS_RUN|PYCISTOPIC_PREPARE|SCENICPLUS_VISUALIZE|SCENICPLUS_GRN_VIZ|PLOT_TF_GENE_NETWORK' {
        container = params.containers.scenicplus
    }

    // BUILD_TF_GENE_NETWORK — plain Python / pandas / numpy (no GPU, no graph-tool)
    withName: 'BUILD_TF_GENE_NETWORK' {
        container = params.containers.scgpu
    }

    // R: Cicero (R_LIBS_USER guard prevents host glibc mismatch)
    withName: 'CICERO_FULL|CICERO_TARGET_PLOTS|CICERO_FULL_STRATIFIED' {
        container = params.containers.r_cicero
        containerOptions = '--env R_LIBS_USER=/dev/null'
    }

    // R: Seurat / MAST / DE / hdWGCNA / conversion
    withName: 'RUN_MAST_DE|CREATE_VOLCANO_PLOTS|RUN_GO_ENRICHMENT|CONVERT_H5AD_FOR_MAST|CONVERT_H5AD_TO_SEURAT|HDWGCNA_PER_CELLTYPE' {
        container = params.containers.r_seurat
        containerOptions = '--env R_LIBS_USER=/dev/null'
    }

    // R: CellChat
    withName: 'RUN_CELLCHAT|COMPARE_CELLCHAT' {
        container = params.containers.r_cellchat
        containerOptions = '--env R_LIBS_USER=/dev/null'
    }

    // GPU accelerator + --nv flag for NVIDIA driver passthrough
    withName: 'TRAIN_SCVI|TRAIN_SCANVI|CELLBENDER|GPU_CHROMVAR|MOFA_INTEGRATE|MULTIVI_INTEGRATE' {
        accelerator = 1
        containerOptions = '--nv'
    }
}

// ============================================================================
// FIX-46: GLOBAL SINGULARITY PATH ISOLATION
// ============================================================================
env {
    SINGULARITYENV_PREPEND_PATH = '/usr/local/nvidia/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
}

// ============================================================================
// PROFILES
// ============================================================================
profiles {
    standard {
        process.executor = 'local'
    }

    cluster {
        includeConfig 'configs/profiles/hpc3_cluster.config'
    }

    gpu {
        process.executor = 'slurm'

        process {
            clusterOptions = "-A ${params.slurm_account_gpu} -p ${params.slurm_partition_gpu} --gres=gpu:${params.slurm_gpu_type}:${params.slurm_gpu_count}"
            cpus   = 8
            memory = '64.GB'
            time   = '8h'

            withName: 'MOFA_INTEGRATE|MULTIVI_INTEGRATE|BUILD_MUDATA|SCENICPLUS_RUN|PYCISTOPIC_PREPARE' {
                cpus   = 16
                memory = '256.GB'
                time   = '48h'
            }
        }

        executor {
            submitRateLimit = '5 sec'
            queueSize       = 50
            pollInterval    = '1 min'
        }
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = false
        singularity.cacheDir   = "${projectDir}/singularity_cache"
        // FIX-27b: --contain prevents admin bind paths from /etc/singularity/singularity.conf
        // FIX-27c: --contain suppresses writable home; redirect caches to /tmp
        // FIX-46b: --bind /dev/shm gives PyTorch access to POSIX shared memory
        // FIX-54a: --home /tmp sets HOME inside --contain (--env HOME rejected by Singularity CE)
        singularity.runOptions = "--contain --home /tmp --bind /dfs7 --bind /tmp --bind /dev/shm --env NUMBA_CACHE_DIR=/tmp/numba_cache --env MPLCONFIGDIR=/tmp/matplotlib --env XDG_CACHE_HOME=/tmp/cache --env CUPY_CACHE_DIR=/tmp/cupy_cache --env PYTHONNOUSERSITE=1 --env HDF5_USE_FILE_LOCKING=FALSE"
    }

    docker {
        docker.enabled = true
    }
}

// ============================================================================
// RESOURCE TIER LOADING
// ============================================================================
// Load resource overrides based on params.resource_tier.
// 'auto' defaults to 'small' (safe for any dataset).
// Dataset configs should set resource_tier = 'large' for BD-scale data.
if (params.resource_tier == 'large') {
    includeConfig 'configs/resource_tiers/large.config'
} else if (params.resource_tier == 'medium') {
    includeConfig 'configs/resource_tiers/medium.config'
} else {
    // 'auto' and 'small' both load the small tier
    includeConfig 'configs/resource_tiers/small.config'
}

// ============================================================================
// Nextflow execution reports
// ============================================================================
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.tsv"
    fields    = 'task_id,hash,native_id,name,status,exit,realtime,cpus,memory,rss,peak_rss'
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
dag {
    overwrite = true
}
