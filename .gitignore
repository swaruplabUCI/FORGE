# Nextflow runtime
work/
.nextflow/
.nextflow.log*
trace-*.txt
timeline-*.html
report-*.html
dag-*.dot

# Results (large outputs, not code) — glob catches results_test/, results_dev/, etc.
results/
results*/
output/

# Singularity containers (large binaries)
singularity_cache/

# Tutorial dataset (~79 MB, distributed as a release tarball, not via git).
# NOTE: test_data/ is deliberately NOT ignored — it is 7 KB and ships in-repo.
tutorial_data/

# Tutorial on-ramp bundle (~19 MB of h5ads), built by
# dev_notes/phase3/build_onramp_chromvar.sh. NOT shipped — under the tutorial's
# own settings it unlocks nothing (see that script's header). Ignored so the
# artifacts of an exploratory build never land in git.
tutorial_onramp/

# MkDocs build output (`mkdocs build` writes here; the site deploys from CI).
site/

# HPC job logs
slurm-*.out
container_build_*.log
forge-tutorial-*.log
dev_notes/phase3/onramp_chromvar_*.log

# Data files (too large for git)
*.h5
*.h5ad
*.h5mu
*.rds
*.pkl
*.bam
*.bai
*.bed.gz
*.tsv.gz
*.bigWig
*.bw

# Python cache
__pycache__/
*.pyc

# OS/editor
.DS_Store
*.swp
*~

# Secrets
.env
dev_notes/phase3/concordance/per_cell_results.csv

# Release assets are staged locally and uploaded to a GitHub Release, never
# committed. The manifests that describe them (checksums, expected_results.json,
# RELEASE_NOTES.md) ARE committed, so the release stays reproducible from the repo.
dev_notes/phase3/release_assets/*.tar.gz
dev_notes/phase3/release_assets/figures/*.png
dev_notes/phase3/release_assets/figures/*.pdf
