// ============================================================================
// configs/datasets/test_preview.config — DAG verification fixture
//
//   nextflow run main.nf -profile test -preview -c configs/datasets/test_preview.config
//
// Pairs with test_data/, which ships in the repository. Every path below points
// at a placeholder file of a few hundred bytes, so this runs with NO downloads,
// NO containers, and NO GPU, in about ten seconds.
//
// What this verifies:
//   - the manifest parses and every pre-flight check passes
//   - species / genome-build / reference consistency validation
//   - parameter gating across every optional block enabled below
//   - the complete process graph CONSTRUCTS — all includes resolve, every
//     channel referenced exists in scope, and no `val` input evaluates to null
//
// What it does NOT verify: anything at task runtime. No process body executes,
// so runtime channel joins (e.g. the per-sample multiome join, which keys on
// output filenames) and scientific correctness are out of scope — those are
// covered by the tier-2 tiny dataset. See docs/verification.md.
//
// Never point this config at real data.
// ============================================================================

params {
    species       = 'human'
    metadata_file = "${projectDir}/test_data/manifest.csv"

    // The fixture manifest deliberately omits the `data_dir` column so that it
    // stays relocatable — an absolute path baked into a committed CSV only ever
    // resolves on the machine that wrote it. Sample directories come from the
    // batch_dirs maps instead, keyed on the manifest's `batch` column, which is
    // the same mechanism the real dataset configs use.
    batch_dirs      = [ stubbatch: "${projectDir}/test_data/samples" ]
    atac_batch_dirs = [ stubbatch: "${projectDir}/test_data/samples" ]
    // outdir is forced to results_stub/ by -profile test so that the empty stub
    // outputs can never be published over real results.

    // ---- References: placeholders, never read by stub bodies ----------------
    gtf_human_full = "${projectDir}/test_data/refs/stub.gtf"
    gtf_mouse_full = "${projectDir}/test_data/refs/stub.gtf"
    blacklist_bed  = "${projectDir}/test_data/refs/stub_blacklist.bed"

    // RNA uses CellTypist. ATAC has only two annotation paths — scATAnno, or
    // marker_file for super-user marker mode. (ATAC CellTypist-on-gene-activity
    // was removed.) We use scATAnno here because it is the default path, with a
    // placeholder atlas that pre-flight only existence-checks.
    celltypist { enabled = true; model = 'Immune_All_Low.pkl' }
    scatanno   { reference_atlas = "${projectDir}/test_data/refs/stub_atlas.h5ad" }
    atac {
        annotation_method = 'scatanno'
        cisbp_human       = "${projectDir}/test_data/refs/stub.gtf"
        cisbp_mouse       = "${projectDir}/test_data/refs/stub.gtf"
        // REQUIRED whenever atac.run = true. main.nf calls
        // file(params.atac.sample_metadata) unguarded, so a null aborts the run
        // with "Argument of `file()` function cannot be null". Every real dataset
        // config sets this — normally to the same CSV as params.metadata_file.
        sample_metadata   = "${projectDir}/test_data/manifest.csv"
    }

    cicero    { gtf_full = "${projectDir}/test_data/refs/stub.gtf"
                gtf_plot = "${projectDir}/test_data/refs/stub.gtf"
                target_genes = ['STUBG1'] }
    // scprinter.gtf_{human,mouse} must be set EXPLICITLY here. In nextflow.config
    // they are interpolated from params.gtf_*_full at parse time, which happens
    // before this file is merged — so they would resolve to the string 'null' and
    // fail pre-flight. Every real dataset config re-declares them for this reason.
    scprinter { target_genes = ['STUBG1']
                pfms      = "${projectDir}/test_data/refs/stub.gtf"
                genome    = 'hg38'
                gtf_human = "${projectDir}/test_data/refs/stub.gtf"
                gtf_mouse = "${projectDir}/test_data/refs/stub.gtf" }

    pycistopic {
        run           = true
        gtf           = "${projectDir}/test_data/refs/stub.gtf"
        blacklist_bed = "${projectDir}/test_data/refs/stub_blacklist.bed"
        topics        = '10,20'
    }
    scenicplus {
        run               = true
        gtf               = "${projectDir}/test_data/refs/stub.gtf"
        fai               = "${projectDir}/test_data/refs/stub.fa.fai"
        ctx_rankings      = "${projectDir}/test_data/refs/stub.gtf"
        ctx_scores        = "${projectDir}/test_data/refs/stub.gtf"
        motif_annotations = "${projectDir}/test_data/refs/stub.gtf"
    }

    // ---- Turn on the condition-aware branches so their wiring is covered ----
    // The fixture manifest has Control and Treatment rows for exactly this.
    differential {
        run                 = true
        comparisons         = [['Treatment', 'Control']]
        control_condition   = 'Control'
        treatment_condition = 'Treatment'
        cell_types          = []
    }
    // group_mapping is REQUIRED when differential_rna.run = true: main.nf calls
    // file(params.differential_rna.group_mapping) unconditionally, so a null here
    // aborts with "Argument of `file()` function cannot be null".
    differential_rna {
        run           = true
        comparisons   = [['Treatment', 'Control']]
        group_mapping = "${projectDir}/test_data/refs/stub_group_mapping.json"
    }
    hdwgcna {
        condition_key       = 'condition_group'
        control_condition   = 'Control'
        treatment_condition = 'Treatment'
        group_mapping       = "${projectDir}/test_data/refs/stub_group_mapping.json"
    }
    cellchat {
        conditions    = ['Control', 'Treatment']
        group_mapping = "${projectDir}/test_data/refs/stub_group_mapping.json"
    }

    // ---- Exercise the expensive branches' WIRING (stub, so it costs nothing) --
    enhancer_footprinting {
        msfp_enabled        = true
        control_condition   = 'Control'
        treatment_condition = 'Treatment'
    }
    msfp_strip       { enabled = true }
    promoter_overlay { enabled = true }
    browser_viz      { enabled = true }
    cicero_per_ct    { enabled = true }
}
