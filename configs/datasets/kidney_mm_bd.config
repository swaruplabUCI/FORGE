// ============================================================================
// configs/datasets/kidney_mm_bd.config — BD Rhapsody Mouse Kidney Multiome
//
// FORGE instance: fully self-contained in Kidney_Mm_BD_r5/
// Single sample (2,489 cells). RNA Path B (CellTypist direct, no scANVI).
// Species: mouse. Tissue: kidney. Platform: BD Rhapsody.
// No demultiplexing needed.
//
// Usage:
//   nextflow run main.nf -profile cluster,singularity \
//       -c configs/datasets/kidney_mm_bd.config -resume
// ============================================================================

params {
    // =============================
    // RESOURCE TIER
    // =============================
    resource_tier = 'small'

    // =============================
    // SPECIES & DIRECTORIES
    // =============================
    species = 'mouse'

    metadata_file = "${projectDir}/kidney_mm_bd_manifest.csv"
    outdir        = "${projectDir}/results"

    // =============================
    // REFERENCE PATHS
    // =============================
    gtf_human_full = null
    gtf_mouse_full = "/dfs7/swaruplab/lesolano/ref/Gencode_GRCm39/gencode.vM37.annotation.gtf"
    blacklist_bed  = "/dfs7/swaruplab/lesolano/ref/blacklist_ATAC_multispecies/Blacklist/lists/mm10-blacklist.v2.bed.gz"

    // Reference atlas — null triggers Path B (CellTypist direct)
    ref_dir_human_integrated = null
    ref_dir_mouse_integrated = null

    // =============================
    // CELLTYPIST
    // =============================
    celltypist {
        enabled = true
        model   = 'Immune_All_Low.pkl'
    }

    // =============================
    // CELLBENDER
    // =============================
    cellbender {
        total_droplets = 4000
        expected_cells = 2000  // 2,489 barcodes total — must be less than barcode count
        fpr = 0.01
        epochs = 150
        low_count_threshold = 0
    }

    // =============================
    // RNA QC
    // =============================
    min_genes = 100
    min_cells = 3
    mt_threshold = 20     // Kidney has higher MT content than brain

    // =============================
    // DIFFERENTIAL RNA — Disabled (single condition)
    // =============================
    differential_rna {
        run = false
        condition_key = 'condition_group'
        cell_type_key = 'celltypist_prediction'
        group_mapping = null
        comparisons = []
        run_go_enrichment = false
    }

    // =============================
    // INTEGRATION
    // =============================
    n_epochs_scvi = 50
    scanvi_epochs = 50
    n_top_genes = 4000

    mofa {
        run = true
        mode = 'high_memory'
        n_factors = 15
        convergence_mode = 'medium'
        bootstrap { n_iterations = 10; sample_fraction = 0.5 }
    }
    multivi {
        run              = true
        n_epochs         = 200
        batch_key        = 'sample_id'
        modality_weights = 'equal'
        modality_penalty = 'Jeffreys'
        n_latent         = 20
        cell_type_key    = 'celltypist_prediction'
    }

    // =============================
    // ATAC
    // =============================
    atac {
        run = true
        run_initial_qc = true
        min_fragments = 500
        initial_min_counts = 500
        initial_min_tsse = 2
        auto_annotate = true

        min_counts = null
        min_tsse = null
        max_counts = null
        initial_max_counts = 100000
        n_features = 50000
        batch_correction = 'none'
        batch_key = null
        clustering_resolutions = [0.5, 1.0, 2.0]
        peak_fdr = 0.05
        tempdir = null
        annotation_resolution = 'leiden_0_5'

        sample_metadata = "${projectDir}/kidney_mm_bd_manifest.csv"
        annotation_method = 'scatanno'
        tissue_type = 'kidney'
        marker_file = null
    }

    // =============================
    // scATAnno (ATAC reference-based annotation)
    // =============================
    scatanno {
        reference_atlas       = '/dfs7/swaruplab/lesolano/ref/scATAnno_mouse_kidney/mouse_kidney_reference_atlas.h5ad'
        atlas_name            = 'kidney'
        distance_threshold    = 95
        uncertainty_threshold = 0.5
        n_dims                = 30
        knn_neighbors         = 30
    }

    // =============================
    // CICERO
    // =============================
    cicero {
        run = true
        sample_num = 100
        num_dim = 50
        connections_cutoff = 0.25
        ccan_min_coaccess = 0.1
        use_partition = false
        outdir = "${params.outdir}/cicero"
        use_chromvar_targets = true
        target_genes = ['Nphs2', 'Slc12a1', 'Aqp2', 'Lrp2', 'Slc34a1']  // Kidney segment markers
        gtf_full = "/dfs7/swaruplab/lesolano/ref/Gencode_GRCm39/gencode.vM37.annotation.gtf"
        gtf_plot = "/dfs7/swaruplab/lesolano/ref/Gencode_GRCm39/gencode.vM37.annotation.gtf"
    }

    // =============================
    // CELLCHAT
    // =============================
    cellchat {
        run                = true
        cell_type_key      = 'celltypist_prediction'
        condition_key      = 'condition_group'
        conditions         = []
    }

    // =============================
    // hdWGCNA
    // =============================
    hdwgcna {
        run                  = true
        cell_type_key        = 'celltypist_prediction'
        min_cells            = 50
        metadata             = null
        condition_key        = 'none'
        control_condition    = null
        treatment_condition  = null
        traits               = []
    }

    // =============================
    // GRN MODULES
    // =============================
    pycistopic {
        run = true
        species = 'mmusculus'
        blacklist_bed = "/dfs7/swaruplab/lesolano/ref/blacklist_ATAC_multispecies/Blacklist/lists/mm10-blacklist.v2.bed.gz"
        gtf = "/dfs7/swaruplab/lesolano/ref/Gencode_GRCm39/gencode.vM37.annotation.gtf"
    }
    scenicplus {
        run = false  // Disabled: no mouse MGI motif annotations available
        ctx_rankings = "/dfs7/swaruplab/lesolano/ref/scenic_plus_resources/mouse/mm10_region_based.rankings.feather"
        ctx_scores   = "/dfs7/swaruplab/lesolano/ref/scenic_plus_resources/mouse/mm10_region_based.scores.feather"
        motif_annotations = "/dfs7/swaruplab/lesolano/ref/scenic_plus_resources/motifs-v10nr_clust-nr.hgnc-m0.001-o0.0.tbl"
        bc_transform_func = null
        gtf = "/dfs7/swaruplab/lesolano/ref/Gencode_GRCm39/gencode.vM37.annotation.gtf"
        fai = "/dfs7/swaruplab/lesolano/ref/Gencode_GRCm39/GRCm39.primary_assembly.genome.fa.fai"
    }
    dorc { run = true }

    // =============================
    // CHROMVAR / scPRINTER
    // =============================
    chromvar {
        run                = true
        top_n_per_celltype = 5
        min_motif_zscore   = 1.5
        chunk_size         = 30000
    }
    scprinter {
        run                 = true
        target_genes        = []
        gene_coordinates    = null
        cache_dir           = '/dfs7/swaruplab/lesolano/ref/scprinter'
        pfms                = '/dfs7/swaruplab/lesolano/ref/scprinter/JASPAR2022_core_nonredundant.jaspar'
        genome              = 'mm39'
        barcode_dir         = null
        fdr_threshold       = 0.05
        gtf_human           = null
        gtf_mouse           = "/dfs7/swaruplab/lesolano/ref/Gencode_GRCm39/gencode.vM37.annotation.gtf"
        promoter_upstream   = 2000
        promoter_downstream = 500
    }

    // =============================
    // ENHANCER FOOTPRINTING
    // =============================
    enhancer_footprinting {
        run = true
        enhancer_mode = 'ccan'
        percentile_threshold = 95
    }
    enhancer_recipe_c { run = true }
    enhancer_viz {
        run                 = true
        target_genes        = []
        dpi                 = 200
        window_kb           = 100
        coaccess_threshold  = 0.25
    }

    // =============================
    // DIFFERENTIAL ATAC — Disabled
    // =============================
    differential {
        run = false
        condition_key = 'condition_group'
        comparisons = []
        cell_types = []
        control_condition = null
        treatment_condition = null
        min_cells = 50
        fdr_threshold = 0.05
    }
}
