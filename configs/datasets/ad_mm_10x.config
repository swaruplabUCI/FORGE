// ============================================================================
// configs/datasets/ad_mm_10x.config — 10x Multiome Alzheimer's Mouse Model
//
// FORGE instance: fully self-contained in AD_Mm_10X_r5/
// 12 samples (6 TG CRND8 + 6 WT), 2-3 timepoints per genotype, 2 replicates.
// Species: mouse. Tissue: brain. Platform: 10x Chromium (Cell Ranger ARC).
// Differential: WT vs TG enabled.
//
// Usage:
//   nextflow run main.nf -profile cluster,singularity \
//       -c configs/datasets/ad_mm_10x.config -resume
// ============================================================================

params {
    // =============================
    // RESOURCE TIER
    // =============================
    resource_tier = 'medium'

    // =============================
    // SPECIES & DIRECTORIES
    // =============================
    species = 'mouse'

    metadata_file = "${projectDir}/ad_mm_10x_manifest.csv"
    outdir        = "${projectDir}/results"

    // =============================
    // REFERENCE PATHS
    // =============================
    gtf_human_full = null
    gtf_mouse_full = "/dfs7/swaruplab/lesolano/ref/Gencode_GRCm38/gencode.vM10.annotation.gtf"
    blacklist_bed  = "/dfs7/swaruplab/lesolano/ref/blacklist_ATAC_multispecies/Blacklist/lists/mm10-blacklist.v2.bed.gz"

    // Reference atlas — Path A: scVI → scANVI annotation + CellTypist alongside
    ref_dir_human_integrated = null
    ref_dir_mouse_integrated = "/dfs7/swaruplab/lesolano/ref/Allen_mousebrain"

    // =============================
    // CELLTYPIST
    // =============================
    celltypist {
        enabled = true
        model   = 'Developing_Mouse_Brain.pkl'
    }

    // =============================
    // CELLBENDER
    // =============================
    cellbender {
        total_droplets = 25000
        expected_cells = 8000
        fpr = 0.01
        epochs = 150
        low_count_threshold = 0
    }

    // =============================
    // RNA QC
    // =============================
    min_genes = 100
    min_cells = 3
    mt_threshold = 5

    // =============================
    // INTEGRATION
    // =============================
    n_epochs_scvi = 100
    scanvi_epochs = 100
    n_top_genes = 4000

    mofa {
        run = true
        mode = 'high_memory'
        n_factors = 15
        convergence_mode = 'medium'
        bootstrap { n_iterations = 10; sample_fraction = 0.5 }
    }
    multivi {
        run              = true
        n_epochs         = 200
        batch_key        = 'sample_id'
        modality_weights = 'equal'
        modality_penalty = 'Jeffreys'
        n_latent         = 20
        cell_type_key    = 'celltypist_prediction'
    }

    // =============================
    // ATAC
    // =============================
    atac {
        run = true
        run_initial_qc = true
        min_fragments = 1000
        initial_min_counts = 1000
        initial_min_tsse = 2
        auto_annotate = true

        min_counts = null
        min_tsse = null
        max_counts = null
        initial_max_counts = 100000
        n_features = 50000
        batch_correction = 'harmony'
        batch_key = null
        clustering_resolutions = [0.5, 1.0, 2.0]
        peak_fdr = 0.05
        tempdir = null
        annotation_resolution = 'leiden_0_5'

        sample_metadata = "${projectDir}/ad_mm_10x_manifest.csv"
        tissue_type = 'brain'
        marker_file = null
    }

    // =============================
    // CICERO
    // =============================
    cicero {
        run = true
        sample_num = 100
        num_dim = 50
        connections_cutoff = 0.25
        ccan_min_coaccess = 0.1
        use_partition = false
        outdir = "${params.outdir}/cicero"
        use_chromvar_targets = true
        target_genes = ['Trem2', 'Apoe', 'Cd33', 'Spi1', 'Mef2c']
        gtf_full = "/dfs7/swaruplab/lesolano/ref/Gencode_GRCm38/gencode.vM10.annotation.gtf"
        gtf_plot = "/dfs7/swaruplab/lesolano/ref/Gencode_GRCm38/gencode.vM10.annotation.gtf"
    }

    // =============================
    // CELLCHAT
    // =============================
    cellchat {
        run                = true
        cell_type_key      = 'celltypist_prediction'
        condition_key      = 'condition_group'
        conditions         = ['WT', 'TG']
    }

    // =============================
    // hdWGCNA
    // =============================
    hdwgcna {
        run                  = true
        cell_type_key        = 'celltypist_prediction'
        min_cells            = 100
        metadata             = null
        condition_key        = 'condition_group'
        control_condition    = 'WT'
        treatment_condition  = 'TG'
        traits               = []
    }

    // =============================
    // GRN MODULES
    // =============================
    pycistopic {
        run = true
        species = 'mmusculus'
        blacklist_bed = "/dfs7/swaruplab/lesolano/ref/blacklist_ATAC_multispecies/Blacklist/lists/mm10-blacklist.v2.bed.gz"
        gtf = "/dfs7/swaruplab/lesolano/ref/Gencode_GRCm38/gencode.vM10.annotation.gtf"
    }
    scenicplus {
        run = false
        ctx_rankings = "/dfs7/swaruplab/lesolano/ref/scenic_plus_resources/mouse/mm10_region_based.rankings.feather"
        ctx_scores   = "/dfs7/swaruplab/lesolano/ref/scenic_plus_resources/mouse/mm10_region_based.scores.feather"
        motif_annotations = "/dfs7/swaruplab/lesolano/ref/scenic_plus_resources/motifs-v10nr_clust-nr.hgnc-m0.001-o0.0.tbl"
        bc_transform_func = null
        gtf = "/dfs7/swaruplab/lesolano/ref/Gencode_GRCm38/gencode.vM10.annotation.gtf"
        fai = "/dfs7/swaruplab/lesolano/ref/Gencode_GRCm38/GRCm38.primary_assembly.genome.fa.fai"
    }
    dorc { run = true }

    // =============================
    // CHROMVAR / scPRINTER
    // =============================
    chromvar {
        run                = true
        top_n_per_celltype = 5
        min_motif_zscore   = 1.5
        chunk_size         = 30000
    }
    scprinter {
        run                 = true
        target_genes        = []
        gene_coordinates    = null
        cache_dir           = '/dfs7/swaruplab/lesolano/ref/scprinter'
        pfms                = '/dfs7/swaruplab/lesolano/ref/scprinter/JASPAR2022_core_nonredundant.jaspar'
        genome              = 'mm10'
        barcode_dir         = null
        fdr_threshold       = 0.05
        gtf_human           = null
        gtf_mouse           = "/dfs7/swaruplab/lesolano/ref/Gencode_GRCm38/gencode.vM10.annotation.gtf"
        promoter_upstream   = 2000
        promoter_downstream = 500
    }

    // =============================
    // ENHANCER FOOTPRINTING
    // =============================
    enhancer_footprinting {
        run = true
        enhancer_mode = 'ccan'
        percentile_threshold = 95
    }
    enhancer_recipe_c { run = true }
    enhancer_viz {
        run                 = true
        target_genes        = []
        dpi                 = 200
        window_kb           = 100
        coaccess_threshold  = 0.25
    }

    // =============================
    // DIFFERENTIAL ATAC — Enabled (WT vs TG)
    // =============================
    differential {
        run = true
        condition_key = 'condition_group'
        comparisons = [['TG', 'WT']]
        cell_types = []
        control_condition = 'WT'
        treatment_condition = 'TG'
        min_cells = 50
        fdr_threshold = 0.05
    }

    // =============================
    // DIFFERENTIAL RNA — Enabled (WT vs TG)
    // =============================
    differential_rna {
        run = true
        condition_key = 'condition_group'
        cell_type_key = 'celltypist_prediction'
        group_mapping = "${projectDir}/data/group_mapping.json"
        comparisons = [['TG', 'WT']]
        run_go_enrichment = true
    }
}
