// ============================================================================
// configs/datasets/example_template.config — Dataset Configuration Template
//
// Copy this file and fill in values for your dataset.
// Only override params that differ from the defaults in nextflow.config.
//
// Usage:
//   cp configs/datasets/example_template.config configs/datasets/my_dataset.config
//   # Edit my_dataset.config with your paths and parameters
//   nextflow run main.nf -profile cluster,singularity \
//       -c configs/datasets/my_dataset.config -resume
// ============================================================================

params {
    // =============================
    // RESOURCE TIER (required)
    // =============================
    // 'small' — single sample, <20k cells (e.g. PBMC 10k)
    // 'large' — multi-batch, 100k+ cells (e.g. BD 90+ brain)
    resource_tier = 'small'

    // =============================
    // SPECIES (required)
    // =============================
    // 'human' or 'mouse'
    species = 'human'

    // =============================
    // MANIFEST & OUTPUT (required)
    // =============================
    // Path to sample manifest CSV with columns: sample_id, data_dir, etc.
    metadata_file = null    // e.g. "${projectDir}/datasets/my_data/manifest.csv"

    // Output directory for all results
    outdir = 'results'

    // =============================
    // REFERENCE PATHS (required)
    // =============================
    // Directory containing shared reference files
    ref_dir = "${projectDir}/references"

    // GTF annotation files (species-appropriate)
    gtf_human_full = null   // e.g. "/path/to/gencode.v38.annotation.gtf"
    gtf_mouse_full = null   // e.g. "/path/to/gencode.vM10.annotation.gtf"

    // ATAC blacklist regions BED file
    blacklist_bed = null     // e.g. "/path/to/hg38-blacklist.v2.bed.gz"

    // =============================
    // RNA PATH SELECTION
    // =============================
    // Path A (scANVI + CellTypist): Set ref_dir_human_integrated to a reference atlas dir
    // Path B (CellTypist only):     Leave as null
    ref_dir_human_integrated = null  // e.g. "/path/to/SEA_AD" for brain Path A
    ref_dir_mouse_integrated = null

    // =============================
    // CELLTYPIST MODEL
    // =============================
    // Choose the model closest to your tissue:
    //   Brain:   Pan_Fetal_Human.pkl (human) or Developing_Mouse_Brain.pkl (mouse)
    //   Immune:  Immune_All_Low.pkl / Immune_All_High.pkl
    //   PBMC:    Healthy_COVID19_PBMC.pkl
    //   Lung:    Human_Lung_Atlas.pkl
    //   Gut:     Cells_Intestinal_Tract.pkl
    celltypist {
        enabled = true
        model   = 'Immune_All_Low.pkl'
    }

    // =============================
    // CELLBENDER — Ambient RNA removal
    // =============================
    // Adjust total_droplets and expected_cells for your dataset
    cellbender {
        total_droplets = 20000    // Total droplets including empty
        expected_cells = 5000     // Expected number of real cells
        fpr = 0.01
        epochs = 150
        low_count_threshold = 0
    }

    // =============================
    // RNA QC THRESHOLDS
    // =============================
    // Tissue-dependent:
    //   PBMCs: min_genes=200, mt_threshold=20
    //   Brain: min_genes=100, mt_threshold=10
    min_genes = 200
    min_cells = 3
    mt_threshold = 20

    // =============================
    // INTEGRATION PARAMETERS
    // =============================
    // Scale with dataset size:
    //   Small (10k cells):  n_epochs_scvi=50,  n_top_genes=4000
    //   Large (100k+ cells): n_epochs_scvi=100, n_top_genes=12000
    n_epochs_scvi = 50
    scanvi_epochs = 50
    n_top_genes = 4000

    // =============================
    // BATCH DIRECTORY MAPS (multi-batch only)
    // =============================
    // For multi-batch experiments, populate these maps.
    // Keys are batch names, values are directory paths.
    // Leave as empty maps [:] for single-sample experiments.
    //
    // batch_dirs = [
    //     batch1: "/path/to/batch1/output",
    //     batch2: "/path/to/batch2/output",
    // ]
    //
    // demux_metadata = [
    //     batch1: "/path/to/batch1/metadata.csv",
    // ]
    //
    // demux_souporcell_dirs = [
    //     batch2: "/path/to/batch2/souporcell_output",
    // ]
    //
    // atac_fragment_dirs_bc = [
    //     batch1: "/path/to/batch1/fragments_bc_sorted",
    // ]
    //
    // atac_fragment_dirs_coord = [
    //     batch1: "/path/to/batch1/fragments_coord_sorted",
    // ]

    // =============================
    // ATAC PARAMETERS
    // =============================
    atac {
        run = true
        run_initial_qc = true
        min_fragments = 1000
        initial_min_counts = 1000
        initial_min_tsse = 5         // Lower for brain (1), higher for PBMC (5)
        auto_annotate = true

        initial_max_counts = 100000
        n_features = 50000
        batch_correction = 'none'    // 'mnn' for multi-batch, 'none' for single-sample
        annotation_resolution = 'leiden_0_5'

        sample_metadata = null       // Usually same as params.metadata_file
        tissue_type = 'pbmc'         // 'brain' or 'pbmc' — controls marker genes
        marker_file = null           // Custom marker file, or null for built-in
    }

    // =============================
    // CICERO — Co-accessibility
    // =============================
    cicero {
        run = true
        use_chromvar_targets = true
        // Fallback target genes when use_chromvar_targets = false
        // Use tissue-relevant genes:
        //   PBMC:  ['IL7R', 'CD8A', 'MS4A1', 'CD14', 'FCGR3A']
        //   Brain: ['TREM2', 'APOE', 'CD33', 'SPI1', 'MEF2C']
        target_genes = []
        gtf_full = null              // Same as gtf_human_full
        gtf_plot = null              // Same as gtf_human_full
    }

    // =============================
    // CELLCHAT
    // =============================
    // cell_type_key: 'celltypist_prediction' (Path B) or 'scanvi_prediction' (Path A)
    cellchat {
        run                = true
        cell_type_key      = 'celltypist_prediction'
        condition_key      = 'condition_group'
        conditions         = []      // Empty = global-only; non-empty = also comparative
    }

    // =============================
    // hdWGCNA
    // =============================
    hdwgcna {
        run                  = true
        cell_type_key        = 'celltypist_prediction'
        min_cells            = 100
        condition_key        = 'none'    // Set to enable differential
        control_condition    = null
        treatment_condition  = null
        traits               = []
    }

    // =============================
    // MOFA / MultiVI
    // =============================
    mofa {
        run = true
        mode = 'high_memory'
        n_factors = 15               // 15 for small, 30 for large
        convergence_mode = 'medium'
    }
    multivi {
        run              = true
        n_epochs         = 200
        batch_key        = 'sample_id'
        cell_type_key    = 'celltypist_prediction'
    }

    // =============================
    // GRN MODULES
    // =============================
    pycistopic {
        run = true
        species = 'hsapiens'         // 'hsapiens' or 'mmusculus'
        blacklist_bed = null
        gtf = null
    }
    scenicplus {
        run = true
        ctx_rankings = null          // Path to rankings feather file
        ctx_scores   = null          // Path to scores feather file
        motif_annotations = null     // Path to motif annotations .tbl file
        bc_transform_func = null     // Barcode transformation lambda
        gtf = null
        fai = null
    }

    // =============================
    // CHROMVAR / scPRINTER
    // =============================
    chromvar {
        run = true
        chunk_size = 30000
    }
    scprinter {
        run                 = true
        target_genes        = []     // Empty = discovery mode
        cache_dir           = null   // Path to pre-downloaded scPRINTER models
        pfms                = null   // Path to JASPAR PFMs file
        genome              = 'hg38' // 'hg38' or 'mm10'
    }

    // =============================
    // DIFFERENTIAL ATAC
    // =============================
    differential {
        run = false
        condition_key = 'condition_group'
        comparisons = []             // e.g. [['Treatment', 'Control']]
        control_condition = null
        treatment_condition = null
    }

    // =============================
    // ON-RAMP: RESUME FROM CHECKPOINT
    // =============================
    // Set any of these to skip upstream steps:
    //
    // onramp {
    //     rna_integrated_h5ad    = "/path/to/integrated.h5ad"
    //     atac_peak_matrix_h5ad  = "/path/to/peaks.h5ad"
    //     mudata_h5mu            = "/path/to/mudata.h5mu"
    //     cistopic_obj_pkl       = "/path/to/cistopic.pkl"
    //     printer_h5ad           = "/path/to/printer.h5ad"
    //     seurat_rds             = "/path/to/seurat.rds"
    //     cicero_connections     = "/path/to/connections.tsv"
    //     chromvar_deviations    = "/path/to/deviations.h5ad"
    // }
}
