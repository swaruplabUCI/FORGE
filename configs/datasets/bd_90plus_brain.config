// ============================================================================
// configs/datasets/bd_90plus_brain.config — BD Rhapsody 90+ Brain Multiome
//
// 100+ aged human brain samples across 3 batches (june/july/nov).
// RNA Path A (scANVI + CellTypist) with SEA-AD reference atlas.
// Tissue: brain. Demultiplexing via Souporcell / SMK metadata.
//
// Usage:
//   nextflow run main.nf -profile cluster,singularity \
//       -c configs/datasets/bd_90plus_brain.config -resume
// ============================================================================

params {
    // =============================
    // RESOURCE TIER
    // =============================
    resource_tier = 'large'

    // =============================
    // SPECIES & DIRECTORIES
    // =============================
    species = 'human'

    metadata_file = "${projectDir}/datasets/bd_90plus/bd_manifest_v4.csv"
    outdir        = "results_bd_full"

    // =============================
    // BATCH DIRECTORY MAPS
    // =============================
    batch_dirs = [
        june: "/dfs7/swaruplab/shared_lab/Collaborations/Nora_90plus/Nora_90plus_BD_multiome_Jun2025/Outputs",
        july: "/dfs7/swaruplab/shared_lab/Collaborations/Nora_90plus/Nora_90plus_BD_multiome_Jul2025/Output",
        nov:  "/dfs7/swaruplab/shared_lab/Collaborations/Nora_90plus/Nora_90plus_Nov2025/SevenBridges_Output",
    ]

    demux_metadata = [
        june: "/dfs7/swaruplab/lesolano/multiome_90p/june_merged_metadata.csv",
    ]

    demux_souporcell_dirs = [
        july: "/dfs7/swaruplab/shared_lab/Collaborations/Nora_90plus/Nora_90plus_BD_multiome_Jul2025/LS_Output/Souporcell_Output",
        nov:  "/dfs7/swaruplab/lesolano/multiome_90p/nov_souporcell_output",
    ]

    atac_fragment_dirs_bc = [
        june: "/dfs7/swaruplab/lesolano/multiome_90p/sorted_fragments_bc_demux_june",
        july: "/dfs7/swaruplab/lesolano/multiome_90p/sorted_fragments_bc_demux",
        nov:  "/dfs7/swaruplab/lesolano/multiome_90p/sorted_fragments_bc_demux_nov",
    ]

    atac_fragment_dirs_coord = [
        june: "/dfs7/swaruplab/lesolano/multiome_90p/sorted_fragments_coord_demux_june",
        july: "/dfs7/swaruplab/lesolano/multiome_90p/sorted_fragments_coord_demux",
        nov:  "/dfs7/swaruplab/lesolano/multiome_90p/sorted_fragments_coord_demux_nov",
    ]

    // =============================
    // REFERENCE PATHS
    // =============================
    ref_dir = "${projectDir}/references"

    gtf_human_full = "/dfs7/swaruplab/lesolano/ref/Gencode_GRCh38/gencode.v38.annotation.gtf"
    gtf_mouse_full = "${ref_dir}/gencode.vM10.annotation.gtf"
    blacklist_bed  = "/dfs7/swaruplab/lesolano/ref/blacklist_ATAC_multispecies/Blacklist/lists/hg38-blacklist.v2.bed.gz"

    // Reference atlas — triggers Path A (scANVI + CellTypist)
    ref_dir_human_integrated = "/dfs7/swaruplab/lesolano/ref/SEA_AD"
    ref_dir_mouse_integrated = null

    // =============================
    // CELLTYPIST
    // =============================
    celltypist {
        enabled = true
        model   = 'Pan_Fetal_Human.pkl'
    }

    // =============================
    // CELLBENDER
    // =============================
    cellbender {
        total_droplets = 25000
        expected_cells = 5000
        fpr = 0.01
        epochs = 150
        low_count_threshold = 0
    }

    // =============================
    // RNA QC — Brain-specific thresholds
    // =============================
    min_genes = 100
    min_cells = 3
    mt_threshold = 10    // Brain nuclei have lower MT% tolerance

    // =============================
    // DIFFERENTIAL RNA
    // =============================
    differential_rna {
        run = false    // Enable once group mappings are defined
        condition_key = 'condition_group'
        cell_type_key = 'scanvi_prediction'
        group_mapping = "${projectDir}/configs/test_group_mapping.json"
        comparisons = [
            ['Group4', 'Group1']
        ]
        run_go_enrichment = true
        pval_cutoff = 0.05
        log2fc_cutoff = 0.25
    }

    // =============================
    // INTEGRATION — BD scale
    // =============================
    n_epochs_scvi = 100
    scanvi_epochs = 100
    n_top_genes = 12000

    mofa {
        run = true
        mode = 'high_memory'
        n_factors = 30
        convergence_mode = 'medium'
        bootstrap { n_iterations = 10; sample_fraction = 0.5 }
    }
    multivi {
        run              = true
        n_epochs         = 200
        batch_key        = 'sample'
        modality_weights = 'equal'
        modality_penalty = 'Jeffreys'
        n_latent         = 20
        cell_type_key    = 'scanvi_prediction'
        run_imputation   = true
        run_differential = false
    }

    // =============================
    // ATAC — Brain-specific thresholds
    // =============================
    atac {
        run = true
        run_initial_qc = true
        min_fragments = 1000
        initial_min_counts = 5000
        initial_min_tsse = 1    // FIX-28: Lowered for AD brain tissue
        auto_annotate = true

        min_counts = null
        min_tsse = null
        max_counts = null
        initial_max_counts = 100000
        n_features = 50000
        batch_correction = 'mnn'
        batch_key = null
        clustering_resolutions = [0.5, 1.0, 2.0]
        peak_fdr = 0.05
        tempdir = null
        annotation_resolution = 'leiden_0_5'

        // BD demux fragment directories (per batch)
        demux_bc_dir_june = "/dfs7/swaruplab/lesolano/multiome_90p/sorted_fragments_bc_demux_june"
        demux_bc_dir_july = "/dfs7/swaruplab/lesolano/multiome_90p/sorted_fragments_bc_demux"
        demux_bc_dir_nov  = "/dfs7/swaruplab/lesolano/multiome_90p/sorted_fragments_bc_demux_nov"
        demux_coord_dir_june = "/dfs7/swaruplab/lesolano/multiome_90p/sorted_fragments_coord_demux_june"
        demux_coord_dir_july = "/dfs7/swaruplab/lesolano/multiome_90p/sorted_fragments_coord_demux"
        demux_coord_dir_nov  = "/dfs7/swaruplab/lesolano/multiome_90p/sorted_fragments_coord_demux_nov"

        sample_metadata = "${projectDir}/datasets/bd_90plus/bd_manifest_v4.csv"
        tissue_type = 'brain'
        marker_file = null
    }

    // =============================
    // CICERO — BD-scale
    // =============================
    cicero {
        run = true
        sample_num = 100
        num_dim = 50
        connections_cutoff = 0.25
        ccan_min_coaccess = 0.1
        use_partition = false
        outdir = "${params.outdir}/cicero"
        use_chromvar_targets = true
        target_genes = ['TREM2', 'APOE', 'CD33', 'SPI1', 'MEF2C']
        gtf_full = "/dfs7/swaruplab/lesolano/ref/Gencode_GRCh38/gencode.v38.annotation.gtf"
        gtf_plot = "/dfs7/swaruplab/lesolano/ref/Gencode_GRCh38/gencode.v38.annotation.gtf"
    }

    // =============================
    // CELLCHAT — uses scANVI predictions
    // =============================
    cellchat {
        run                = true
        cell_type_key      = 'scanvi_prediction'
        condition_key      = 'condition_group'
        conditions         = []    // Empty = global-only; set to ['Control', '90plus'] for comparative
    }

    // =============================
    // hdWGCNA — uses scANVI predictions
    // =============================
    hdwgcna {
        run                  = true
        cell_type_key        = 'scanvi_prediction'
        min_cells            = 100
        metadata             = null
        condition_key        = 'none'    // Set to 'condition_group' to enable differential
        control_condition    = null
        treatment_condition  = null
        traits               = []
    }

    // =============================
    // GRN MODULES
    // =============================
    pycistopic {
        run = true
        species = 'hsapiens'
        blacklist_bed = "/dfs7/swaruplab/lesolano/ref/blacklist_ATAC_multispecies/Blacklist/lists/hg38-blacklist.v2.bed.gz"
        gtf = "/dfs7/swaruplab/lesolano/ref/Gencode_GRCh38/gencode.v38.annotation.gtf"
    }
    scenicplus {
        run = true
        ctx_rankings = "/dfs7/swaruplab/lesolano/ref/scenic_plus_resources/human/hg38_region_based.rankings.feather"
        ctx_scores   = "/dfs7/swaruplab/lesolano/ref/scenic_plus_resources/human/hg38_region_based.scores.feather"
        motif_annotations = "/dfs7/swaruplab/lesolano/ref/scenic_plus_resources/motifs-v10nr_clust-nr.hgnc-m0.001-o0.0.tbl"
        bc_transform_func = "lambda x: f'{x}-10x_multiome_brain'"
        gtf = "/dfs7/swaruplab/lesolano/ref/Gencode_GRCh38/gencode.v38.annotation.gtf"
        fai = "/dfs7/swaruplab/lesolano/ref/Gencode_GRCh38/GRCh38_FaGFF3/hg38.fa.fai"
    }
    dorc { run = false }

    // =============================
    // CHROMVAR / scPRINTER
    // =============================
    chromvar {
        run                = true
        top_n_per_celltype = 5
        min_motif_zscore   = 1.5
        chunk_size         = 30000
    }
    scprinter {
        run                 = true
        target_genes        = []
        gene_coordinates    = null
        cache_dir           = '/dfs7/swaruplab/lesolano/ref/scprinter'
        pfms                = '/dfs7/swaruplab/lesolano/ref/scprinter/JASPAR2022_core_nonredundant.jaspar'
        genome              = 'hg38'
        barcode_dir         = null
        fdr_threshold       = 0.05
        gtf_human           = "${params.gtf_human_full}"
        gtf_mouse           = "${params.gtf_mouse_full}"
        promoter_upstream   = 2000
        promoter_downstream = 500
    }

    // =============================
    // DIFFERENTIAL ATAC
    // =============================
    differential {
        run = false    // Enable once condition groups are defined
        condition_key = 'condition_group'
        comparisons = [['90plus', 'Control']]
        cell_types = []
        control_condition = 'Control'
        treatment_condition = '90plus'
        min_cells = 50
        fdr_threshold = 0.05
    }
}
