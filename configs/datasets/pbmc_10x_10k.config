// ============================================================================
// configs/datasets/pbmc_10x_10k.config — 10x Genomics 10k Human PBMC Multiome
//
// Single 10k-cell sample. RNA Path B (CellTypist direct, no scANVI).
// Tissue: PBMC. No demultiplexing needed.
//
// Usage:
//   nextflow run main.nf -profile cluster,singularity \
//       -c configs/datasets/pbmc_10x_10k.config -resume
// ============================================================================

params {
    // =============================
    // RESOURCE TIER
    // =============================
    resource_tier = 'small'

    // =============================
    // SPECIES & DIRECTORIES
    // =============================
    species = 'human'

    metadata_file = "${projectDir}/datasets/pbmc_10x/10k_pbmc_manifest.csv"
    outdir        = "${projectDir}/results_10x_pbmc"

    // =============================
    // REFERENCE PATHS
    // =============================
    ref_dir = "/dfs7/swaruplab/lesolano/nf_refactor4/references"

    gtf_human_full = "/dfs7/swaruplab/lesolano/ref/Gencode_GRCh38/gencode.v38.annotation.gtf"
    gtf_mouse_full = "${ref_dir}/gencode.vM10.annotation.gtf"
    blacklist_bed  = "/dfs7/swaruplab/lesolano/ref/blacklist_ATAC_multispecies/Blacklist/lists/hg38-blacklist.v2.bed.gz"

    // Reference atlas — null triggers Path B (CellTypist direct)
    ref_dir_human_integrated = null
    ref_dir_mouse_integrated = null

    // =============================
    // CELLTYPIST
    // =============================
    celltypist {
        enabled = true
        model   = 'Immune_All_Low.pkl'
    }

    // =============================
    // CELLBENDER
    // =============================
    cellbender {
        total_droplets = 20000
        expected_cells = 10000
        fpr = 0.01
        epochs = 150
        low_count_threshold = 0
    }

    // =============================
    // RNA QC
    // =============================
    min_genes = 200
    min_cells = 3
    mt_threshold = 20    // PBMCs tolerate higher MT% than brain nuclei

    // =============================
    // DIFFERENTIAL RNA — Disabled (single condition)
    // =============================
    differential_rna {
        run = false
        condition_key = 'condition_group'
        cell_type_key = 'celltypist_prediction'
        group_mapping = "/dfs7/swaruplab/lesolano/nf_refactor4/configs/test_group_mapping.json"
        comparisons = []
        run_go_enrichment = false
    }

    // =============================
    // INTEGRATION
    // =============================
    n_epochs_scvi = 50
    scanvi_epochs = 50
    n_top_genes = 4000

    mofa {
        run = true
        mode = 'high_memory'
        n_factors = 15
        convergence_mode = 'medium'
        bootstrap { n_iterations = 10; sample_fraction = 0.5 }
    }
    multivi {
        run              = true
        n_epochs         = 200
        batch_key        = 'sample_id'
        modality_weights = 'equal'
        modality_penalty = 'Jeffreys'
        n_latent         = 20
        cell_type_key    = 'celltypist_prediction'
    }

    // =============================
    // ATAC
    // =============================
    atac {
        run = true
        run_initial_qc = true
        min_fragments = 1000
        initial_min_counts = 1000
        initial_min_tsse = 5
        auto_annotate = true

        min_counts = null
        min_tsse = null
        max_counts = null
        initial_max_counts = 100000
        n_features = 50000
        batch_correction = 'none'
        batch_key = null
        clustering_resolutions = [0.5, 1.0, 2.0]
        peak_fdr = 0.05
        tempdir = null
        annotation_resolution = 'leiden_0_5'

        sample_metadata = "${projectDir}/datasets/pbmc_10x/10k_pbmc_manifest.csv"
        tissue_type = 'pbmc'
        marker_file = null
    }

    // =============================
    // CICERO
    // =============================
    cicero {
        run = true
        sample_num = 100
        num_dim = 50
        connections_cutoff = 0.25
        ccan_min_coaccess = 0.1
        use_partition = false
        outdir = "${params.outdir}/cicero"
        use_chromvar_targets = true
        target_genes = ['IL7R', 'CD8A', 'MS4A1', 'CD14', 'FCGR3A']
        gtf_full = "/dfs7/swaruplab/lesolano/ref/Gencode_GRCh38/gencode.v38.annotation.gtf"
        gtf_plot = "/dfs7/swaruplab/lesolano/ref/Gencode_GRCh38/gencode.v38.annotation.gtf"
    }

    // =============================
    // CELLCHAT — Global only
    // =============================
    cellchat {
        run                = true
        cell_type_key      = 'celltypist_prediction'
        condition_key      = 'condition_group'
        conditions         = []
    }

    // =============================
    // hdWGCNA — Global only
    // =============================
    hdwgcna {
        run                  = true
        cell_type_key        = 'celltypist_prediction'
        min_cells            = 100
        metadata             = null
        condition_key        = 'none'
        control_condition    = null
        treatment_condition  = null
        traits               = []
    }

    // =============================
    // GRN MODULES
    // =============================
    pycistopic {
        run = true
        species = 'hsapiens'
        blacklist_bed = "/dfs7/swaruplab/lesolano/ref/blacklist_ATAC_multispecies/Blacklist/lists/hg38-blacklist.v2.bed.gz"
        gtf = "/dfs7/swaruplab/lesolano/ref/Gencode_GRCh38/gencode.v38.annotation.gtf"
    }
    scenicplus {
        run = true
        ctx_rankings = "/dfs7/swaruplab/lesolano/ref/scenic_plus_resources/human/hg38_screen_v10_clust.regions_vs_motifs.rankings.feather"
        ctx_scores   = "/dfs7/swaruplab/lesolano/ref/scenic_plus_resources/human/hg38_screen_v10_clust.regions_vs_motifs.scores.feather"
        motif_annotations = "/dfs7/swaruplab/lesolano/ref/scenic_plus_resources/motifs-v10nr_clust-nr.hgnc-m0.001-o0.0.tbl"
        bc_transform_func = "lambda x: x.split(':')[1] + '-' + x.split(':')[0]"
        gtf = "/dfs7/swaruplab/lesolano/ref/Gencode_GRCh38/gencode.v38.annotation.gtf"
        fai = "/dfs7/swaruplab/lesolano/ref/Gencode_GRCh38/GRCh38_FaGFF3/hg38.fa.fai"
    }
    dorc { run = true }

    // =============================
    // CHROMVAR / scPRINTER
    // =============================
    chromvar {
        run                = true
        top_n_per_celltype = 5
        min_motif_zscore   = 1.5
        chunk_size         = 30000
    }
    scprinter {
        run                 = true
        target_genes        = []
        gene_coordinates    = null
        cache_dir           = '/dfs7/swaruplab/lesolano/ref/scprinter'
        pfms                = '/dfs7/swaruplab/lesolano/ref/scprinter/JASPAR2022_core_nonredundant.jaspar'
        genome              = 'hg38'
        barcode_dir         = null
        fdr_threshold       = 0.05
        gtf_human           = "${params.gtf_human_full}"
        gtf_mouse           = "${params.gtf_mouse_full}"
        promoter_upstream   = 2000
        promoter_downstream = 500
    }

    // =============================
    // DIFFERENTIAL ATAC — Disabled
    // =============================
    differential {
        run = false
        condition_key = 'condition_group'
        comparisons = []
        cell_types = []
        control_condition = null
        treatment_condition = null
        min_cells = 50
        fdr_threshold = 0.05
    }
}
