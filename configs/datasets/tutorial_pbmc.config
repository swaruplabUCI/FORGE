// ============================================================================
// configs/datasets/tutorial_pbmc.config — tier-2 tutorial dataset
//
//   nextflow run main.nf -profile tutorial,singularity \
//       -c configs/datasets/tutorial_pbmc.config -resume
//
// USE -profile tutorial. The `resource_tier = 'tutorial'` line below is NOT what
// selects the tier: the includeConfig chain at the bottom of nextflow.config is
// evaluated while that file is parsed, which is BEFORE any -c file merges. A
// profile is evaluated in time, so it works. Without the profile you silently get
// the 'small' tier — with its 200 GB asks and GPU clusterOptions.
//
// A ~1,000-cell subset of the public 10x Genomics 10k PBMC multiome sample, with
// ATAC restricted to chr21+chr22. Runs CPU-only on a workstation in minutes to
// about an hour — the point is to prove FORGE produces real output without a
// cluster, a GPU, or 600 GB of references.
//
// This is the SAME dataset as the full PBMC example, differing only in scale, so
// it exercises the real pipeline rather than a separate toy path.
//
// ---------------------------------------------------------------------------
// SCOPE — what this deliberately does NOT run, and why
//   ChromVAR      bin/gpu_chromvar_nf.py imports cupy/rmm at module scope: a hard
//                 GPU dependency with no CPU fallback.
//   SCENIC+       cisTarget databases cannot be meaningfully subset to 2 chroms.
//   pycisTopic    required by SCENIC+; nothing else here needs it.
//   footprinting  ENHANCER_FOOTPRINTING_PER_CT was 54% of ALL compute across the
//                 four published datasets.
// All four are demonstrated instead via params.onramp with precomputed outputs —
// the same mechanism FORGE uses in production. See docs/onramps.md.
//
// ---------------------------------------------------------------------------
// CAVEAT to state plainly in any write-up: restricting ATAC to chr21+chr22 means
// TSS enrichment, peak counts and QC distributions are computed from ~2.6% of the
// genome. They will NOT resemble a real run. This dataset demonstrates that the
// pipeline works, not what good data looks like.
// ============================================================================

params {

    // Where the tutorial dataset lives. Defaults to <repo>/tutorial_data, which
    // is where the release tarball is meant to be extracted:
    //
    //   tar -xzf forge_tutorial_pbmc_v1.tar.gz -C tutorial_data/
    //
    // tutorial_data/ is gitignored — at ~79 MB it is too large for git (unlike the
    // 7 KB test_data/ fixture, which IS committed). Override on the command line
    // if you keep it elsewhere:  --tutorial_data /path/to/data
    tutorial_data = "${projectDir}/tutorial_data"

    species       = 'human'
    metadata_file = "${params.tutorial_data}/manifest.csv"

    // The manifest's data_dir column is intentionally BLANK so the dataset can be
    // extracted anywhere. FORGE then resolves each row's directory from
    // batch_dirs[batch]; the manifest's batch is 'tutorial'.
    batch_dirs           = [tutorial: "${params.tutorial_data}/samples"]
    atac_batch_dirs      = [tutorial: "${params.tutorial_data}/samples"]
    atac_coord_batch_dirs = [tutorial: "${params.tutorial_data}/samples"]
    outdir        = 'results_tutorial'
    resource_tier = 'tutorial'          // configs/resource_tiers/tutorial.config

    // ---- Device -------------------------------------------------------------
    // Explicit rather than inferred. Verified 2026-08-06: scVI, scANVI, MultiVI
    // and MOFA+ all train on CPU (scvi-tools 1.4.2). See dev_notes/phase3/.
    scvi_accelerator = 'cpu'

    // ---- References (all ship with the dataset; nothing to download) --------
    gtf_human_full = "${params.tutorial_data}/refs/gencode_chr21_22.gtf"
    blacklist_bed  = "${params.tutorial_data}/refs/blacklist_chr21_22.bed"

    // ---- Ambient RNA --------------------------------------------------------
    // The subset holds 1,000 cells + 19,000 ambient droplets on purpose:
    // CellBender needs the background distribution to estimate contamination.
    cellbender {
        expected_cells = 1000
        // MUST be strictly less than the 20,000 barcodes in the subset.
        // CellBender indexes reverse_sorted_counts[total_droplets] when it
        // computes its priors, so total_droplets == n_barcodes dies with
        // "IndexError: index 20000 is out of bounds for axis 0 with size 20000".
        // Barcodes ranked 15,001-20,000 become its "surely empty" set.
        // Real 10x raw matrices carry ~730k barcodes, which is why the stock
        // 20,000 default is fine everywhere except a subset this small.
        total_droplets = 15000
        epochs         = 50           // reduced from 150; tiny input
    }

    // ---- RNA ----------------------------------------------------------------
    rna { run = true; annotation_method = 'celltypist' }
    celltypist { enabled = true; model = 'Immune_All_Low.pkl' }

    n_epochs_scvi = 20                // reduced from 50 for runtime
    scanvi_epochs = 20

    // ---- ATAC ---------------------------------------------------------------
    // marker_file avoids the 2.76 GB scATAnno atlas entirely. ATAC has only two
    // annotation paths — scatanno (atlas) or marker_file. There is NO ATAC
    // CellTypist mode; params.celltypist above governs RNA only.
    atac {
        run               = true
        marker_file       = "${projectDir}/configs/marker_genes.json"
        tissue_type       = 'pbmc'
        // REQUIRED whenever atac.run = true: main.nf calls file() on this
        // unguarded, so null aborts with "Argument of `file()` cannot be null".
        sample_metadata   = "${params.tutorial_data}/manifest.csv"
        run_mode          = 'broad'
        // Only two chromosomes of peaks exist, so relax the feature ceiling.
        n_features        = 20000

        // ---- ATAC QC thresholds: MUST be set explicitly for this subset ----
        // Fragments here come from chr21+chr22 only (~2.6% of hg38), so per-cell
        // fragment counts are ~40x lower than a whole-genome run. Measured over
        // the 1,000 tutorial cells:
        //     min 202 | p05 477 | p25 930 | median 1,389 | p90 2,969 | max 44,730
        //
        // Leaving these null is NOT a safe default here. modules/atac/atac_initial_qc.nf
        // only emits --min_counts when params.atac.min_counts is truthy, so a null
        // falls through to atac_initial_qc.py's own argparse default of 5000 —
        // which retained 47 of 1,000 cells and collapsed the whole ATAC arm
        // (CICERO_ESTIMATE_DP then died in make_cicero_cds with
        // "Requesting more near neighbors than data points" on 41 cells).
        // Note atac.initial_min_counts does NOT act as a fallback for this
        // process the way initial_min_tsse does for min_tsse.
        //
        // Setting them explicitly also bypasses the downstream auto-threshold
        // path, which derived min_counts = 5118 from fragments_q05 of the
        // already-filtered 47 cells — circular, and it re-imposed the same cut.
        min_counts        = 500       // retains 943 / 1,000 cells
        max_counts        = 100000    // above the observed max of 44,730
        min_tsse          = 2.0       // permissive; TSSe is noisy at this depth
        min_fragments     = 200       // matches the subset's selection floor
    }

    // ---- Regulatory ---------------------------------------------------------
    chromvar { run = false }          // hard cupy/GPU dependency

    cicero {
        run = true
        // MUST be false: defaults true, which would demand ChromVAR output.
        use_chromvar_targets = false
        target_genes = []             // discovered rather than configured
        gtf_full = "${params.tutorial_data}/refs/gencode_chr21_22.gtf"
        gtf_plot = "${params.tutorial_data}/refs/gencode_chr21_22.gtf"
    }
    cicero_per_ct { enabled = false }

    // scprinter.gtf_* must be set EXPLICITLY here. In nextflow.config they are
    // interpolated from params.gtf_*_full at parse time, before this file merges,
    // so they would resolve to the string 'null' and fail pre-flight.
    scprinter {
        run       = false
        gtf_human = "${params.tutorial_data}/refs/gencode_chr21_22.gtf"
        gtf_mouse = "${params.tutorial_data}/refs/gencode_chr21_22.gtf"
    }

    pycistopic { run = false }
    scenicplus { run = false }
    dorc       { run = false }

    enhancer_footprinting { run = false; msfp_enabled = false }
    msfp_strip       { enabled = false }
    promoter_overlay { enabled = false }
    cis_rewiring     { enabled = false }
    browser_viz      { enabled = false }
    shi_figures      { enabled = false }
    enhancer_viz     { run = false }

    // ---- Integration --------------------------------------------------------
    run_multiome_integration = true
    mofa    { run = true; n_factors = 5; convergence_mode = 'fast'
              bootstrap { n_iterations = 3; sample_fraction = 0.5 } }
    multivi { run = true; n_epochs = 20; n_latent = 10 }

    // ---- Downstream ---------------------------------------------------------
    // Floors lowered for a 1,000-cell dataset. At this scale a PBMC cell type is
    // ~30-400 cells, so the shipped defaults (hdwgcna 100) would skip most types.
    // qc.cell_type_resolution stays at max(50, 1% x total) = 50 cells.
    cellchat { run = true }
    hdwgcna  { run = true; min_cells = 50 }

    // Single condition, so every condition-aware workflow stays off. Enabling any
    // of these would also make condition_group mandatory in the manifest.
    differential     { run = false }
    differential_rna { run = false }
    differential_tf  { run = false }
}
