// ============================================================================
// configs/resource_tiers/medium.config — Resource allocations for medium datasets
//
// Intermediate tier for 6-50 sample datasets (~30k-80k cells).
// Scaled between small (single sample PBMC) and large (100+ sample BD).
// Processes requiring >250 GB spill to highmem; >450 GB to hugemem.
//
// Loaded automatically when params.resource_tier = 'medium'.
// ============================================================================

process {
    // =========================
    // RNA: GPU PROCESSES
    // =========================

    // CELLBENDER — ambient RNA removal
    withName: 'CELLBENDER' {
        container = params.containers.scgpu
        containerOptions = '--nv'
        cpus   = 16
        memory = '128.GB'
        time   = '72h'
        clusterOptions = "-A ${params.slurm_account_gpu} -p ${params.slurm_partition_gpu} --gres=gpu:${params.slurm_gpu_type}:${params.slurm_gpu_count}"
        maxRetries = 2
        errorStrategy = 'retry'
    }

    // TRAIN_SCVI / TRAIN_SCANVI / PREPARE_REFERENCE — gpu-hugemem
    withName: 'TRAIN_SCVI|TRAIN_SCANVI|PREPARE_REFERENCE' {
        container = params.containers.scgpu
        containerOptions = '--nv'
        cpus   = 20
        memory = '1100.GB'
        time   = '24h'
        errorStrategy = {
            // 2026-05-05 PM: prior closure only checked task.errorReport, which is
            // sourced from .command.log — that file doesn't exist for sbatch
            // submit-time failures (Nextflow logs "Unable to dump error of process
            // 'null' -- NoSuchFileException: .command.log"). The QOSMaxSubmit text
            // for submit failures lives on task.error.message instead. Check both,
            // plus a blanket retry on the first 3 attempts as a safety net for
            // transient submitter-thread failures where neither field is populated.
            def msg = (task.errorReport ?: '') + ' ' + (task.error?.message ?: '')
            if (msg.contains('QOSMaxSubmit') ||
                msg.contains('Batch job submission failed') ||
                msg.contains('Failed to submit')) return 'retry'
            if (task.attempt <= 3 && !msg.trim()) return 'retry'
            return 'terminate'
        }
        maxRetries = 50
        clusterOptions = "-A ${params.slurm_account_gpu} -p ${params.slurm_partition_gpu_hugemem} --qos=${params.slurm_qos_gpu_hugemem} --gres=gpu:${params.slurm_gpu_type}:${params.slurm_gpu_count}"
    }

    // =========================
    // RNA: CPU PROCESSES
    // =========================

    withName: 'RNA_QC' {
        container = params.containers.scgpu
        cpus   = 4
        memory = '64.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'RUN_CELLTYPIST' {
        container = params.containers.scgpu
        cpus   = 6
        memory = '32.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'CONCAT_BATCHES' {
        container = params.containers.scgpu
        cpus   = 6
        memory = '128.GB'
        time   = '3h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'PLOT_POST_SCANVI' {
        container = params.containers.scgpu
        errorStrategy = 'terminate'
        cpus   = 6
        memory = '96.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'ASSIGN_TEST_GROUPS' {
        container = params.containers.scgpu
        cpus   = 2
        memory = '16.GB'
        time   = '1h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // =========================
    // ATAC PROCESSES
    // =========================

    withName: 'ATAC_INITIAL_QC' {
        container = params.containers.snapatac
        cpus   = 8
        memory = '64.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'ATAC_MAKE_THRESHOLDS' {
        container = params.containers.snapatac
        cpus   = 2
        memory = '8.GB'
        time   = '1h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'ATAC_FINAL_PIPELINE' {
        container = params.containers.snapatac
        cpus   = 8
        memory = '64.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'ATAC_CELLTYPE_ANNOTATION' {
        container = params.containers.snapatac
        cpus   = 6
        memory = '64.GB'
        time   = '8h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'MERGE_ANNOTATIONS' {
        container = params.containers.snapatac
        cpus   = 8
        memory = '128.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // =========================
    // REGULATORY: CICERO
    // =========================

    withName: 'CICERO_TRIPLETS' {
        container = params.containers.snapatac
        cpus   = 6
        memory = '48.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // CICERO Phase 3 rewrite: ESTIMATE_DP + FULL_CHROM fan-out + JOIN.
    withName: 'CICERO_ESTIMATE_DP' {
        container = params.containers.r_cicero
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 8
        memory = '200.GB'
        time   = '8h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'CICERO_FULL_CHROM' {
        container = params.containers.r_cicero
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 4
        memory = '96.GB'
        time   = '3h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'CICERO_JOIN' {
        container = params.containers.r_cicero
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 4
        memory = '96.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'CICERO_TARGET_PLOTS' {
        container = params.containers.r_cicero
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 4
        memory = '32.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // Generates ct_annotation_v2.csv from peak_matrix_annotated.h5ad (light I/O only)
    withName: 'BUILD_CT_ANNOTATION' {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus   = 2
        memory = '8.GB'
        time   = '1h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // Per-CT × condition Cicero (ported from SDas; monolithic run per stratum)
    withName: 'CICERO_TRIPLETS_PER_CT' {
        container = params.containers.snapatac
        errorStrategy = { task.exitStatus == 77 ? 'ignore' : 'terminate' }
        cpus   = 4
        memory = '16.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // Phase 2a: build shared CDS + estimate distance_parameter (one per stratum)
    withName: 'CICERO_ESTIMATE_DP_PER_CT' {
        container = params.containers.r_cicero
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 4
        memory = '32.GB'
        time   = '4h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // Phase 2b: per-chrom Cicero model (one task per stratum × chrom)
    withName: 'CICERO_FULL_CHROM_PER_CT' {
        container = params.containers.r_cicero
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 2
        memory = '16.GB'
        time   = '4h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // Phase 2c: rbind chrom connections + CCAN assignment (one per stratum)
    withName: 'CICERO_JOIN_PER_CT' {
        container = params.containers.r_cicero
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 4
        memory = '64.GB'
        time   = '4h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // =========================
    // REGULATORY: CHROMVAR (GPU)
    // =========================

    withName: 'GPU_CHROMVAR' {
        container = params.containers.snapatac
        containerOptions = '--nv'
        cpus   = 8
        memory = '128.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account_gpu} -p ${params.slurm_partition_gpu} --gres=gpu:${params.slurm_gpu_type}:${params.slurm_gpu_count}"
    }

    withName: 'VIS_CHROMVAR' {
        container = params.containers.snapatac
        cpus   = 4
        memory = '32.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'EXTRACT_CHROMVAR_MOTIFS' {
        container = params.containers.snapatac
        cpus   = 2
        memory = '16.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'MAP_TF_TO_TARGET_GENES' {
        container = params.containers.snapatac
        cpus   = 4
        memory = '48.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'RESOLVE_GENE_COORDINATES' {
        container = params.containers.snapatac
        cpus   = 2
        memory = '16.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // =========================
    // REGULATORY: scPRINTER
    // =========================

    withName: 'SCPRINTER_BARCODES' {
        container = params.containers.snapatac
        cpus   = 2
        memory = '8.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'SCPRINTER_BUILD_PRINTER' {
        container = params.containers.snapatac
        cpus   = 6
        memory = '48.GB'
        time   = '8h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'SCPRINTER_FOOTPRINTING' {
        container = params.containers.snapatac
        cpus   = 6
        memory = '128.GB'
        time   = '8h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'SCPRINTER_MOTIF_SCAN' {
        container = params.containers.snapatac
        cpus   = 6
        memory = '128.GB'
        time   = '8h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'SCPRINTER_DORC' {
        container = params.containers.snapatac
        cpus   = 6
        memory = '48.GB'
        time   = '6h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // =========================
    // ENHANCER FOOTPRINTING RECIPES
    // =========================

    // EXTRACT_CCAN_ENHANCERS + aliased per-condition variants (CTRL/TRT)
    withName: /EXTRACT_CCAN_ENHANCERS(_CTRL|_TRT)?/ {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus   = 4
        memory = '48.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // MOTIF_SCAN_ENHANCERS + union variant (cis-rewiring)
    withName: /MOTIF_SCAN_ENHANCERS(_UNION)?/ {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus   = 4
        memory = '96.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // BUILD_UNION_ENHANCER_PEAKS — pure shell (zcat | sort | bedtools merge)
    withName: 'BUILD_UNION_ENHANCER_PEAKS' {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus   = 2
        memory = '8.GB'
        time   = '30m'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // Cis-rewiring per-TF renderers — both fan out from the same channel
    // with identical compute profiles. Regex-merged.
    withName: /MOTIF_IN_GAINED_CCANS|RENDER_CIS_REWIRING_MOTIF_STACK/ {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus   = 1
        memory = '8.GB'
        time   = '30m'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // ENHANCER_FOOTPRINTING (legacy sharded fallback when use_per_ct=false).
    // SDas_nf 2026-04-25 audit measured MaxRSS 212 GB (83% util at 256 GB);
    // AD's 12-sample paired data does not exceed SDas's per-(ct, TF) peak
    // memory since each task processes a single TF × peaks-in-ct (sample
    // count doesn't multiply per-task RAM). 256 GB / highmem replaces the
    // prior 1400 GB / maxmem panic-buy; flip back if a measured AD MaxRSS
    // ever exceeds this ceiling.
    withName: 'ENHANCER_FOOTPRINTING' {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus     = 8
        memory   = '256.GB'
        time     = '6h'
        maxForks = 14
        clusterOptions = "-A ${params.slurm_account} -p highmem"
    }

    // ENHANCER_FOOTPRINTING_PER_CT — bumped 192→256 GB after 2026-05-05 PM
    // OOM #2 (ARH-PVi Six6 Dopa-Gaba, 7 cells, exit 137 on TF #2 RFX1).
    // Worker-pool RAM in scp.tl.get_footprint_score is CT-independent
    // (modes=arange(2,101), n_jobs=8, n_groups~100) so the floor of memory
    // need is set by region count × scales × positions × workers, not by
    // n_cells. The 7-cell CT is now gated by params.qc.cell_type_resolution
    // (chromvar/extract_motifs.nf), so 256 GB is a safety margin for the
    // legitimate large CTs that DO pass the gate. n_jobs=8 → 4 is the next
    // memory-reduction lever if 256 still OOMs.
    withName: 'ENHANCER_FOOTPRINTING_PER_CT' {
        container = params.containers.snapatac
        cpus      = 8
        memory    = '256.GB'
        time      = '24h'
        maxForks  = 3
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // PROMOTER_MSFP_PER_CT — same printer-load amortization profile as
    // ENHANCER_FOOTPRINTING_PER_CT, but single-locus regions_df per gene
    // (not the full ccan-enhancer bed). Per-task RAM scales with printer
    // size + region count (small), not cell count.
    withName: 'PROMOTER_MSFP_PER_CT' {
        container = params.containers.snapatac
        cpus   = 8
        memory = '96.GB'
        time   = '12h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'RENDER_PROMOTER_MSFP_OVERLAY' {
        container = params.containers.snapatac
        cpus   = 1
        memory = '8.GB'
        time   = '30m'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'EXTRACT_EREGULON_REGIONS' {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus   = 2
        memory = '16.GB'
        time   = '1h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'CROSS_MODAL_VALIDATION' {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus   = 4
        memory = '300.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p highmem"
    }

    withName: 'CELLCHAT_TO_TF_HYPOTHESES' {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus   = 4
        memory = '32.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'EXTRACT_SIGNALING_TARGETS' {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus   = 2
        memory = '16.GB'
        time   = '1h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'SIGNAL_CHAIN_CORRELATION' {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus   = 4
        memory = '300.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p highmem"
    }

    withName: 'PREPARE_ENHANCER_VIZ_TRACKS' {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus   = 2
        memory = '8.GB'
        time   = '1h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'COMPOSITE_ENHANCER_VIZ' {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus   = 4
        memory = '16.GB'
        time   = '6h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // EXPORT_ATAC_BIGWIGS — snapatac2 snap.ex.export_coverage; always-on after
    // annotation (MARKER_COVERAGE_TRACKS + RENDER_GENOME_BROWSER consume outputs).
    // Two-pass when enhancer_viz.condition_col is set: broad-class + per-(CT×cond).
    withName: 'EXPORT_ATAC_BIGWIGS' {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus   = 4
        memory = '64.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // New viz renderers (2026-05-26 refactor)
    // RENDER_MSFP_{PROMOTER,ENHANCER}_STRIP — scprinter + logomaker; load h5ads.
    // RENDER_GENOME_BROWSER — matplotlib + pyBigWig; reads BigWig tiles.
    // RENDER_CICERO_LOLLIPOP — pandas/matplotlib only; reads Cicero TSVs.
    withName: 'RENDER_MSFP_PROMOTER_STRIP' {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus   = 1
        memory = '16.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
    withName: 'RENDER_MSFP_ENHANCER_STRIP' {
        container = params.containers.snapatac
        errorStrategy = { task.exitStatus == 77 ? 'ignore' : 'terminate' }
        cpus   = 1
        memory = '16.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
    withName: 'RENDER_GENOME_BROWSER' {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus   = 1
        memory = '8.GB'
        time   = '1h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
    withName: 'RENDER_CICERO_LOLLIPOP' {
        container = params.containers.scgpu
        errorStrategy = 'terminate'
        cpus   = 1
        memory = '8.GB'
        time   = '1h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // =========================
    // GRN: SCENIC+ / pycisTopic
    // =========================

    withName: 'SCENICPLUS_RUN' {
        container = params.containers.scenicplus
        cpus   = 8
        memory = '350.GB'
        time   = '48h'
        clusterOptions = "-A ${params.slurm_account} -p highmem"
    }

    // PYCISTOPIC_PREPARE — single Nextflow task that internally fans out
    // n_cpu BGZF writers via joblib in scatac_fragment_tools.split_fragments_by_cell_type.
    // 2026-05-12: cpus 8 → 3 after job 52091797 hit "[E::bgzf_close] File write failed"
    // / pyo3 PanicException("Can not write") with 8 parallel writers — same class
    // of mitigation as ENHANCER_FOOTPRINTING_PER_CT maxForks=3. maxForks=1 is
    // cosmetic (only one task ever exists) but documents serialized writes.
    withName: 'PYCISTOPIC_PREPARE' {
        container = params.containers.scenicplus
        cpus     = 3
        maxForks = 1
        memory = '256.GB'
        time   = '48h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'SCENICPLUS_VISUALIZE' {
        container = params.containers.scenicplus
        errorStrategy = 'terminate'
        cpus   = 4
        memory = '32.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // =========================
    // MULTIOME INTEGRATION
    // =========================

    withName: 'BUILD_MUDATA' {
        container = params.containers.scgpu
        cpus   = 16
        memory = '700.GB'
        time   = '48h'
        clusterOptions = "-A ${params.slurm_account} -p hugemem"
    }

    withName: 'MOFA_INTEGRATE' {
        container = params.containers.scgpu
        containerOptions = '--nv'
        cpus   = 16
        memory = '400.GB'
        time   = '24h'
        maxForks = 1
        errorStrategy = {
            // 2026-05-05 PM: prior closure only checked task.errorReport, which is
            // sourced from .command.log — that file doesn't exist for sbatch
            // submit-time failures (Nextflow logs "Unable to dump error of process
            // 'null' -- NoSuchFileException: .command.log"). The QOSMaxSubmit text
            // for submit failures lives on task.error.message instead. Check both,
            // plus a blanket retry on the first 3 attempts as a safety net for
            // transient submitter-thread failures where neither field is populated.
            def msg = (task.errorReport ?: '') + ' ' + (task.error?.message ?: '')
            if (msg.contains('QOSMaxSubmit') ||
                msg.contains('Batch job submission failed') ||
                msg.contains('Failed to submit')) return 'retry'
            if (task.attempt <= 3 && !msg.trim()) return 'retry'
            return 'terminate'
        }
        maxRetries = 50
        clusterOptions = "-A ${params.slurm_account_gpu} -p gpu-hugemem --qos=gpu-hugemem-vswarup --gres=gpu:A30:1"
    }

    withName: 'MOFA_VISUALIZE' {
        container = params.containers.scgpu
        cpus   = 6
        memory = '500.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p hugemem"
    }

    withName: 'MULTIVI_INTEGRATE' {
        container = params.containers.scgpu
        containerOptions = '--nv'
        cpus   = 16
        memory = '400.GB'
        time   = '24h'
        maxForks = 1
        errorStrategy = {
            // 2026-05-05 PM: prior closure only checked task.errorReport, which is
            // sourced from .command.log — that file doesn't exist for sbatch
            // submit-time failures (Nextflow logs "Unable to dump error of process
            // 'null' -- NoSuchFileException: .command.log"). The QOSMaxSubmit text
            // for submit failures lives on task.error.message instead. Check both,
            // plus a blanket retry on the first 3 attempts as a safety net for
            // transient submitter-thread failures where neither field is populated.
            def msg = (task.errorReport ?: '') + ' ' + (task.error?.message ?: '')
            if (msg.contains('QOSMaxSubmit') ||
                msg.contains('Batch job submission failed') ||
                msg.contains('Failed to submit')) return 'retry'
            if (task.attempt <= 3 && !msg.trim()) return 'retry'
            return 'terminate'
        }
        maxRetries = 50
        clusterOptions = "-A ${params.slurm_account_gpu} -p gpu-hugemem --qos=gpu-hugemem-vswarup --gres=gpu:A30:1"
    }

    withName: 'MULTIVI_VISUALIZE' {
        container = params.containers.scgpu
        cpus   = 6
        memory = '96.GB'
        time   = '6h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'MULTIVI_MASKING_SWEEP_ONE' {
        container = params.containers.scgpu
        containerOptions = '--nv'
        accelerator = 1
        cpus   = 48
        memory = '2200.GB'
        time   = '12h'
        maxForks = 1
        errorStrategy = {
            // 2026-05-05 PM: prior closure only checked task.errorReport, which is
            // sourced from .command.log — that file doesn't exist for sbatch
            // submit-time failures (Nextflow logs "Unable to dump error of process
            // 'null' -- NoSuchFileException: .command.log"). The QOSMaxSubmit text
            // for submit failures lives on task.error.message instead. Check both,
            // plus a blanket retry on the first 3 attempts as a safety net for
            // transient submitter-thread failures where neither field is populated.
            def msg = (task.errorReport ?: '') + ' ' + (task.error?.message ?: '')
            if (msg.contains('QOSMaxSubmit') ||
                msg.contains('Batch job submission failed') ||
                msg.contains('Failed to submit')) return 'retry'
            if (task.attempt <= 3 && !msg.trim()) return 'retry'
            return 'terminate'
        }
        maxRetries = 50
        clusterOptions = "-A ${params.slurm_account_gpu} -p ${params.slurm_partition_gpu_hugemem} --qos=${params.slurm_qos_gpu_hugemem} --gres=gpu:A30:1"
    }

    withName: 'MULTIVI_MASKING_SWEEP_AGGREGATE' {
        container = params.containers.scgpu
        cpus   = 4
        memory = '32.GB'
        time   = '1h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'MULTIVI_DRIVER_FACTORS' {
        container = params.containers.scgpu
        containerOptions = '--nv'
        accelerator = 1
        cpus   = 4
        memory = '200.GB'
        time   = '2h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account_gpu} -p ${params.slurm_partition_gpu} --gres=gpu:V100:1"
    }

    withName: 'MULTIVI_GAP_FILL' {
        container = params.containers.scgpu
        containerOptions = '--nv'
        accelerator = 1
        cpus   = 29
        memory = '1200.GB'
        time   = '12h'
        maxForks = 1
        errorStrategy = {
            if (task.exitStatus == 137) return 'terminate'   // OOM kill — don't retry
            def msg = (task.errorReport ?: '') + ' ' + (task.error?.message ?: '')
            if (msg.contains('QOSMaxSubmit') ||
                msg.contains('Batch job submission failed') ||
                msg.contains('Failed to submit')) return 'retry'
            if (task.attempt <= 3 && !msg.trim()) return 'retry'
            return 'terminate'
        }
        maxRetries = 50
        clusterOptions = "-A ${params.slurm_account_gpu} -p gpu-hugemem --qos=gpu-hugemem-vswarup --gres=gpu:A30:1"
    }

    // MULTIVI_VALIDATE — loads 86 GB gap-filled h5mu + 2 h5ads; no GPU needed
    // highmem nodes cap at 386 GB — must use hugemem (772 GB nodes)
    withName: 'MULTIVI_VALIDATE' {
        container = params.containers.scgpu
        cpus   = 16
        memory = '400.GB'
        time   = '6h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p hugemem"
    }

    withName: 'EXPORT_MUDATA_RNA' {
        container = params.containers.scgpu
        cpus   = 6
        memory = '64.GB'
        time   = '3h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'BOOTSTRAP_MOFA_INTEGRATION' {
        container = params.containers.scgpu
        cpus   = 4
        memory = '96.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'CONSENSUS_ANALYSIS' {
        container = params.containers.scgpu
        cpus   = 4
        memory = '32.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'ANALYZE_MEMORY_LOG' {
        container = params.containers.scgpu
        cpus   = 1
        memory = '8.GB'
        time   = '30m'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // =========================
    // R: SEURAT / HDWGCNA / CELLCHAT
    // =========================

    withName: 'CONVERT_H5AD_TO_SEURAT' {
        container = params.containers.r_seurat
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 6
        memory = '128.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'HDWGCNA_PER_CELLTYPE' {
        container = params.containers.r_seurat
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 8
        memory = '256.GB'
        time   = '24h'
        clusterOptions = "-A ${params.slurm_account} -p highmem"
    }

    withName: 'RUN_CELLCHAT' {
        container = params.containers.r_cellchat
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 8
        memory = '128.GB'
        time   = '24h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'COMPARE_CELLCHAT' {
        container = params.containers.r_cellchat
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 6
        memory = '64.GB'
        time   = '6h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // FIX-29 per-condition CellChat. zellkonverter::readH5AD → basilisk needs
    // R_LIBS_USER guard to prevent host R libs from overriding container conda.
    withName: 'CELLCHAT_PER_CONDITION' {
        container = params.containers.r_cellchat
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 6
        memory = '96.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'CELLCHAT_COMPARE' {
        container = params.containers.r_cellchat
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 6
        memory = '64.GB'
        time   = '6h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // =========================
    // DE / DOWNSTREAM
    // =========================

    withName: 'CONVERT_H5AD_FOR_MAST' {
        container = params.containers.r_seurat
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 4
        memory = '64.GB'
        time   = '3h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'EXTRACT_CELL_TYPES_FOR_MAST' {
        container = params.containers.scgpu
        cpus   = 4
        memory = '64.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'RUN_MAST_DE' {
        container = params.containers.r_seurat
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 6
        memory = '64.GB'
        time   = '6h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'CREATE_VOLCANO_PLOTS' {
        container = params.containers.r_seurat
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 2
        memory = '16.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'RUN_GO_ENRICHMENT' {
        container = params.containers.r_seurat
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 4
        memory = '32.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'SNAPATAC_DIFFERENTIAL' {
        container = params.containers.snapatac
        cpus   = 6
        memory = '64.GB'
        time   = '6h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // -------------------------------------------------------------------
    // SHI_FIGURES — Shi et al. 2025 figure equivalents (D3 SDas absorb)
    // Bumped vs small.config for AD's 12-sample scale.
    // -------------------------------------------------------------------
    withName: 'ANNOTATE_PEAK_TYPES' {
        container = params.containers.snapatac
        cpus   = 4
        memory = '64.GB'
        time   = '2h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
    withName: 'NMF_ENHANCER_PROGRAMS' {
        container = params.containers.snapatac
        cpus   = 12
        memory = '180.GB'
        time   = '8h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
    withName: 'MARKER_COVERAGE_TRACKS' {
        container = params.containers.snapatac
        cpus   = 4
        memory = '16.GB'
        time   = '1h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
    withName: 'SELECT_SHI_CANDIDATES' {
        container = params.containers.snapatac
        cpus   = 2
        memory = '32.GB'
        time   = '1h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
    withName: 'COACC_CORRELATION_MATRIX' {
        container = params.containers.snapatac
        cpus   = 4
        memory = '64.GB'
        time   = '2h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
    withName: 'DA_PEAK_BREAKDOWN' {
        container = params.containers.snapatac
        cpus   = 2
        memory = '16.GB'
        time   = '1h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
    withName: 'DA_LOG2FC_HEATMAPS' {
        container = params.containers.snapatac
        cpus   = 2
        memory = '16.GB'
        time   = '1h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
    withName: 'TF_DIFFERENTIAL_VOLCANO' {
        container = params.containers.snapatac
        cpus   = 2
        memory = '16.GB'
        time   = '1h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
    withName: 'CURATED_TF_NETWORKS' {
        container = params.containers.snapatac
        cpus   = 2
        memory = '16.GB'
        time   = '1h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
    withName: 'LOCUS_TF_BINDING' {
        container = params.containers.snapatac
        cpus   = 2
        memory = '16.GB'
        time   = '1h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

}
