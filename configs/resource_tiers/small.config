// ============================================================================
// configs/resource_tiers/small.config — Resource allocations for small datasets
//
// Extracted from PBMC_10x_nf/nextflow.config (10k cells, single sample).
// These blocks are applied inside the cluster profile and override label
// defaults with per-process allocations sized for small-scale data.
//
// Loaded automatically when params.resource_tier = 'small' or 'auto'.
// ============================================================================

process {
    // =========================
    // RNA: GPU PROCESSES
    // =========================

    // CELLBENDER — ambient RNA removal
    withName: 'CELLBENDER' {
        container = params.containers.scgpu
        containerOptions = '--nv'
        cpus   = 16
        memory = '128.GB'
        time   = '72h'
        clusterOptions = "-A ${params.slurm_account_gpu} -p ${params.slurm_partition_gpu} --gres=gpu:${params.slurm_gpu_type}:${params.slurm_gpu_count}"
        maxRetries = 2
        errorStrategy = 'retry'
    }

    // TRAIN_SCVI / TRAIN_SCANVI / PREPARE_REFERENCE — gpu-hugemem
    // Path B skips these (ref_dir_human_integrated=null) but included for completeness.
    withName: 'TRAIN_SCVI|TRAIN_SCANVI|PREPARE_REFERENCE' {
        container = params.containers.scgpu
        containerOptions = '--nv'
        cpus   = 20
        memory = '1100.GB'
        time   = '24h'
        clusterOptions = "-A ${params.slurm_account_gpu} -p ${params.slurm_partition_gpu_hugemem} --qos=${params.slurm_qos_gpu_hugemem} --gres=gpu:${params.slurm_gpu_type}:${params.slurm_gpu_count}"
    }

    // =========================
    // RNA: CPU PROCESSES
    // =========================

    withName: 'RNA_QC' {
        container = params.containers.scgpu
        cpus   = 4
        memory = '64.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'RUN_CELLTYPIST' {
        container = params.containers.scgpu
        cpus   = 4
        memory = '16.GB'
        time   = '1h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'CONCAT_BATCHES' {
        container = params.containers.scgpu
        cpus   = 4
        memory = '64.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'PLOT_POST_SCANVI' {
        container = params.containers.scgpu
        errorStrategy = 'terminate'
        cpus   = 4
        memory = '64.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'ASSIGN_TEST_GROUPS' {
        container = params.containers.scgpu
        cpus   = 2
        memory = '16.GB'
        time   = '1h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // =========================
    // ATAC PROCESSES
    // =========================

    withName: 'ATAC_INITIAL_QC' {
        container = params.containers.snapatac
        cpus   = 8
        memory = '64.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'ATAC_MAKE_THRESHOLDS' {
        container = params.containers.snapatac
        cpus   = 2
        memory = '8.GB'
        time   = '1h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'ATAC_FINAL_PIPELINE' {
        container = params.containers.snapatac
        cpus   = 8
        memory = '64.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'ATAC_CELLTYPE_ANNOTATION' {
        container = params.containers.snapatac
        cpus   = 4
        memory = '32.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'MERGE_ANNOTATIONS' {
        container = params.containers.snapatac
        cpus   = 8
        memory = '128.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // =========================
    // REGULATORY: CICERO
    // =========================

    withName: 'CICERO_TRIPLETS' {
        container = params.containers.snapatac
        cpus   = 4
        memory = '32.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // CICERO Phase 3 rewrite: ESTIMATE_DP (global dp) + FULL_CHROM fan-out + JOIN.
    // Replaces the single-process CICERO_FULL (was 4cpu/250GB/48h). Per-chrom
    // fan-out gives ~4x speedup with rho=1.0 vs baseline (see
    // tests/cicero_parallel_test/global_dp_20260418_023059/).
    withName: 'CICERO_ESTIMATE_DP' {
        container = params.containers.r_cicero
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 4
        memory = '128.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'CICERO_FULL_CHROM' {
        container = params.containers.r_cicero
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 4
        memory = '64.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'CICERO_JOIN' {
        container = params.containers.r_cicero
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 2
        memory = '64.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'CICERO_TARGET_PLOTS' {
        container = params.containers.r_cicero
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 4
        memory = '32.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // Generates ct_annotation_v2.csv from peak_matrix_annotated.h5ad (light I/O only)
    withName: 'BUILD_CT_ANNOTATION' {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus   = 2
        memory = '8.GB'
        time   = '1h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // Per-CT × condition Cicero (ported from SDas; monolithic run per stratum)
    withName: 'CICERO_TRIPLETS_PER_CT' {
        container = params.containers.snapatac
        errorStrategy = { task.exitStatus == 77 ? 'ignore' : 'terminate' }
        cpus   = 4
        memory = '16.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // Phase 2a: build shared CDS + estimate distance_parameter (one per stratum)
    withName: 'CICERO_ESTIMATE_DP_PER_CT' {
        container = params.containers.r_cicero
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 4
        memory = { task.attempt == 1 ? '32.GB' : '64.GB' }
        time   = { task.attempt == 1 ? '4h'    : '8h'    }
        errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'terminate' }
        maxRetries = 1
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // Phase 2b: per-chrom Cicero model (one task per stratum × chrom)
    withName: 'CICERO_FULL_CHROM_PER_CT' {
        container = params.containers.r_cicero
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 2
        memory = { task.attempt == 1 ? '16.GB' : '32.GB' }
        time   = { task.attempt == 1 ? '2h'    : '4h'    }
        errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'terminate' }
        maxRetries = 1
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // Phase 2c: rbind chrom connections + CCAN assignment (one per stratum)
    withName: 'CICERO_JOIN_PER_CT' {
        container = params.containers.r_cicero
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 2
        memory = '16.GB'
        time   = '2h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // =========================
    // REGULATORY: CHROMVAR (GPU)
    // =========================

    withName: 'GPU_CHROMVAR' {
        container = params.containers.snapatac
        containerOptions = '--nv'
        cpus   = 8
        memory = '64.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account_gpu} -p ${params.slurm_partition_gpu} --gres=gpu:${params.slurm_gpu_type}:${params.slurm_gpu_count}"
    }

    withName: 'VIS_CHROMVAR' {
        container = params.containers.snapatac
        cpus   = 4
        memory = '32.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'EXTRACT_CHROMVAR_MOTIFS' {
        container = params.containers.snapatac
        cpus   = 2
        memory = '16.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'MAP_TF_TO_TARGET_GENES' {
        container = params.containers.snapatac
        cpus   = 4
        memory = '32.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'RESOLVE_GENE_COORDINATES' {
        container = params.containers.snapatac
        cpus   = 2
        memory = '16.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // =========================
    // REGULATORY: scPRINTER
    // =========================

    withName: 'SCPRINTER_BARCODES' {
        container = params.containers.snapatac
        cpus   = 2
        memory = '8.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'SCPRINTER_BUILD_PRINTER' {
        container = params.containers.snapatac
        cpus   = 4
        memory = '32.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'SCPRINTER_FOOTPRINTING' {
        container = params.containers.snapatac
        cpus   = 4
        memory = '64.GB'
        time   = '6h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'SCPRINTER_MOTIF_SCAN' {
        container = params.containers.snapatac
        cpus   = 4
        memory = '64.GB'
        time   = '6h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'SCPRINTER_DORC' {
        container = params.containers.snapatac
        cpus   = 4
        memory = '32.GB'
        time   = '4h'
        errorStrategy = 'retry'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // =========================
    // ENHANCER FOOTPRINTING RECIPES
    // =========================

    // EXTRACT_CCAN_ENHANCERS + per-condition aliased variants (CTRL/TRT)
    withName: /EXTRACT_CCAN_ENHANCERS(_CTRL|_TRT)?/ {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus   = 4
        memory = '32.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // MOTIF_SCAN_ENHANCERS + union variant (cis-rewiring)
    withName: /MOTIF_SCAN_ENHANCERS(_UNION)?/ {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus   = 4
        memory = '64.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // BUILD_UNION_ENHANCER_PEAKS — pure shell (zcat | sort | bedtools merge)
    withName: 'BUILD_UNION_ENHANCER_PEAKS' {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus   = 2
        memory = '4.GB'
        time   = '30m'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // Cis-rewiring per-TF renderers — both fan out from same channel
    withName: /MOTIF_IN_GAINED_CCANS|RENDER_CIS_REWIRING_MOTIF_STACK/ {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus   = 1
        memory = '4.GB'
        time   = '30m'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // ENHANCER_FOOTPRINTING (legacy sharded fallback when use_per_ct=false).
    // SDas_nf 2026-04-25 audit measured MaxRSS 212 GB (83% util at 256 GB);
    // maxForks=14 to amortize the 5453-task fan-out across highmem nodes.
    withName: 'ENHANCER_FOOTPRINTING' {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus     = 8
        memory   = '256.GB'
        time     = '6h'
        maxForks = 14
        clusterOptions = "-A ${params.slurm_account} -p highmem"
    }

    withName: 'EXTRACT_EREGULON_REGIONS' {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus   = 2
        memory = '16.GB'
        time   = '1h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'CROSS_MODAL_VALIDATION' {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus   = 4
        memory = '250.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p highmem"
    }

    withName: 'CELLCHAT_TO_TF_HYPOTHESES' {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus   = 4
        memory = '32.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'EXTRACT_SIGNALING_TARGETS' {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus   = 2
        memory = '16.GB'
        time   = '1h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'SIGNAL_CHAIN_CORRELATION' {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus   = 4
        memory = '250.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p highmem"
    }

    withName: 'PREPARE_ENHANCER_VIZ_TRACKS' {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus   = 2
        memory = '8.GB'
        time   = '1h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'COMPOSITE_ENHANCER_VIZ' {
        container = params.containers.snapatac
        errorStrategy = 'terminate'
        cpus   = 4
        memory = '16.GB'
        time   = '6h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // =========================
    // GRN: SCENIC+ / pycisTopic
    // =========================

    withName: 'SCENICPLUS_RUN' {
        container = params.containers.scenicplus
        cpus   = 8
        memory = '400.GB'
        time   = '48h'
        clusterOptions = "-A ${params.slurm_account} -p hugemem"
    }

    withName: 'PYCISTOPIC_PHASE1|PYCISTOPIC_ATAC_PREPARE' {
        container = params.containers.scenicplus
        cpus   = 8
        memory = '256.GB'
        time   = '48h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'PYCISTOPIC_MERGE_OBJECTS' {
        container = params.containers.scenicplus
        cpus   = 4
        memory = '64.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'PYCISTOPIC_RUN_LDA' {
        container = params.containers.scenicplus
        cpus   = 8
        memory = '128.GB'
        time   = '24h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'PYCISTOPIC_FINALIZE_LDA' {
        container = params.containers.scenicplus
        cpus   = 8
        memory = '256.GB'
        time   = '48h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'SCENICPLUS_VISUALIZE' {
        container = params.containers.scenicplus
        errorStrategy = 'terminate'
        cpus   = 4
        memory = '32.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // =========================
    // MULTIOME INTEGRATION
    // =========================

    withName: 'BUILD_MUDATA' {
        container = params.containers.scgpu
        cpus   = 16
        memory = '256.GB'
        time   = '48h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'MOFA_INTEGRATE' {
        container = params.containers.scgpu
        containerOptions = '--nv'
        cpus   = 16
        memory = '256.GB'
        time   = '48h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'MOFA_VISUALIZE' {
        container = params.containers.scgpu
        cpus   = 4
        memory = '500.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p hugemem --exclude=hpc3-19-07"
    }

    // MULTIVI_* — cross-instance canonical as of 2026-04-17 sync.
    // Floor: 200GB host RAM, V100 pin, accelerator=1, errorStrategy=terminate.
    // Rationale: late-training host RSS leak in scvi-tools MultiVI train loop
    // hits 64-128GB around epoch 170-190 on real data; 200GB covers single
    // training, and the V100 pin avoids A30 queue pressure while exceeding
    // the VRAM requirement (~7GB peak).
    withName: 'MULTIVI_INTEGRATE' {
        container = params.containers.scgpu
        containerOptions = '--nv'
        accelerator = 1
        cpus   = 8
        memory = '200.GB'
        time   = '8h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account_gpu} -p ${params.slurm_partition_gpu} --gres=gpu:V100:1"
    }

    withName: 'MULTIVI_VISUALIZE' {
        container = params.containers.scgpu
        containerOptions = '--nv'
        accelerator = 1
        cpus   = 4
        memory = '200.GB'
        time   = '2h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account_gpu} -p ${params.slurm_partition_gpu} --gres=gpu:V100:1"
    }

    // MASKING_SWEEP is fanned out: each (fraction, seed) runs in its own
    // Nextflow task → fresh Python process → no cross-fit leak. Within a
    // single 175-epoch fit MultiVI still grows host RAM; fraction=0.75 is
    // the worst case (max unpaired cells → ~13k training rows from 7.6k
    // cells on PBMC).
    //
    // AD deviation (12 samples vs PBMC's 1 → ~12x paired MuData): 180GB/
    // any-GPU OOM'd at frac0.75_seed456 on 51217480 (2026-04-19, exit 137).
    // Moved to gpu-hugemem A30 with 2200GB to eliminate the memory ceiling
    // entirely — the 3TB node effectively hosts one job at that RAM
    // footprint, so we take ~half the cpus (48 of 64) for data loaders
    // while leaving headroom for other small jobs on the node.
    withName: 'MULTIVI_MASKING_SWEEP_ONE' {
        container = params.containers.scgpu
        containerOptions = '--nv'
        accelerator = 1
        cpus   = 48
        memory = '2200.GB'
        time   = '12h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account_gpu} -p ${params.slurm_partition_gpu_hugemem} --qos=${params.slurm_qos_gpu_hugemem} --gres=gpu:A30:1"
    }

    withName: 'MULTIVI_MASKING_SWEEP_AGGREGATE' {
        container = params.containers.scgpu
        cpus   = 4
        memory = '32.GB'
        time   = '1h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'MULTIVI_DRIVER_FACTORS' {
        container = params.containers.scgpu
        containerOptions = '--nv'
        accelerator = 1
        cpus   = 4
        memory = '200.GB'
        time   = '2h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account_gpu} -p ${params.slurm_partition_gpu} --gres=gpu:V100:1"
    }

    // GAP_FILL retrains MultiVI on expanded MuData (paired + RNA-only + ATAC-
    // only gap cells); prior PBMC OOMs at 64GB (ep 190/200 CPU), 128GB (ep
    // 179/200 A30), and 200GB (ep 181/200 V100). Target window: >120GB (above
    // the observed V100 failure floor) and <192GB (below V100 node ceiling)
    // so the job fits V100 (192GB) AND A30/A100 (256GB) nodes. 180GB hits
    // that window; waiting on 256GB-only nodes saw 4-day backfill slots.
    // cpus=29 stays under the gpu partition MaxMemPerCPU=9216MB cap
    // (180*1024/29 = 6357 MB/cpu).
    withName: 'MULTIVI_GAP_FILL' {
        container = params.containers.scgpu
        containerOptions = '--nv'
        accelerator = 1
        cpus   = 29
        memory = '180.GB'
        time   = '12h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account_gpu} -p ${params.slurm_partition_gpu} --gres=gpu:1"
    }

    withName: 'EXPORT_MUDATA_RNA' {
        container = params.containers.scgpu
        cpus   = 4
        memory = '32.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'BOOTSTRAP_MOFA_INTEGRATION' {
        container = params.containers.scgpu
        cpus   = 4
        memory = '64.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'CONSENSUS_ANALYSIS' {
        container = params.containers.scgpu
        cpus   = 4
        memory = '32.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'ANALYZE_MEMORY_LOG' {
        container = params.containers.scgpu
        cpus   = 1
        memory = '8.GB'
        time   = '30m'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // =========================
    // R: SEURAT / HDWGCNA / CELLCHAT
    // =========================

    withName: 'CONVERT_H5AD_TO_SEURAT' {
        container = params.containers.r_seurat
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 4
        memory = '64.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'HDWGCNA_PER_CELLTYPE' {
        container = params.containers.r_seurat
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 4
        memory = '64.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'RUN_CELLCHAT' {
        container = params.containers.r_cellchat
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 4
        memory = '32.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'COMPARE_CELLCHAT' {
        container = params.containers.r_cellchat
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 4
        memory = '32.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // FIX-29 per-condition CellChat. zellkonverter::readH5AD → basilisk needs
    // R_LIBS_USER guard to prevent host R libs from overriding container conda.
    withName: 'CELLCHAT_PER_CONDITION' {
        container = params.containers.r_cellchat
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 4
        memory = '32.GB'
        time   = '6h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'CELLCHAT_COMPARE' {
        container = params.containers.r_cellchat
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 4
        memory = '32.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // =========================
    // DE / DOWNSTREAM
    // =========================

    withName: 'CONVERT_H5AD_FOR_MAST' {
        container = params.containers.r_seurat
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 4
        memory = '32.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'EXTRACT_CELL_TYPES_FOR_MAST' {
        container = params.containers.scgpu
        cpus   = 4
        memory = '32.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'RUN_MAST_DE' {
        container = params.containers.r_seurat
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 4
        memory = '32.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'CREATE_VOLCANO_PLOTS' {
        container = params.containers.r_seurat
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 2
        memory = '16.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'RUN_GO_ENRICHMENT' {
        container = params.containers.r_seurat
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 4
        memory = '32.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'SNAPATAC_DIFFERENTIAL' {
        container = params.containers.snapatac
        cpus   = 4
        memory = '32.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // -------------------------------------------------------------------
    // SHI_FIGURES — Shi et al. 2025 figure equivalents (D3 SDas absorb)
    // -------------------------------------------------------------------
    withName: 'ANNOTATE_PEAK_TYPES' {
        container = params.containers.snapatac
        cpus   = 4
        memory = '32.GB'
        time   = '1h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
    withName: 'NMF_ENHANCER_PROGRAMS' {
        container = params.containers.snapatac
        cpus   = 8
        memory = '96.GB'
        time   = '4h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
    withName: 'MARKER_COVERAGE_TRACKS' {
        container = params.containers.snapatac
        cpus   = 2
        memory = '8.GB'
        time   = '30m'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
    withName: 'SELECT_SHI_CANDIDATES' {
        container = params.containers.snapatac
        cpus   = 2
        memory = '16.GB'
        time   = '30m'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
    withName: 'COACC_CORRELATION_MATRIX' {
        container = params.containers.snapatac
        cpus   = 4
        memory = '32.GB'
        time   = '1h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
    withName: 'DA_PEAK_BREAKDOWN' {
        container = params.containers.snapatac
        cpus   = 2
        memory = '8.GB'
        time   = '30m'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
    withName: 'DA_LOG2FC_HEATMAPS' {
        container = params.containers.snapatac
        cpus   = 2
        memory = '8.GB'
        time   = '30m'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
    withName: 'TF_DIFFERENTIAL_VOLCANO' {
        container = params.containers.snapatac
        cpus   = 2
        memory = '8.GB'
        time   = '30m'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
    withName: 'CURATED_TF_NETWORKS' {
        container = params.containers.snapatac
        cpus   = 2
        memory = '8.GB'
        time   = '30m'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
    withName: 'LOCUS_TF_BINDING' {
        container = params.containers.snapatac
        cpus   = 2
        memory = '8.GB'
        time   = '30m'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // -------------------------------------------------------------------
    // PBMC instance back-port (2026-05-04): resource configs for processes
    // defined in src modules but lacking small-tier allocations.
    // -------------------------------------------------------------------

    // ENHANCER_FOOTPRINTING_PER_CT — SDas_nf 2026-04-30 audit (SLURM 51567486):
    // MaxRSS 64–72 GB across 25 completed per-ct tasks; the prior 256 GB /
    // highmem ceiling was 3.5× over-spec and got 3 cts scheduler-rejected
    // (FAILED 0:53). 128 GB on standard partition = ~2× headroom over peak +
    // orders-of-magnitude better node availability. Rust backed-mode reads
    // the peak matrix without materializing it in RAM, so per-ct memory is
    // dominated by printer model load not dataset size.
    withName: 'ENHANCER_FOOTPRINTING_PER_CT' {
        container = params.containers.snapatac
        cpus   = 8
        memory = '128.GB'
        time   = '24h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // PROMOTER_MSFP_PER_CT — single-locus per-gene compute amortizes printer
    // load across all genes in target_genes for one cell type. Smaller
    // memory footprint than ENHANCER_FOOTPRINTING_PER_CT (one region row vs
    // ~5453 enhancer regions for the full bed).
    withName: 'PROMOTER_MSFP_PER_CT' {
        container = params.containers.snapatac
        cpus   = 8
        memory = '64.GB'
        time   = '12h'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'RENDER_PROMOTER_MSFP_OVERLAY' {
        container = params.containers.snapatac
        cpus   = 1
        memory = '4.GB'
        time   = '30m'
        errorStrategy = 'terminate'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'ATAC_DESCRIPTIVE_REPORT' {
        container = params.containers.snapatac
        cpus   = 4
        memory = '16.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'POST_QC_REPORT' {
        container = params.containers.snapatac
        cpus   = 8
        memory = '64.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'ATAC_MOTIF_ANALYSIS' {
        container = params.containers.snapatac
        cpus   = 16
        memory = '128.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'ATAC_QC_AUTO_THRESH' {
        container = params.containers.snapatac
        cpus   = 8
        memory = '64.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'EXTRACT_BARCODES' {
        container = params.containers.snapatac
        cpus   = 1
        memory = '4.GB'
        time   = '1h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'LOAD_EXISTING_DATA' {
        container = params.containers.snapatac
        cpus   = 4
        memory = '16.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'SCPRINTER_BUILD_MANIFEST' {
        container = params.containers.snapatac
        cpus   = 1
        memory = '4.GB'
        time   = '1h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'SCPRINTER_MSFP_PLOTS' {
        container = params.containers.snapatac
        cpus   = 8
        memory = '32.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'AGGREGATE_FP_STATS' {
        container = params.containers.snapatac
        cpus   = 4
        memory = '16.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'BUILD_VIZ_CANDIDATES' {
        container = params.containers.snapatac
        cpus   = 2
        memory = '8.GB'
        time   = '1h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'EXPORT_ATAC_BIGWIGS' {
        container = params.containers.snapatac
        cpus   = 8
        memory = '64.GB'
        time   = '8h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'CELLCHAT_PREP_H5AD' {
        container = params.containers.scgpu
        cpus   = 4
        memory = '32.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'CELLCHAT_INFER' {
        container = params.containers.r_cellchat
        cpus   = 4
        memory = '32.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'CELLCHAT_COMPARE' {
        container = params.containers.r_cellchat
        cpus   = 4
        memory = '32.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

}
