// ============================================================================
// configs/resource_tiers/large.config — Resource allocations for large datasets
//
// Extracted from BD nextflow.config (100+ samples, 100k+ cells).
// These blocks are applied inside the cluster profile and override label
// defaults with per-process allocations sized for large-scale data.
// Includes hugemem, highmem, maxmem, and gpu-hugemem partitions.
//
// Loaded automatically when params.resource_tier = 'large'.
// ============================================================================

process {
    // =========================
    // RNA: GPU PROCESSES
    // =========================

    // CELLBENDER — ambient RNA removal (FIX-19/22c)
    withName: 'CELLBENDER' {
        container = params.containers.scgpu
        containerOptions = '--nv'
        cpus   = 16
        memory = '128.GB'
        time   = '72h'
        clusterOptions = "-A ${params.slurm_account_gpu} -p ${params.slurm_partition_gpu} --gres=gpu:${params.slurm_gpu_type}:${params.slurm_gpu_count}"
        maxRetries = 2
        errorStrategy = 'retry'
    }

    // TRAIN_SCVI / TRAIN_SCANVI / PREPARE_REFERENCE — gpu-hugemem (FIX-20)
    withName: 'TRAIN_SCVI|TRAIN_SCANVI|PREPARE_REFERENCE' {
        container = params.containers.scgpu
        containerOptions = '--nv'
        cpus   = 20
        memory = '1100.GB'
        time   = '24h'
        clusterOptions = "-A ${params.slurm_account_gpu} -p ${params.slurm_partition_gpu_hugemem} --qos=${params.slurm_qos_gpu_hugemem} --gres=gpu:${params.slurm_gpu_type}:${params.slurm_gpu_count}"
    }

    // =========================
    // RNA: CPU PROCESSES
    // =========================

    // RNA_QC — per-sample QC (FIX-26: OOM at default)
    withName: 'RNA_QC' {
        container = params.containers.scgpu
        cpus   = 4
        memory = '64.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // RUN_CELLTYPIST — CPU-only (FIX-33f/51)
    withName: 'RUN_CELLTYPIST' {
        container = params.containers.scgpu
        cpus   = 8
        memory = '64.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // CONCAT_BATCHES — merge 100+ samples post-QC
    withName: 'CONCAT_BATCHES' {
        container = params.containers.scgpu
        cpus   = 8
        memory = '256.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // PLOT_POST_SCANVI — critical-path blocker (FIX-53)
    withName: 'PLOT_POST_SCANVI' {
        container = params.containers.scgpu
        errorStrategy = 'terminate'
        cpus   = 8
        memory = '128.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // ASSIGN_TEST_GROUPS
    withName: 'ASSIGN_TEST_GROUPS' {
        container = params.containers.scgpu
        cpus   = 2
        memory = '16.GB'
        time   = '1h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // =========================
    // ATAC PROCESSES
    // =========================

    withName: 'ATAC_INITIAL_QC|ATAC_FINAL_PIPELINE' {
        container = params.containers.snapatac
        cpus   = 8
        memory = '64.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'ATAC_MAKE_THRESHOLDS' {
        container = params.containers.snapatac
        cpus   = 2
        memory = '8.GB'
        time   = '1h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'ATAC_CELLTYPE_ANNOTATION' {
        container = params.containers.snapatac
        cpus   = 8
        memory = '128.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // MERGE_ANNOTATIONS — peak matrix from 134 samples (FIX-18)
    withName: 'MERGE_ANNOTATIONS' {
        container = params.containers.snapatac
        cpus   = 8
        memory = '128.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // =========================
    // REGULATORY: CICERO
    // =========================

    withName: 'CICERO_TRIPLETS' {
        container = params.containers.snapatac
        cpus   = 8
        memory = '64.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // CICERO_FULL — OOM at 64 GB (FIX-43). 111K cells x 755K peaks.
    withName: 'CICERO_FULL' {
        container = params.containers.r_cicero
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 40
        memory = '666.GB'
        time   = '120h'
        clusterOptions = "-A ${params.slurm_account} -p hugemem"
    }

    withName: 'CICERO_TARGET_PLOTS' {
        container = params.containers.r_cicero
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 8
        memory = '64.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // =========================
    // REGULATORY: CHROMVAR (GPU)
    // =========================

    // GPU_CHROMVAR — 111K cells x 755K peaks (FIX-25/31/34)
    withName: 'GPU_CHROMVAR' {
        container = params.containers.snapatac
        containerOptions = '--nv'
        cpus   = 8
        memory = '200.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account_gpu} -p ${params.slurm_partition_gpu} --gres=gpu:A100:${params.slurm_gpu_count}"
    }

    withName: 'VIS_CHROMVAR' {
        container = params.containers.snapatac
        cpus   = 4
        memory = '32.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'EXTRACT_CHROMVAR_MOTIFS' {
        container = params.containers.snapatac
        cpus   = 2
        memory = '16.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'MAP_TF_TO_TARGET_GENES' {
        container = params.containers.snapatac
        errorStrategy = 'ignore'
        cpus   = 4
        memory = '64.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'RESOLVE_GENE_COORDINATES' {
        container = params.containers.snapatac
        cpus   = 2
        memory = '16.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // =========================
    // REGULATORY: scPRINTER
    // =========================

    withName: 'SCPRINTER_BARCODES' {
        container = params.containers.snapatac
        cpus   = 2
        memory = '8.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'SCPRINTER_BUILD_PRINTER' {
        container = params.containers.snapatac
        cpus   = 8
        memory = '64.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // SCPRINTER_FOOTPRINTING — per cell type, 7 parallel (FIX-36)
    withName: 'SCPRINTER_FOOTPRINTING' {
        container = params.containers.snapatac
        cpus   = 8
        memory = '300.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p highmem"
    }

    // SCPRINTER_MOTIF_SCAN (FIX-36b)
    withName: 'SCPRINTER_MOTIF_SCAN' {
        container = params.containers.snapatac
        cpus   = 8
        memory = '300.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'SCPRINTER_DORC' {
        container = params.containers.snapatac
        cpus   = 8
        memory = '64.GB'
        time   = '12h'
        errorStrategy = 'ignore'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // =========================
    // ENHANCER FOOTPRINTING RECIPES
    // =========================

    withName: 'EXTRACT_CCAN_ENHANCERS' {
        container = params.containers.snapatac
        errorStrategy = 'ignore'
        cpus   = 4
        memory = '64.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'MOTIF_SCAN_ENHANCERS' {
        container = params.containers.snapatac
        errorStrategy = 'ignore'
        cpus   = 8
        memory = '128.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'ENHANCER_FOOTPRINTING' {
        container = params.containers.snapatac
        errorStrategy = 'ignore'
        cpus   = 8
        memory = '666.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p hugemem"
    }

    withName: 'EXTRACT_EREGULON_REGIONS' {
        container = params.containers.snapatac
        errorStrategy = 'ignore'
        cpus   = 4
        memory = '64.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'CROSS_MODAL_VALIDATION' {
        container = params.containers.snapatac
        errorStrategy = 'ignore'
        cpus   = 8
        memory = '300.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p highmem"
    }

    withName: 'CELLCHAT_TO_TF_HYPOTHESES' {
        container = params.containers.snapatac
        errorStrategy = 'ignore'
        cpus   = 8
        memory = '128.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'EXTRACT_SIGNALING_TARGETS' {
        container = params.containers.snapatac
        errorStrategy = 'ignore'
        cpus   = 4
        memory = '64.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'SIGNAL_CHAIN_CORRELATION' {
        container = params.containers.snapatac
        errorStrategy = 'ignore'
        cpus   = 8
        memory = '300.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p highmem"
    }

    withName: 'PREPARE_ENHANCER_VIZ_TRACKS' {
        container = params.containers.snapatac
        errorStrategy = 'ignore'
        cpus   = 4
        memory = '64.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'COMPOSITE_ENHANCER_VIZ' {
        container = params.containers.snapatac
        errorStrategy = 'ignore'
        cpus   = 4
        memory = '32.GB'
        time   = '6h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
        maxForks = 7
    }

    // =========================
    // GRN: SCENIC+ / pycisTopic
    // =========================

    withName: 'SCENICPLUS_RUN|PYCISTOPIC_PREPARE' {
        container = params.containers.scenicplus
        cpus   = 8
        memory = '256.GB'
        time   = '48h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'SCENICPLUS_VISUALIZE' {
        container = params.containers.scenicplus
        errorStrategy = 'ignore'
        cpus   = 4
        memory = '32.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // =========================
    // MULTIOME INTEGRATION
    // =========================

    // BUILD_MUDATA — OOM at 350 GB (FIX-55/58), moved to maxmem
    withName: 'BUILD_MUDATA' {
        container = params.containers.scgpu
        cpus   = 16
        memory = '1400.GB'
        time   = '48h'
        clusterOptions = "-A ${params.slurm_account} -p maxmem"
    }

    // MOFA_INTEGRATE / MULTIVI_INTEGRATE — GPU-accelerated (FIX-52/56)
    withName: 'MOFA_INTEGRATE|MULTIVI_INTEGRATE' {
        container = params.containers.scgpu
        containerOptions = '--nv'
        cpus   = 16
        memory = '2200.GB'
        time   = '48h'
        clusterOptions = "-A ${params.slurm_account_gpu} -p ${params.slurm_partition_gpu_hugemem} --qos=${params.slurm_qos_gpu_hugemem} --gres=gpu:${params.slurm_gpu_type}:${params.slurm_gpu_count}"
    }

    // MOFA_VISUALIZE — 287K cells (FIX-58)
    withName: 'MOFA_VISUALIZE' {
        container = params.containers.scgpu
        cpus   = 8
        memory = '666.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p hugemem"
    }

    // MULTIVI_VISUALIZE — 287K cells (FIX-58)
    withName: 'MULTIVI_VISUALIZE' {
        container = params.containers.scgpu
        cpus   = 8
        memory = '666.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p hugemem"
    }

    // EXPORT_MUDATA_RNA — full MuData load for 287K cells (FIX-58)
    withName: 'EXPORT_MUDATA_RNA' {
        container = params.containers.scgpu
        cpus   = 8
        memory = '300.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p highmem"
    }

    withName: 'BOOTSTRAP_MOFA_INTEGRATION' {
        container = params.containers.scgpu
        cpus   = 8
        memory = '128.GB'
        time   = '48h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'CONSENSUS_ANALYSIS' {
        container = params.containers.scgpu
        cpus   = 8
        memory = '64.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'ANALYZE_MEMORY_LOG' {
        container = params.containers.scgpu
        cpus   = 1
        memory = '8.GB'
        time   = '30m'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // =========================
    // R: SEURAT / HDWGCNA / CELLCHAT
    // =========================

    // CONVERT_H5AD_TO_SEURAT — 10.9 GB h5ad (FIX-58)
    withName: 'CONVERT_H5AD_TO_SEURAT' {
        container = params.containers.r_seurat
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 8
        memory = '300.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p highmem"
    }

    // HDWGCNA_PER_CELLTYPE — TOM matrix can exceed 200 GB
    withName: 'HDWGCNA_PER_CELLTYPE' {
        container = params.containers.r_seurat
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 20
        memory = '666.GB'
        time   = '72h'
        clusterOptions = "-A ${params.slurm_account} -p hugemem"
    }

    // RUN_CELLCHAT — 100+ samples, many cell types (FIX-49)
    withName: 'RUN_CELLCHAT' {
        container = params.containers.r_cellchat
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 20
        memory = '666.GB'
        time   = '72h'
        clusterOptions = "-A ${params.slurm_account} -p hugemem"
    }

    // COMPARE_CELLCHAT
    withName: 'COMPARE_CELLCHAT' {
        container = params.containers.r_cellchat
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 8
        memory = '128.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    // =========================
    // DE / DOWNSTREAM
    // =========================

    withName: 'CONVERT_H5AD_FOR_MAST' {
        container = params.containers.r_seurat
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 8
        memory = '128.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'EXTRACT_CELL_TYPES_FOR_MAST' {
        container = params.containers.scgpu
        cpus   = 8
        memory = '128.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'RUN_MAST_DE' {
        container = params.containers.r_seurat
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 8
        memory = '128.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'CREATE_VOLCANO_PLOTS' {
        container = params.containers.r_seurat
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 4
        memory = '32.GB'
        time   = '2h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'RUN_GO_ENRICHMENT' {
        container = params.containers.r_seurat
        containerOptions = '--env R_LIBS_USER=/dev/null'
        cpus   = 8
        memory = '64.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

    withName: 'SNAPATAC_DIFFERENTIAL' {
        container = params.containers.snapatac
        cpus   = 8
        memory = '128.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }

}
