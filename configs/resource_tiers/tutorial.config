// ============================================================================
// configs/resource_tiers/tutorial.config — CPU-only tier for the tier-2 tutorial
//
// Loaded when params.resource_tier == 'tutorial'.
//
// Unlike configs/resource_tiers/test.config (1 CPU / 1 GB, for -preview only),
// this tier runs REAL work on the ~1,000-cell tutorial dataset. It is sized for a
// workstation or a single modest compute node, not a cluster.
//
// Two things it must get right:
//
//  1. NO GPU, BY BOTH MECHANISMS. FORGE attaches GPUs two independent ways —
//     `label 'process_gpu'` (CELLBENDER, TRAIN_SCVI, TRAIN_SCANVI, GPU_CHROMVAR)
//     and per-process `withName` blocks in the production tiers carrying
//     `containerOptions = '--nv'` + `accelerator = 1` (this is how
//     MULTIVI_INTEGRATE gets one — it has no label). Only one tier file is ever
//     loaded, so simply not setting those here is enough; the wildcard below
//     also clears them defensively in case a profile sets them.
//
//  2. Container assignments must SURVIVE. MOST come from the top-level
//     `process {}` block in nextflow.config and carry over automatically — but
//     NOT all of them. 43 processes are assigned a container ONLY by the
//     production tier files (small/medium/large), so a tier that omits them
//     leaves them containerless and they run against whatever is on $PATH.
//     Observed symptom: CICERO_ESTIMATE_DP exiting 127 with
//     "/usr/bin/env: 'Rscript': No such file or directory", and
//     ATAC_DESCRIPTIVE_REPORT silently running against base conda.
//     nextflow.config only names the PRE-Phase-3 Cicero processes
//     (CICERO_FULL / CICERO_TARGET_PLOTS / CICERO_FULL_STRATIFIED); the
//     Phase 3 family (ESTIMATE_DP / FULL_CHROM / JOIN, plus _PER_CT) is
//     tier-only. The CONTAINER ASSIGNMENTS block at the bottom of this file
//     replicates those, and must be kept in sync with small.config.
//     The tutorial still needs real containers — this is not -stub-run.
//
// Run with:  -profile tutorial,singularity   (local executor + containers)
// NOT with:  -profile test                   (that disables containers)
//
// This tier is selected by the `tutorial` PROFILE, not by `resource_tier` in a
// -c file — see the note in nextflow.config's tutorial profile for why.
// ============================================================================

process {
    // ---- Generic floor: LOWEST priority -------------------------------------
    // Applies only to processes that no withLabel and no withName block below
    // reaches. Deliberately bare (not a wildcard selector) so that everything
    // below actually outranks it.
    cpus          = 2
    memory        = 4.GB
    time          = '4h'
    errorStrategy = 'terminate'   // fail loudly; this is a test run
    maxRetries    = 0

    // ---- withLabel overrides: REQUIRED, not optional -------------------------
    // nextflow.config assigns 8-500 GB via withLabel (process_medium = 64 GB,
    // process_high_memory = 256 GB, hugemem = 500 GB). withLabel OUTRANKS the
    // bare process scope above, so without these overrides a workstation run
    // would request 500 GB, never schedule, and hang rather than fail.
    // Values are sized from measured peak RSS on the 1,000-cell dataset; see
    // dev_notes/phase3/T2_RESOURCE_BASELINE.md.
    withLabel: 'process_small'       { cpus = 2; memory = 4.GB  }
    withLabel: 'process_low'         { cpus = 2; memory = 6.GB  }
    withLabel: 'process_medium'      { cpus = 4; memory = 8.GB  }
    withLabel: 'process_high'        { cpus = 4; memory = 12.GB }
    withLabel: 'process_gpu'         { cpus = 4; memory = 12.GB }
    withLabel: 'process_high_memory' { cpus = 4; memory = 12.GB }
    withLabel: 'hugemem'             { cpus = 4; memory = 12.GB }
    withLabel: 'process_hdwgcna'     { cpus = 2; memory = 12.GB }

    // ---- GPU / scheduler stripping ------------------------------------------
    // This MUST stay a withName: '.*' block. It has to outrank nextflow.config's
    // per-process GPU settings, and in Nextflow 25.10.0 a selector matching a
    // process's FULLY-QUALIFIED name ('RNA:CELLBENDER') outranks one matching
    // only its simple name ('CELLBENDER') — regardless of declaration order.
    // '.*' matches the qualified name, so it wins; that is exactly the job here.
    //
    // DO NOT put cpus/memory/time in this block. That same precedence rule made
    // the wildcard silently beat every simple-name resource block below, and
    // 88 of 94 tasks in the first run got 2c/8GB instead of their declared
    // values. Resources now live in withLabel/withName blocks, which are not
    // shadowed because this block no longer declares them.
    withName: '.*' {
        clusterOptions = ''        // no SLURM partition/account/QOS/gres
        accelerator    = null      // no GPU request
        // NOTE: deliberately does NOT touch containerOptions. Clearing it
        // globally would also wipe the '--env R_LIBS_USER=/dev/null' that
        // nextflow.config sets for RUN_CELLCHAT/COMPARE_CELLCHAT, without which
        // basilisk fails looking up a conda env. GPU's '--nv' is cleared by the
        // targeted block below instead.
    }

    // nextflow.config's own top-level process block attaches GPU to this exact
    // set (accelerator = 1 + containerOptions = '--nv'). Override it explicitly
    // here rather than relying on the wildcard winning by declaration order —
    // this tier is included last, so this block is the final word.
    withName: '(.*:)?(TRAIN_SCVI|TRAIN_SCANVI|CELLBENDER|GPU_CHROMVAR|MOFA_INTEGRATE|MULTIVI_INTEGRATE)' {
        accelerator      = null
        containerOptions = ''
    }

    // ---- Per-process sizing, from MEASURED peak RSS -------------------------
    // Source: dev_notes/phase3/T2_RESOURCE_BASELINE.md (run 1, 94/94 tasks).
    // Rule of thumb: measured peak RSS + ~50% headroom, rounded up.
    //
    // EVERY selector below is written '(.*:)?NAME' so it matches BOTH the
    // simple name and the fully-qualified 'WORKFLOW:NAME' form. This is not
    // cosmetic. A selector matching the qualified name outranks one matching
    // only the simple name, so a broad pattern like 'ATAC_.*' — which DOES
    // match 'ATAC_FINAL:ATAC_FINAL_PIPELINE' — would otherwise silently beat a
    // bare 'ATAC_FINAL_PIPELINE' override and hand a 12 GB process 4 GB.
    // Verified empirically. With every selector qualified-safe they compete on
    // equal footing and plain declaration order applies: GENERAL FIRST,
    // SPECIFIC AFTER. Keep that order when editing.

    // -- General buckets (declared first so specific blocks below override) ---

    // Most ATAC / Cicero steps measured under 1.6 GB. CICERO_FULL_CHROM is a
    // 25-way fan-out of ~27s tasks; keeping it small aids concurrency.
    withName: '(.*:)?(ATAC_.*|SNAPATAC.*|CICERO.*)' {
        cpus   = 2
        memory = 4.GB
        time   = '4h'
    }

    // R steps. RUN_CELLCHAT measured 0.99 GB but ran 27m17s.
    withName: '(.*:)?(RUN_CELLCHAT.*|CONVERT_.*)' {
        cpus   = 2
        memory = 6.GB
        time   = '4h'
    }

    // scvi-tools on CPU: slower than GPU but tiny at this scale.
    // params.scvi_accelerator = 'cpu' is what actually forces the device.
    // MOFA_INTEGRATE measured 0.98 GB; scVI/scANVI are not exercised in the
    // tutorial (MultiVI is the integration path) so they keep headroom.
    withName: '(.*:)?(TRAIN_SCVI|TRAIN_SCANVI|MOFA_INTEGRATE)' {
        cpus   = 4
        memory = 8.GB
        time   = '6h'
    }

    // -- Specific overrides (must come after the general buckets) -------------

    // Measured peak 8.20 GB — the largest single task in the whole run.
    withName: '(.*:)?ATAC_FINAL_PIPELINE' {
        cpus   = 4
        memory = 12.GB
        time   = '6h'
    }

    // Measured peak 5.80 GB on the first run but 7.10 GB on the re-measurement.
    // 10 GB keeps headroom above the higher of the two — peak RSS here is not
    // stable run to run, and 8 GB left only 11%.
    withName: '(.*:)?ATAC_INITIAL_QC' {
        cpus   = 4
        memory = 10.GB
        time   = '4h'
    }

    // Measured peak 7.80 GB, 21m38s on CPU.
    withName: '(.*:)?MULTIVI_INTEGRATE' {
        cpus   = 4
        memory = 12.GB
        time   = '6h'
    }

    // Measured peak 4.90 GB.
    withName: '(.*:)?MULTIVI_VISUALIZE' {
        cpus   = 4
        memory = 8.GB
        time   = '4h'
    }

    // Measured peak 7.70 GB, and the longest single task in the run at 56m54s.
    withName: '(.*:)?HDWGCNA_ENRICHMENT' {
        cpus   = 2
        memory = 12.GB
        time   = '6h'
    }

    // Measured peak 6.20 GB across a 45-way fan-out.
    withName: '(.*:)?HDWGCNA_PER_CELLTYPE' {
        cpus   = 2
        memory = 10.GB
        time   = '4h'
    }

    // CellBender models 20,000 droplets (1,000 cells + 19,000 ambient) on CPU —
    // slow, but not memory-hungry. Peak nearly doubled between runs (1.50 GB then
    // 2.90 GB), so 6 GB rather than 4 GB to absorb that variance.
    withName: '(.*:)?CELLBENDER' {
        cpus   = 2
        memory = 6.GB
        time   = '6h'
    }

    // ========================================================================
    // CONTAINER ASSIGNMENTS — see note 2 in the header.
    //
    // These processes get NO container from nextflow.config; the production
    // tiers are the only place they are assigned one. Mirrored from
    // small.config, containers only — resources stay as set above. Nextflow
    // merges every matching withName selector, so setting `container` here
    // does not disturb the cpus/memory/time set by the blocks above.
    //
    // Deliberately covers processes outside the tutorial's enabled scope too
    // (scPRINTER, SCENIC+, enhancer footprinting). They are inert when their
    // gates are off, and carrying them means enabling one later cannot
    // resurrect this same class of failure.
    // ========================================================================

    // Cicero Phase 3 + per-cell-type variants. R_LIBS_USER guard is required:
    // without it the container's R picks up a host user library.
    withName: 'CICERO_ESTIMATE_DP|CICERO_FULL_CHROM|CICERO_JOIN|CICERO_ESTIMATE_DP_PER_CT|CICERO_FULL_CHROM_PER_CT|CICERO_JOIN_PER_CT' {
        container        = params.containers.r_cicero
        containerOptions = '--env R_LIBS_USER=/dev/null'
    }

    // CellChat: basilisk fails on a conda lookup without the R_LIBS_USER guard.
    withName: 'CELLCHAT_INFER|CELLCHAT_PER_CONDITION|CELLCHAT_COMPARE' {
        container        = params.containers.r_cellchat
        containerOptions = '--env R_LIBS_USER=/dev/null'
    }

    withName: 'CELLCHAT_PREP_H5AD|MULTIVI_MASKING_SWEEP_ONE|MULTIVI_MASKING_SWEEP_AGGREGATE' {
        container = params.containers.scgpu
    }

    withName: 'ATAC_DESCRIPTIVE_REPORT|POST_QC_REPORT|ATAC_MOTIF_ANALYSIS|ATAC_QC_AUTO_THRESH|EXTRACT_BARCODES|LOAD_EXISTING_DATA|BUILD_CT_ANNOTATION|CICERO_TRIPLETS_PER_CT|ANNOTATE_PEAK_TYPES|COACC_CORRELATION_MATRIX|DA_PEAK_BREAKDOWN|DA_LOG2FC_HEATMAPS|NMF_ENHANCER_PROGRAMS|MARKER_COVERAGE_TRACKS|SELECT_SHI_CANDIDATES|CURATED_TF_NETWORKS|LOCUS_TF_BINDING|TF_DIFFERENTIAL_VOLCANO|BUILD_VIZ_CANDIDATES|BUILD_UNION_ENHANCER_PEAKS' {
        container = params.containers.snapatac
    }

    withName: 'SCPRINTER_BUILD_MANIFEST|SCPRINTER_MSFP_PLOTS|AGGREGATE_FP_STATS|ENHANCER_FOOTPRINTING_PER_CT|PROMOTER_MSFP_PER_CT|RENDER_PROMOTER_MSFP_OVERLAY' {
        container = params.containers.snapatac
    }

    withName: /EXTRACT_CCAN_ENHANCERS(_CTRL|_TRT)?/ {
        container = params.containers.snapatac
    }

    withName: /MOTIF_SCAN_ENHANCERS(_UNION)?/ {
        container = params.containers.snapatac
    }

    withName: /MOTIF_IN_GAINED_CCANS|RENDER_CIS_REWIRING_MOTIF_STACK/ {
        container = params.containers.snapatac
    }
}
