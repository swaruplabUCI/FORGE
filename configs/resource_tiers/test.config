// ============================================================================
// configs/resource_tiers/test.config — minimal tier for local verification
//
// Loaded when params.resource_tier == 'test' (set automatically by
// -profile test). Its job is to strip every site-specific scheduler assumption
// so verification runs anywhere: the production tiers request up to 1200 GB and
// hard-code SLURM partitions, accounts, QOS names, and --gres GPU strings, and
// the local executor refuses any task whose request exceeds the machine.
//
// This tier does NOT reflect real requirements — never use it for a real
// analysis. Use small / medium / large for that.
// ============================================================================

process {
    // Wildcard: applies to every process, overriding nothing else since no other
    // tier is loaded alongside this one.
    withName: '.*' {
        cpus           = 1
        memory         = '1.GB'
        time           = '10m'
        clusterOptions = ''       // drop SLURM partition/account/QOS/gres strings
        accelerator    = null     // no GPU requests in a stub run
        errorStrategy  = 'terminate'
        maxRetries     = 0
    }
}
