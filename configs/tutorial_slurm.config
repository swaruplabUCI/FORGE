// ============================================================================
// configs/tutorial_slurm.config — size the local executor to a SLURM allocation
//
// Included by launch_tutorial.sh ONLY when running inside a SLURM job. Not part
// of the `tutorial` profile, and not needed for a bare workstation run.
//
// WHY THIS EXISTS
// Nextflow's local executor sizes its task pool from the MACHINE's total CPU
// and RAM — not from the cgroup it is confined to. Inside a SLURM allocation
// that is the wrong number: on a 188 GB node with a 66 GB allocation Nextflow
// will happily start enough concurrent tasks to need 100+ GB, and the job is
// OOM-killed with no useful error. Deriving the pool from the allocation is the
// fix, and it is why the tutorial runs the whole pipeline inside ONE SLURM job
// with `executor = 'local'` rather than submitting each task separately —
// per-task submission would need site-specific account/partition/QOS settings
// that no portable tutorial can hardcode.
//
// A bare (non-SLURM) run does NOT include this file: there, the machine total
// really is the limit, which is Nextflow's default and already correct.
// ============================================================================

// SLURM_CPUS_PER_TASK is set by --cpus-per-task; SLURM_CPUS_ON_NODE is the
// fallback when the job was sized some other way.
def _tutCpus = (System.getenv('SLURM_CPUS_PER_TASK')
                ?: System.getenv('SLURM_CPUS_ON_NODE')
                ?: '2') as int

// SLURM_MEM_PER_NODE is in MB and set by --mem. When the job used --mem-per-cpu
// instead, SLURM_MEM_PER_NODE is unset and we reconstruct it. Default 4096 MB
// is a deliberately small floor: better to serialise than to be OOM-killed.
def _tutMemPerNode = System.getenv('SLURM_MEM_PER_NODE')
def _tutMemPerCpu  = System.getenv('SLURM_MEM_PER_CPU')
def _tutMemMb = _tutMemPerNode ? (_tutMemPerNode as int)
              : (_tutMemPerCpu ? (_tutMemPerCpu as int) * _tutCpus : 4096)

// Hold back ~10% so the Nextflow head JVM and Singularity itself have room
// inside the same allocation. Without this the pool can exactly consume the
// cgroup and the head process is what gets killed.
// NB: written as a plain comparison rather than Math.max() — Groovy cannot
// disambiguate Math.max(Integer, BigDecimal) and fails to parse the config.
def _tutMemUsable = (int) (_tutMemMb * 0.90)
if (_tutMemUsable < 2048) _tutMemUsable = 2048

executor {
    name   = 'local'
    cpus   = _tutCpus
    memory = "${_tutMemUsable} MB"
}
