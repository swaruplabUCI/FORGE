// ============================================================================
// configs/profiles/hpc3_cluster.config — UCI HPC3 SLURM cluster profile
//
// Loaded by the 'cluster' profile in nextflow.config.
// Sets SLURM executor, error strategy, label defaults, and executor tuning.
//
// Container and resource assignments come from the resource tier configs
// (small.config / large.config), which are loaded separately.
// ============================================================================

process.executor = 'slurm'

// FIX-P0-1: Default errorStrategy 'retry' ensures core process failures
// are surfaced rather than silently swallowed. Optional/visualization
// processes override this with 'ignore' in their resource tier configs.
process.errorStrategy = 'retry'
process.maxRetries    = 2

// Resource tiers calibrated from production runs:
//   process_low    ~ PBMC 10x scale (QC, conversions, annotations)
//   process_medium ~ GMWM SDas scale (ATAC annotation, Cicero triplets, DE)
//   process_high   ~ BD multiomics scale (ATAC pipeline, integration, footprinting)
//   process_gpu    ~ GPU-accelerated (scVI, scANVI, CellBender, chromVAR)
//   process_high_memory ~ MOFA, MultiVI, BUILD_MUDATA (large MuData objects)
//   hugemem        ~ MOFA_VISUALIZE, CONCAT_CELLISMO (500 GB+ OOM otherwise)
//   process_hdwgcna ~ R hdWGCNA per cell type (high memory R workload)
//   process_small  ~ Trivial tasks (barcode extraction, file moves)

process {
    withLabel: 'process_small' {
        cpus   = 1
        memory = '8.GB'
        time   = '1h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
    withLabel: 'process_low' {
        cpus   = 4
        memory = '32.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
    withLabel: 'process_medium' {
        cpus   = 8
        memory = '64.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
    withLabel: 'process_high' {
        cpus   = 16
        memory = '128.GB'
        time   = '24h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
    withLabel: 'process_gpu' {
        cpus   = 8
        memory = '64.GB'
        time   = '24h'
        clusterOptions = "-A ${params.slurm_account_gpu} -p ${params.slurm_partition_gpu} --gres=gpu:${params.slurm_gpu_type}:${params.slurm_gpu_count}"
    }
    withLabel: 'process_high_memory' {
        cpus   = 16
        memory = '256.GB'
        time   = '48h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
    withLabel: 'hugemem' {
        cpus   = 4
        memory = '500.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p highmem"
    }
    withLabel: 'process_hdwgcna' {
        cpus   = 8
        memory = '96.GB'
        time   = '12h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
}

executor {
    submitRateLimit = '5 sec'
    queueSize       = 100
    pollInterval    = '1 min'
}
