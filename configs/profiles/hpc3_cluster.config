// ============================================================================
// configs/profiles/hpc3_cluster.config — UCI HPC3 SLURM cluster profile
//
// Loaded by the 'cluster' profile in nextflow.config.
// Sets SLURM executor, error strategy, label defaults, and executor tuning.
//
// Container and resource assignments come from the resource tier configs
// (small.config / large.config), which are loaded separately.
// ============================================================================

process.executor = 'slurm'

// FIX-46: Default errorStrategy 'ignore' prevents one failed process
// from killing independent parallel processes. Each process succeeds or
// fails independently and Nextflow reports all failures at the end.
process.errorStrategy = 'ignore'

process {
    withLabel: 'process_low' {
        cpus   = 2
        memory = '16.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = '32.GB'
        time   = '8h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
    withLabel: 'process_high' {
        cpus   = 8
        memory = '64.GB'
        time   = '4h'
        clusterOptions = "-A ${params.slurm_account} -p ${params.slurm_partition_cpu}"
    }
}

executor {
    submitRateLimit = '5 sec'
    queueSize       = 100
    pollInterval    = '1 min'
}
